<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>false</IsPackable>	<!-- a developer's tool, never shipped -->
		<Description>A developer's tool: runs the VpnHood Avalonia UI on a PC, from a TV's size down to a phone's</Description>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>VpnHood.App.AvaloniaUI.Dev</RootNamespace>
		<AssemblyName>VpnHoodAvaloniaDev</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\AppLib\VpnHood.AppLib.AvaloniaUI\VpnHood.AppLib.AvaloniaUI.csproj" />
		<!-- The UI itself: the pages, the controls, the themes. -->
		<ProjectReference Include="..\..\AppLib\VpnHood.AppLib.ClassicAvaloniaUi\VpnHood.AppLib.ClassicAvaloniaUi.csproj" />
		<ProjectReference Include="..\..\Core\VpnHood.Core.Client.Devices.Win\VpnHood.Core.Client.Devices.Win.csproj" />
		<!-- Shared client resources: the SPA the pairing hands to the phone, the IP-location db. -->
		<ProjectReference Include="..\Client\VpnHood.App.Client.csproj" />
	</ItemGroup>
	<!-- The assets folder - the images, flags, fonts and documents every UI draws from - placed the way
	     this platform reads files: the same targets a package reference of VpnHood.AppLib.Assets imports. -->
	<Import Project="..\..\AppLib\VpnHood.AppLib.Assets\build\VpnHood.AppLib.Assets.targets" />
</Project>
