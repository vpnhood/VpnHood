<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>A VPN adapter for Windows on WinDivert, a packet capture driver, with no network interface of its own.</Description>
		<TargetFramework>net11.0</TargetFramework>
		<VhApiDocsComplete>true</VhApiDocsComplete>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SharpPcap" Version="6.3.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VpnHood.Net.VpnAdapters.Abstractions\VpnHood.Net.VpnAdapters.Abstractions.csproj" />
	</ItemGroup>

	<!-- WinDivert's DLL and driver as its release ships them (x64 only), embedded and installed at run time
	     into a protected folder of their own (WindowsCommonFiles): the driver holds its file until a reboot,
	     which there blocks no update or cleanup, and signing our assembly leaves the driver's signature. -->
	<ItemGroup>
		<EmbeddedResource Include="Resources\WinDivert.dll" LogicalName="WinDivert.dll" />
		<EmbeddedResource Include="Resources\WinDivert64.sys" LogicalName="WinDivert64.sys" />
	</ItemGroup>

</Project>
