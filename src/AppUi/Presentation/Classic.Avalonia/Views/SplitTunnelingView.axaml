<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppUi.Services"
             xmlns:ui="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Resources"
             xmlns:controls="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Controls"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.SplitTunnelingView">
  <!-- The web UI's split-tunneling/index: the master switch, then the splits in their sections -
       apps and domains, IP addresses, locations, DNS - every state read off the app's own effective
       picture, so a split the switch or the plan silenced reads Off. -->
  <DockPanel Classes="page">
    <controls:PageHeader x:Name="Header" DockPanel.Dock="Top" Title="{Binding SplitTunneling, Source={x:Static res:Strings.Current}}" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="720">
        <Image ui:AppImage.Source="images/split-ip.webp" MaxHeight="130" Stretch="Uniform" />
        <TextBlock Classes="card-subtitle" Margin="12,8,12,20" Text="{Binding SplitTunnelingDesc, Source={x:Static res:Strings.Current}}" />

        <controls:SettingsToggleItem x:Name="EnabledItem" Toggled="OnEnabledToggled" />
        <Border x:Name="ServerSplitAlert" Classes="alert-info" Margin="0,0,0,16" IsVisible="False">
          <TextBlock Classes="body-small" TextWrapping="Wrap" Text="{Binding ServerSplitTrafficNotice, Source={x:Static res:Strings.Current}}" />
        </Border>

        <controls:SettingsSectionTitle x:Name="AppsSection" />
        <controls:SettingsItem x:Name="AppsItem" Clicked="OnAppsClick" />
        <controls:SettingsItem x:Name="DomainsItem" Clicked="OnDomainsClick" />

        <controls:SettingsSectionTitle x:Name="IpSection" />
        <controls:SettingsItem x:Name="IpsViaDeviceItem" Clicked="OnIpsViaDeviceClick" />
        <controls:SettingsItem x:Name="IpsViaAppItem" Clicked="OnIpsViaAppClick" />
        <controls:SettingsItem x:Name="Ipv6Item" Clicked="OnIpv6Click" />

        <controls:SettingsSectionTitle x:Name="LocationSection" />
        <controls:SettingsItem x:Name="LocalNetworkItem" Clicked="OnLocalNetworkClick" />
        <controls:SettingsItem x:Name="CountriesItem" Clicked="OnCountriesClick" />

        <controls:SettingsSectionTitle x:Name="DnsSection" />
        <controls:SettingsItem x:Name="DnsItem" Clicked="OnDnsClick" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
