<?xml version="1.0" encoding="utf-8"?>
<!-- The package: the app (Client), a Win32 process run as the person, and its VPN host (VpnPluginHost),
     which Windows starts as its background tasks' server when the app's VPN profile connects or the app
     opens its app service. The VPN host has an entry of its own in Start, Quick Launch, as the Store takes
     no application without one: its launch opens the app, which connects (QuickLaunchView). Both run in
     the package's AppContainer, Windows' sandbox, and nothing here with full trust: what needs more - a
     tray, a service, the machine's own tunnel - is the website edition's. _publish.ps1 stamps the
     identity, the version, the names, the executables and the server, and draws the logos from the app's
     icon. Windows activates the VPN host's task and app service by their own class names, whatever the
     package's identity. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 rescap">
  <Identity Name="Stamped" Publisher="CN=Stamped" Version="0.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Stamped</DisplayName>
    <PublisherDisplayName>Stamped</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application
      Id="VpnPluginHost"
      Executable="Stamped.exe"
      EntryPoint="VpnHood.Core.Client.Devices.WindowsVpnPlugin.Activation.VpnBackgroundTask"
      uap10:RuntimeBehavior="windowsApp"
      uap10:TrustLevel="appContainer">
      <uap:VisualElements
        DisplayName="Stamped"
        Description="Quick Launch"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- the vpnClient task, without which Windows never activates the plug-in (the fork's lesson 1) -->
        <Extension Category="windows.backgroundTasks" EntryPoint="VpnHood.Core.Client.Devices.WindowsVpnPlugin.Activation.VpnBackgroundTask">
          <BackgroundTasks ServerName="Stamped">
            <uap:Task Type="vpnClient" />
          </BackgroundTasks>
        </Extension>
        <!-- The app's control channel (WindowsVpnPluginAppServiceListener.AppServiceName), run by the same server, the
             VPN host: an open connection keeps it running, which Windows freezes between VPN events otherwise, so the
             VPN works while the app runs. -->
        <uap:Extension Category="windows.appService" EntryPoint="VpnHood.Core.Client.Devices.WindowsVpnPlugin.Activation.VpnAppServiceTask">
          <uap:AppService Name="VpnService" ServerName="Stamped" />
        </uap:Extension>
      </Extensions>
    </Application>
    <Application
      Id="Client"
      Executable="Stamped.exe"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="appContainer">
      <uap:VisualElements
        DisplayName="Stamped"
        Description="VPN client"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- A link that is an access key itself (vh:...) starts the app with it, which the window imports
             (InProcessDesktopHost): with paste, how a key comes into the sandbox, which may not read a file opened
             with the app - so no .cdy here, which the website edition opens. And vhkey:, a form keys may switch to,
             so a package from before the switch opens its links. -->
        <uap:Extension Category="windows.protocol">
          <uap3:Protocol Name="vh" Parameters="--access-key &quot;%1&quot;">
            <uap:DisplayName>Access key</uap:DisplayName>
          </uap3:Protocol>
        </uap:Extension>
        <uap:Extension Category="windows.protocol">
          <uap3:Protocol Name="vhkey" Parameters="--access-key &quot;%1&quot;">
            <uap:DisplayName>Access key</uap:DisplayName>
          </uap3:Protocol>
        </uap:Extension>
        <!-- Quick Launch: the VPN host's entry opens this (QuickLaunchView.AppScheme), and the window connects as its
             Connect button does (InProcessDesktopHost). -->
        <uap:Extension Category="windows.protocol">
          <uap3:Protocol Name="vh-quick-launch" Parameters="--quick-launch">
            <uap:DisplayName>Quick Launch</uap:DisplayName>
          </uap3:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="networkingVpnProvider" />
  </Capabilities>
  <Extensions>
    <Extension Category="windows.activatableClass.inProcessServer">
      <InProcessServer>
        <Path>WinRT.Host.dll</Path>
        <ActivatableClass ActivatableClassId="VpnHood.Core.Client.Devices.WindowsVpnPlugin.Activation.VpnBackgroundTask" ThreadingModel="both" />
        <ActivatableClass ActivatableClassId="VpnHood.Core.Client.Devices.WindowsVpnPlugin.Activation.VpnAppServiceTask" ThreadingModel="both" />
      </InProcessServer>
    </Extension>
  </Extensions>
</Package>
