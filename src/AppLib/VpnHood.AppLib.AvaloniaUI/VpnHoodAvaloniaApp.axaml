<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VpnHood.AppLib.AvaloniaUI.VpnHoodAvaloniaApp"
             RequestedThemeVariant="Dark">
  <!-- The palette is not here: it is one of the two theme files beside the styles, merged into the
       resources in code before this file is loaded, since the styles below resolve their keys as
       they are read. Dark is what the Fluent controls take for the keys no theme of ours names. -->
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://VpnHood.AppLib.AvaloniaUI/Styles/AppTheme.axaml" />
  </Application.Styles>
</Application>
