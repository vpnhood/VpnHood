<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>VpnHood.AppLib.Contracts</RootNamespace>
		<IsPackable>false</IsPackable>
		<Description>The app's published data model: its state, its features, its settings and its profiles, as both the app and every UI read them. Data only - no verbs, no transport, no logic.</Description>
	</PropertyGroup>

	<!-- Shared on purpose. The app owns these shapes and a UI reads them, so duplicating them would
	     buy a mapper per type and no isolation: rename a field and both sides still have to agree.
	     What is NOT here is the API itself - the six interfaces, the request/response envelopes and
	     the HTTP client live in VpnHood.AppLib.Api, which the app does not reference. -->

	<ItemGroup>
		<ProjectReference Include="..\..\Core\VpnHood.Core.Toolkit\VpnHood.Core.Toolkit.csproj" />
	</ItemGroup>
</Project>
