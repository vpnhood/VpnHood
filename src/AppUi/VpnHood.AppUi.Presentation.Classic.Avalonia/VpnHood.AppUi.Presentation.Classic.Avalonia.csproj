<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Description>VpnHood's own Avalonia UI: the web UI's pages, page for page, in one responsive layout - the views, the controls and the two products' themes - and the same UI compiled to WebAssembly, the page the app's web host serves to a paired phone</Description>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<!-- This UI embeds no assets: its images, country flags, fonts, content documents and words are
	     the files of VpnHood.AppUi.Assets.Classic, read at run time through the IAssetProvider the
	     head hands in - the zip that package's targets placed, extracted; or the app's web host,
	     from a browser page. -->

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.3" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
		<!-- The QR of the pairing address: Android has no encoder of its own and Core Image is tvOS-only,
		     so one dependency-free .NET encoder serves both (TV plan, Phase 4). -->
		<PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- Mounting Avalonia and the app's state as the pages read it, which any Avalonia UI needs. -->
		<ProjectReference Include="..\VpnHood.AppUi.Hosting.Avalonia\VpnHood.AppUi.Hosting.Avalonia.csproj" />
		<!-- The words, the error sentences, the formatting - what the pages say, for any toolkit. -->
		<ProjectReference Include="..\VpnHood.AppUi.Common\VpnHood.AppUi.Common.csproj" />
		<!-- The look this UI draws: the store's files, which the head's build places by importing the
		     store's targets (a project reference carries none; a package reference will). Declared, not
		     compiled against - the store has no assembly. -->
		<!-- PrivateAssets: packed, this declaration adds no dependency. A consumer names its own store:
		     the look belongs to the head, not to the UI. -->
		<ProjectReference Include="..\VpnHood.AppUi.Assets.Classic\VpnHood.AppUi.Assets.Classic.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<!-- The pairing page starts and stops the LAN listener the phone dials into. -->
	</ItemGroup>

	<!-- This UI as a browser page - the page the app's web host serves to a paired phone - ships in this
	     package: it is this UI's own code compiled to WebAssembly and calls the app's API, so it comes
	     with the UI and at its version, where the look above is the head's choice. buildTransitive/
	     holds web-root.zip, which VpnHood.AppUi.Presentation.Classic.Avalonia.Browser's _publish.ps1
	     writes there and git ignores, and the targets that place it beside the app at any reference depth. -->
	<ItemGroup>
		<!-- The file name in PackagePath: a folder alone would add the default item's buildTransitive\ again. -->
		<None Update="buildTransitive\**" Pack="true" PackagePath="buildTransitive\%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Pack is the only build that must have the page: without it, the package is a UI whose web host
	     has nothing to serve. -->
	<Target Name="VhRequireWebRootZip" BeforeTargets="GenerateNuspec">
		<Error Condition="!Exists('$(MSBuildProjectDirectory)\buildTransitive\web-root.zip')"
		       Text="There is no buildTransitive\web-root.zip to pack. Run src/AppUi/VpnHood.AppUi.Presentation.Classic.Avalonia.Browser/_publish.ps1 first (the .NET 10 SDK with the wasm-tools workload)." />
	</Target>
</Project>
