<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>	<!-- app extension, not a NuGet package -->
    <!-- the app's platforms (Client.Ios.Apple): iOS, and the Apple TV in a build that asks -->
    <TargetFrameworks>$(VhAppleTargetFrameworks)</TargetFrameworks>
    <UseMaui>false</UseMaui>
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    <!-- The SDK trims only its own assemblies here, so the shared code's reflection finds our types whole.
         Android's SDK keeps this analysis off for such a build; Apple's leaves it on. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- The bundle id and the App Group come from the app's identity (../Directory.Build.props). -->
    <AssemblyName>$(VhAppPackageTitle)Extension</AssemblyName>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>

    <!-- Automatic signing: Xcode picks the cert/profile for the team (6KKW3MKLR7, OmegaHood LLC). -->
    <AutomaticProvisioning>true</AutomaticProvisioning>
    <CodesignKey>Apple Development</CodesignKey>


    <!-- Critical: tells the iOS workload to package this project as an .appex (PlugIn). -->
    <IsAppExtension>true</IsAppExtension>
    <!-- SdkOnly: trim system assemblies, but keep user assemblies. -->
    <MtouchLink>SdkOnly</MtouchLink>
    <!-- iOS jetsam: cap the Mono SGen managed heap HARD. Device-measured, a 40-connection burst ballooned
         the managed heap 6.7 -> 15 MB of transient garbage in ~1.7 s, tipping a ~41 MB load over the ~50 MB
         jetsam line. soft-heap-limit=8m forces SGen to collect far sooner; a small nursery keeps gen0 cheap
         under the packet-allocation storm. See docs/ios-extension-memory-and-throughput.md. -->
    <MtouchExtraArgs>$(MtouchExtraArgs) --setenv=MONO_GC_PARAMS=soft-heap-limit=8m,nursery-size=2m</MtouchExtraArgs>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- The Apple TV, as in the app (Client.Ios.Apple's csproj): the first tvOS with Network Extension, and
       tvOS's own libsqlite3 for the split filters. The heap cap above is iOS's until an Apple TV's own
       limit is measured. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tvos'">
    <RuntimeIdentifier>tvos-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <MtouchExtraArgs>$(MtouchExtraArgs) --gcc_flags=-lsqlite3</MtouchExtraArgs>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tvos'">
    <ReferenceNativeSymbol Include="sqlite3_enable_load_extension" SymbolType="Function" SymbolMode="Ignore" />
  </ItemGroup>

  <!-- App Store (manual) signing for the Network Extension. The App Store publish (Publish-IosApp.ps1)
       turns AutomaticProvisioning off and passes the *app* profile via a global /p:CodesignProvision;
       that global would otherwise leak onto this .appex and fail codesign (its App ID is the
       ...networkextension one, not the app's). The parent Client.Ios.Apple.csproj strips CodesignProvision
       from this ProjectReference (UndefineProperties), so the .appex takes ITS OWN profile here, which
       the publish names from its signing marker (ios_signing.json's ExtProvision).
       Only active for distribution builds (AutomaticProvisioning=false); dev/Xcode auto-signing is
       unaffected. -->
  <PropertyGroup Condition="'$(AutomaticProvisioning)' == 'false'">
    <CodesignProvision>$(VhExtensionCodesignProvision)</CodesignProvision>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>

  <!-- Apple's privacy manifest for this .appex. An extension is scanned as its own bundle, so the host
       app's manifest does not cover it; LogicalName puts this at the root of the .appex. -->
  <ItemGroup>
    <BundleResource Include="PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Network Extension implementation (abstract IosVpnService, on iOS and tvOS) lives in
         VpnServices.Host.Ios, which references the VpnServiceHost and the iOS TUN adapter. This project
         only adds the thin [Register("PacketTunnelProvider")] subclass that roots that assembly. -->
    <ProjectReference Include="..\..\..\Core\VpnHood.Core.Client.VpnServices.Host.Ios\VpnHood.Core.Client.VpnServices.Host.Ios.csproj" />
  </ItemGroup>

</Project>
