<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Description>Runs the VpnHood Avalonia UI in a desktop window on Windows and Linux</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
	</ItemGroup>

	<ItemGroup>
		<!-- The UI itself, over the app's API alone: the engine (VpnHood.AppLib.App) is the service's, and
		     the window's look is the UI's. -->
		<ProjectReference Include="..\VpnHood.AppUi.Hosting.Avalonia\VpnHood.AppUi.Hosting.Avalonia.csproj" />
		<!-- The window as the app's UI context (AvaloniaUiContext), which a store's sign-in and purchase ask for. -->
		<ProjectReference Include="..\..\Core\VpnHood.Core.Client.Devices.Abstractions\VpnHood.Core.Client.Devices.Abstractions.csproj" />
		<!-- IDesktopUi, which a desktop head names this UI as. -->
		<ProjectReference Include="..\VpnHood.AppUi.Hosting.Desktop.Abstractions\VpnHood.AppUi.Hosting.Desktop.Abstractions.csproj" />
		<!-- The web server extracts the bundle whose assets folder the UI draws from. -->
	</ItemGroup>
</Project>
