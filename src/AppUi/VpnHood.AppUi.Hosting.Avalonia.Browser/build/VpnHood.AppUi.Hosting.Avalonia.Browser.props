<Project>
	<!-- The WebAssembly settings every Avalonia page project shares. A page project (one per UI:
	     src/AppUi/VpnHood.AppUi.Presentation.Classic.Avalonia.Browser is ours) is a Microsoft.NET.Sdk.WebAssembly
	     executable that imports this file, references the host and its UI, and keeps its own
	     wwwroot/ (index.html, main.js) - the page's title and splash are the page's. -->
	<PropertyGroup>
		<RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
		<WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>

		<!-- AOT: every touch on the page is CPU on its one thread, which .NET's interpreter makes a phone
		     wait for. It doubles the bundle, which travels only over the LAN, and adds minutes to a
		     publish, and a page's start gains nothing from it. -->
		<RunAOTCompilation>true</RunAOTCompilation>

		<!-- Trimmed to the full extent: the app's own assemblies are referenced for their DTOs alone, and
		     the API client's JSON is generated ahead of time; the reflection path stays on for the few
		     places the shared code still uses it. -->
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>full</TrimMode>
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
		<!-- The analysis lists those places, which are known; a new one in a page would go unreported. -->
		<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
	</PropertyGroup>

	<!-- Published under the .NET 10 SDK, named by a global.json in the page project's folder: SkiaSharp's
	     WebAssembly libraries are built for its Emscripten (3.1.56), which .NET 11's (6.x)
	     cannot link. A plain build works under either; only the publish relinks. -->
</Project>
