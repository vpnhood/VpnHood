<dialogs:DialogBase xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="using:VpnHood.AppLib.Assets"
                    xmlns:dialogs="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Views.Dialogs"
                    x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.Dialogs.PremiumCodeCompleteDialog">
  <!-- The web UI's PremiumCodeCompleteDialog: the congratulation, the code's dates and devices, and
       a word when it is already used elsewhere. -->
  <Border Classes="dialog active" MaxWidth="420">
    <StackPanel Spacing="12">
      <StackPanel Spacing="4" HorizontalAlignment="Center">
        <TextBlock Classes="mdi" FontSize="44" Text="{x:Static res:Mdi.PartyPopper}" HorizontalAlignment="Center" />
        <TextBlock Classes="dialog-title" FontSize="22" TextAlignment="Center" Text="{Binding Congratulations, Source={x:Static res:Strings.Current}}" />
      </StackPanel>
      <TextBlock Classes="dialog-text" Text="{Binding PremiumCodeProcessIsCompleteMessage, Source={x:Static res:Strings.Current}}" />
      <Border Background="#17083D" CornerRadius="8" Padding="12,8">
        <StackPanel Spacing="6">
          <TextBlock x:Name="SharedText" Classes="body-small" TextWrapping="Wrap" IsVisible="False"
                     Text="{Binding AlertForUsedPremiumCodeMoreThanOneDevice, Source={x:Static res:Strings.Current}}" />
          <StackPanel x:Name="Info" Spacing="4" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="StatisticsButton" Classes="dialog-btn" Click="OnStatisticsClick" IsVisible="False"
                Content="{Binding Statistics, Source={x:Static res:Strings.Current}}" />
        <Button x:Name="CloseButton" Classes="dialog-btn plain" Click="OnCloseClick"
                Content="{Binding Close, Source={x:Static res:Strings.Current}}" />
      </StackPanel>
    </StackPanel>
  </Border>
</dialogs:DialogBase>
