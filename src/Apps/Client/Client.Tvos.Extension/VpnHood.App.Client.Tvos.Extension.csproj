<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>	<!-- app extension, not a NuGet package -->
    <TargetFramework>net11.0-tvos</TargetFramework>
    <RuntimeIdentifier>tvos-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <UseMaui>false</UseMaui>
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    <!-- The bundle id and the App Group come from the app's identity (../Directory.Build.props): the iOS
         extension's, as the app is the iOS app's (Client.Tvos.Apple). -->
    <AssemblyName>$(VhAppPackageTitle)Extension</AssemblyName>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>

    <!-- Automatic signing: Xcode picks the cert/profile for the team (6KKW3MKLR7, OmegaHood LLC). -->
    <AutomaticProvisioning>true</AutomaticProvisioning>
    <CodesignKey>Apple Development</CodesignKey>

    <!-- tells the SDK to package this project as an .appex (PlugIn) -->
    <IsAppExtension>true</IsAppExtension>
    <!-- trim system assemblies, keep user assemblies -->
    <MtouchLink>SdkOnly</MtouchLink>
    <!-- The iOS extension's managed-heap cap (Client.Ios.Extension's csproj says why), until an Apple
         TV's own limit is measured; and tvOS's libsqlite3 for the split filters, as the app's. -->
    <MtouchExtraArgs>$(MtouchExtraArgs) --setenv=MONO_GC_PARAMS=soft-heap-limit=8m,nursery-size=2m --gcc_flags=-lsqlite3</MtouchExtraArgs>
  </PropertyGroup>

  <!-- App Store (manual) signing: the extension's own profile, as on iOS (Client.Ios.Extension's
       csproj says why). -->
  <PropertyGroup Condition="'$(AutomaticProvisioning)' == 'false'">
    <CodesignProvision>$(VhExtensionCodesignProvision)</CodesignProvision>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
    <!-- the one call tvOS's libsqlite3 leaves out, as in the app (Client.Tvos.Apple's csproj) -->
    <ReferenceNativeSymbol Include="sqlite3_enable_load_extension" SymbolType="Function" SymbolMode="Ignore" />
  </ItemGroup>

  <!-- Apple's privacy manifest, the iOS extension's: the same code, the same uses. -->
  <ItemGroup>
    <BundleResource Include="..\Client.Ios.Extension\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Network Extension itself (IosVpnService), as the iOS extension's. -->
    <ProjectReference Include="..\..\..\Core\VpnHood.Core.Client.VpnServices.Host.Ios\VpnHood.Core.Client.VpnServices.Host.Ios.csproj" />
  </ItemGroup>

</Project>
