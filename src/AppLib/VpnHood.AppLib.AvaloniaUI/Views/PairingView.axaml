<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppLib.AvaloniaUI.Resources"
             xmlns:controls="using:VpnHood.AppLib.AvaloniaUI.Controls"
             x:Class="VpnHood.AppLib.AvaloniaUI.Views.PairingView">
  <!-- The web UI's Remote Access dialog, as a page: the code and its address on one side, every
       line of text on the other, Done under the remote. Under 600 logical px the text drops under
       the code and the page scrolls. The listener lives exactly as long as this page is shown
       (TV plan §4.3). -->
  <UserControl.Styles>
    <Style Selector="StackPanel.code-pane">
      <Setter Property="Grid.Column" Value="0" />
    </Style>
    <Style Selector="StackPanel.text-pane">
      <Setter Property="Grid.Column" Value="2" />
    </Style>
    <ContainerQuery Name="Page" Query="max-width:600">
      <Style Selector="StackPanel.code-pane">
        <Setter Property="Grid.ColumnSpan" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Center" />
      </Style>
      <Style Selector="StackPanel.text-pane">
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="3" />
        <Setter Property="Margin" Value="0,24,0,0" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid Classes="page" ColumnDefinitions="Auto,40,*" RowDefinitions="Auto,Auto" VerticalAlignment="Center">

      <StackPanel Classes="code-pane" Spacing="12" MaxWidth="300">
        <Border Background="White" CornerRadius="6" Padding="10" HorizontalAlignment="Center">
          <controls:QrCodeControl x:Name="Qr" Width="256" Height="256" />
        </Border>
        <TextBlock x:Name="AddressText" Classes="address" HorizontalAlignment="Center" TextAlignment="Center" />
      </StackPanel>

      <StackPanel Classes="text-pane" Spacing="14" VerticalAlignment="Center">
        <TextBlock Classes="title" Text="{x:Static res:Strings.RemoteAccess}" />
        <TextBlock Classes="body" Text="{x:Static res:Strings.RemoteAccessDesc}" />
        <Border Classes="note">
          <TextBlock Classes="body" Text="{x:Static res:Strings.RemoteAccessKeepOpen}" />
        </Border>
        <TextBlock x:Name="ConnectedText" Classes="muted" Text="{x:Static res:Strings.RemoteAccessNoDevice}" />
        <Button x:Name="DoneButton" Classes="action" Content="{x:Static res:Strings.Done}"
                HorizontalAlignment="Right" Click="OnDoneClick" />
      </StackPanel>

    </Grid>
  </ScrollViewer>
</UserControl>
