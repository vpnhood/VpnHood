<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppLib.Assets"
             xmlns:controls="using:VpnHood.AppLib.AvaloniaUI.Controls"
             x:Class="VpnHood.AppLib.AvaloniaUI.Views.StatisticsView">
  <!-- The web UI's statistics page: a card per subject - the premium access, the server, the
       devices, the session's, the month's and the lifetime's traffic - each a table of label and
       value rows, built in code from the session the app reports. -->
  <DockPanel Classes="page">
    <controls:PageHeader x:Name="Header" DockPanel.Dock="Top" Title="{Binding Statistics, Source={x:Static res:Strings.Current}}" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="Cards" MaxWidth="720" Spacing="16" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
