<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>false</IsPackable>	<!-- application, not a NuGet package -->
		<Description>VpnHood Windows Client App</Description>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<UseWindowsForms>False</UseWindowsForms>
		<!-- The executable, its service and their folders are called by the app's package title
		     (../Directory.Build.props). No VhAppIdChannel, though the website hands this build out: it
		     shipped as com.vpnhood.client.windows before the website's builds said so in their ids, and
		     the id is part of every install's client id. -->
		<AssemblyName>$(VhAppPackageTitle)</AssemblyName>
		<ApplicationIcon>Resources\VpnHood.ico</ApplicationIcon>
		<EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<ApplicationManifest>Properties/app.manifest</ApplicationManifest>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    </PropertyGroup>

	<PropertyGroup>
		<AssemblyVersion></AssemblyVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Client\VpnHood.App.Client.csproj" />
		<!-- Windows as this head runs on it: the service, the window and its tray, the commands. -->
		<ProjectReference Include="..\..\..\AppUi\VpnHood.AppUi.Hosting.Cli.Windows\VpnHood.AppUi.Hosting.Cli.Windows.csproj" />
		<!-- The UI this head runs, in its own window. -->
		<ProjectReference Include="..\..\..\AppUi\VpnHood.AppUi.Hosting.Avalonia.Desktop\VpnHood.AppUi.Hosting.Avalonia.Desktop.csproj" />
		<!-- The UI itself: the pages, the controls, the themes. -->
		<ProjectReference Include="..\..\..\AppUi\VpnHood.AppUi.Presentation.Classic.Avalonia\VpnHood.AppUi.Presentation.Classic.Avalonia.csproj" />
	</ItemGroup>

	<!-- The assets folder - the images, flags, fonts, documents and words every UI draws from - placed the way
	     this platform reads files: the same targets a package reference of VpnHood.AppUi.Assets.Classic imports. -->
	<Import Project="..\..\..\AppUi\VpnHood.AppUi.Assets.Classic\buildTransitive\VpnHood.AppUi.Assets.Classic.targets" />
	<!-- The page the web host serves - the Avalonia UI's browser build - placed the same way, from
	     Classic.Avalonia.Browser's publish; the head reads it at "assets/web-root.zip". -->
	<Import Project="..\..\..\AppUi\VpnHood.AppUi.Presentation.Classic.Avalonia.Browser\build\VpnHood.AppUi.Presentation.Classic.Avalonia.Browser.targets" />
</Project>
