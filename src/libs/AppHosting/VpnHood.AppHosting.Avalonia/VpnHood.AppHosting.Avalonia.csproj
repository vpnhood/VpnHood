<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<VhApiDocsComplete>true</VhApiDocsComplete>
		<Description>What mounts any Avalonia UI for the VpnHood app: the Application every host builds and the contract a UI fulfils. It knows the app through its API alone and the UI through that contract, so no UI's own code is in it. No theme, no layout, no control, no words</Description>
	</PropertyGroup>

	<!-- Deliberately without VpnHood.AppUi.Assets.Classic: a UI built on this package brings its own
	     images and words, or takes ours by referencing that package itself. Nothing here shows a
	     word or draws a picture, so nothing here needs them. -->

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.2.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- The app's API, and the whole of what this package knows about the app: the six
		     interfaces and the shapes they carry, in process or over HTTP. No engine, no listener. -->
		<ProjectReference Include="..\..\AppLogic\VpnHood.AppLogic.Api\VpnHood.AppLogic.Api.csproj" />
		<!-- The colours of the chrome around the UI, as its theme names them (ThemeColors). -->
		<ProjectReference Include="..\VpnHood.AppHosting.Common\VpnHood.AppHosting.Common.csproj" />
		<!-- What a UI states for a desktop: the shape of its window (DesktopWindowFitOptions) and the words
		     the host shows around it (IDesktopStrings). -->
		<ProjectReference Include="..\VpnHood.AppHosting.Desktop.Abstractions\VpnHood.AppHosting.Desktop.Abstractions.csproj" />
	</ItemGroup>
</Project>
