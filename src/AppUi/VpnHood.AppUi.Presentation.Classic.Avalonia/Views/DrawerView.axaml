<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppUi.Common"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.DrawerView">
  <!-- The web UI's NavigationDrawer, off the TV UI: the logo, the name and the version, then the
       doors - Go premium, the account, Settings, Diagnose, Check for update - the outbound links,
       and at the foot the social links and the engine's credit. -->
  <Border Classes="drawer">
    <DockPanel>
      <Border DockPanel.Dock="Top" Classes="drawer-header">
        <!-- A Grid and not a horizontal StackPanel: a stack offers its children all the width they
             ask for, so a long product name ran under the drawer's edge and was cut. The star
             column bounds the name, which then wraps. -->
        <Grid ColumnDefinitions="Auto,*">
          <Image x:Name="Logo" Width="50" Height="50" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
            <TextBlock x:Name="AppNameText" Classes="h4" FontSize="16" FlowDirection="LeftToRight" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="drawer-version" Text="{Binding Version, Source={x:Static res:Strings.Current}}" />
              <TextBlock x:Name="VersionText" Classes="drawer-version" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- the foot: the socials and the credit -->
      <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="16,12,16,20" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Button Classes="icon small tonal-white" Click="OnLinkedInClick">
            <TextBlock Classes="mdi" FontSize="18" Text="{x:Static res:Mdi.Linkedin}" />
          </Button>
          <Button Classes="icon small tonal-white" Click="OnInstagramClick">
            <TextBlock Classes="mdi" FontSize="18" Text="{x:Static res:Mdi.Instagram}" />
          </Button>
          <Button Classes="icon small tonal-white" Click="OnXClick">
            <TextBlock FontSize="14" FontWeight="Bold" Text="X" />
          </Button>
        </StackPanel>
        <Button Classes="text-highlight" Padding="4" Click="OnPoweredByClick">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Classes="body-small highlight" TextAlignment="Center" Text="{Binding PoweredBy, Source={x:Static res:Strings.Current}}" />
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
              <TextBlock Classes="body-small active" Text="{Binding VpnhoodEngine, Source={x:Static res:Strings.Current}}" />
              <TextBlock Classes="mdi active" FontSize="13" Text="{x:Static res:Mdi.OpenInNew}" />
            </StackPanel>
          </StackPanel>
        </Button>
      </StackPanel>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Items">
          <Button x:Name="PremiumItem" Classes="drawer-item" Click="OnPremiumClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="mdi" Text="{x:Static res:Mdi.Crown}" />
              <TextBlock Text="{Binding GoPremium, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="AccountItem" Classes="drawer-item" Click="OnAccountClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="mdi" Text="{x:Static res:Mdi.Account}" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="AccountTitle" />
                <TextBlock x:Name="AccountEmail" Classes="body-small disabled" IsVisible="False" MaxWidth="195" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Button x:Name="SettingsItem" Classes="drawer-item" Click="OnSettingsClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="mdi" Text="{x:Static res:Mdi.Cog}" />
              <TextBlock Text="{Binding Settings, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="DiagnoseItem" Classes="drawer-item" Click="OnDiagnoseClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="mdi" Text="{x:Static res:Mdi.Stethoscope}" />
              <TextBlock Text="{Binding Diagnose, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="UpdateItem" Classes="drawer-item" Click="OnUpdateClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock x:Name="UpdateIcon" Classes="mdi" Text="{x:Static res:Mdi.Update}" />
              <TextBlock Text="{Binding CheckForUpdate, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="drawer-item minor" Margin="0,16,0,0" Click="OnWhatsNewClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="mdi" FontSize="20" Text="{x:Static res:Mdi.Bullhorn}" />
              <TextBlock Text="{Binding WhatsNew, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="drawer-item minor" Click="OnFeedbackClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="mdi" FontSize="20" Text="{x:Static res:Mdi.MessageAlert}" />
              <TextBlock Text="{Binding SendFeedback, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="PersonalServerItem" Classes="drawer-item minor" Click="OnPersonalServerClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="mdi" FontSize="20" Text="{x:Static res:Mdi.Server}" />
              <TextBlock Text="{Binding CreatePersonalServer, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="drawer-item minor" Click="OnWebsiteClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="mdi" FontSize="20" Text="{x:Static res:Mdi.Web}" />
              <TextBlock Text="vpnhood.com" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="PrivacyItem" Classes="drawer-item minor" Click="OnPrivacyClick">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="mdi" FontSize="20" Text="{x:Static res:Mdi.ShieldAccount}" />
              <TextBlock Text="{Binding PrivacyPolicy, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
