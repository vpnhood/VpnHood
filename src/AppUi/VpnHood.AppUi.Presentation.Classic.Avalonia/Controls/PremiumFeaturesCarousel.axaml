<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppUi.Common"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Controls.PremiumFeaturesCarousel">
  <!-- The web UI's PremiumFeaturesCarousel: one premium feature at a time - its picture, name and
       line - with the arrows either side and a dot per slide beneath. Its 380 is the web UI's design
       height: the picture takes what the words leave; the words keep their size. -->
  <UserControl.Styles>
    <!-- the web UI's delimiters: a dot in a round button, the current one on a tonal circle -->
    <Style Selector="Border.dot">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.dot.active">
      <Setter Property="Background" Value="{StaticResource HighlightTonalBrush}" />
    </Style>
    <Style Selector="Border.dot > Ellipse">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Fill" Value="{StaticResource HighlightBrush}" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Border.dot.active > Ellipse">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="*,50" Height="380" MaxWidth="560">
    <!-- the web UI's v-window-x-transition: the two slides move together, 0.3s on Vuetify's curve,
         across the carousel's whole width - the arrows lie over them, as the web UI's do -->
    <TransitioningContentControl x:Name="SlideHost" ClipToBounds="True">
      <TransitioningContentControl.PageTransition>
        <PageSlide Duration="0:0:0.3" Orientation="Horizontal">
          <PageSlide.SlideInEasing>
            <SplineEasing X1="0.25" Y1="0.8" X2="0.5" Y2="1" />
          </PageSlide.SlideInEasing>
          <PageSlide.SlideOutEasing>
            <SplineEasing X1="0.25" Y1="0.8" X2="0.5" Y2="1" />
          </PageSlide.SlideOutEasing>
        </PageSlide>
      </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>
    <Button x:Name="PrevButton" Classes="icon" HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnPrevClick"
            AutomationProperties.Name="{Binding Previous, Source={x:Static res:Strings.Current}}">
      <TextBlock Classes="mdi highlight" FontSize="28" Text="{Binding ChevronBack, Source={x:Static res:Strings.Current}}" />
    </Button>
    <Button x:Name="NextButton" Classes="icon" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnNextClick"
            AutomationProperties.Name="{Binding Next, Source={x:Static res:Strings.Current}}">
      <TextBlock Classes="mdi highlight" FontSize="28" Text="{Binding ChevronForward, Source={x:Static res:Strings.Current}}" />
    </Button>
    <StackPanel x:Name="Dots" Grid.Row="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Grid>
</UserControl>
