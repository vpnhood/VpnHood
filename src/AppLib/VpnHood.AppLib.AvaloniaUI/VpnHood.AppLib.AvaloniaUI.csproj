<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>VpnHood.AppLib.AvaloniaUI</RootNamespace>
		<IsPackable>false</IsPackable>
		<Description>The app's UI in Avalonia, for wherever the web UI cannot run: an Android whose web view is too old or broken, Apple TV. Capped today - connect, the location list, and on a TV the pairing code that hands everything else to a phone - and responsive: two columns on a TV or a desktop, one on a phone. Grows page by page as the web UI's features are ported.</Description>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<!-- This UI embeds no assets: its images, country flags, fonts, locale files and content
	     documents are the web UI's own, read at run time from the assets folder of the SPA bundle
	     (AppAssets, named by the head). A build that ships both UIs ships one copy of each. -->

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.2" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
		<!-- The QR of the pairing address: Android has no encoder of its own and Core Image is tvOS-only,
		     so one dependency-free .NET encoder serves both (TV plan, Phase 4). -->
		<PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VpnHood.AppLib.App\VpnHood.AppLib.App.csproj" />
		<!-- The pairing page starts and stops the LAN listener the phone dials into. -->
		<ProjectReference Include="..\VpnHood.AppLib.WebServer\VpnHood.AppLib.WebServer.csproj" />
	</ItemGroup>
</Project>
