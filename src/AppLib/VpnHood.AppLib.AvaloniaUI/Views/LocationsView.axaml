<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpnHood.AppLib.AvaloniaUI.ViewModels"
             xmlns:res="using:VpnHood.AppLib.AvaloniaUI.Resources"
             xmlns:controls="using:VpnHood.AppLib.AvaloniaUI.Controls"
             x:Class="VpnHood.AppLib.AvaloniaUI.Views.LocationsView"
             x:DataType="vm:MainViewModel">
  <!-- The web UI's servers page (pages/servers + components/Servers), both products. Connect has
       one server and shows its locations: a card per group - Free and Premium when both exist and
       the person is not premium - each a collapsible list of rows with the flag or the bolt of the
       fastest choice, the name, and at the end the Active chip, the unblockable mark and the crown.
       The client has a list of servers instead, each a card that opens on its own locations, with
       the mark saying which one the app is set to, and the way to add another at the top. Up and
       Down walk the rows, Enter or a tap chooses, Back returns without choosing. -->
  <UserControl.Resources>
    <!-- one card of locations, under a server in the client or under the page in connect -->
    <DataTemplate x:Key="GroupTemplate" x:DataType="vm:LocationGroup">
      <Border Classes="config-card" Classes.nested="{Binding IsNested}" Margin="0,0,0,16">
        <StackPanel>

          <!-- LocationGroup: the activator -->
          <ToggleButton Classes="group-header" IsChecked="{Binding IsExpanded}" IsVisible="{Binding HasTitle}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Classes="body-small disabled" Text="{Binding Title}" VerticalAlignment="Center" />
              <Border Grid.Column="1" Height="1" Margin="12,0" Background="{StaticResource AppBorderBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="mdi disabled chevron" FontSize="20" Text="{x:Static res:Mdi.ChevronDown}" RenderTransformOrigin="50%,50%" />
            </Grid>
          </ToggleButton>

          <!-- LocationListItem, one per row -->
          <ListBox Classes="locations" ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}" SelectionMode="Single">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LocationItem">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="{Binding Indent}">
                  <TextBlock Classes="mdi bolt" Classes.active="{Binding IsActive}" FontSize="31" Margin="0,0,8,0"
                             Text="{x:Static res:Mdi.LightningBoltOutline}" IsVisible="{Binding IsAuto}" />
                  <Border Grid.Column="0" Classes="flag" Classes.small="{Binding IsNested}" Margin="0,0,8,0" IsVisible="{Binding !IsAuto}">
                    <Image Source="{Binding Flag}" />
                  </Border>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="location-name" Classes.nested="{Binding IsNested}" Classes.active="{Binding IsActive}" Text="{Binding Name}" />
                    <TextBlock Classes="body-small disabled flasher" Text="{Binding RecommendedText}" IsVisible="{Binding IsAuto}" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Border Classes="chip chip-active" IsVisible="{Binding IsActive}">
                      <TextBlock Text="{Binding ActiveChipText}" />
                    </Border>
                    <TextBlock Classes="mdi" FontSize="16" Foreground="{StaticResource PremiumFeaturesIconBrush}"
                               Text="{x:Static res:Mdi.SwordCross}" IsVisible="{Binding HasUnblockable}" />
                    <TextBlock Classes="mdi" FontSize="18" Foreground="{StaticResource PremiumFeaturesIconBrush}"
                               Text="{x:Static res:Mdi.Crown}" IsVisible="{Binding ShowCrown}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Classes="page">
    <controls:PageHeader x:Name="Header" DockPanel.Dock="Top" Title="{Binding ServersPageTitle}" />
    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="720">

        <!-- Add server: the key field on a device that can type one, the phone on a TV -->
        <Button x:Name="AddServerButton" Classes="tonal" Click="OnAddServerClick" Margin="0,0,0,20"
                HorizontalAlignment="Stretch" IsVisible="{Binding CanAddServer}">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <TextBlock Classes="mdi" FontSize="20" Text="{Binding AddServerGlyph}" VerticalAlignment="Center" />
            <TextBlock Classes="body-small" Text="{Binding AddServerText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- nothing added yet: the web UI's alert-warning, title and all -->
        <Border Classes="alert-warning" Margin="0,0,0,16" IsVisible="{Binding HasNoServer}">
          <StackPanel Spacing="2">
            <TextBlock Classes="alert-title" Text="{Binding Warning, Source={x:Static res:Strings.Current}}" />
            <TextBlock Classes="body-small" Text="{Binding NoServerText}" />
          </StackPanel>
        </Border>

        <!-- the client: a card per server, opening on its own locations -->
        <ItemsControl ItemsSource="{Binding Profiles}" IsVisible="{Binding !IsSingleProfileMode}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileItem">
              <Border Classes="config-card" Margin="0,0,0,16">
                <StackPanel>

                  <Button Classes="profile-header" Click="OnProfileClick">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                      <TextBlock Classes="mdi" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"
                                 Foreground="{StaticResource ActiveProfileRadioBrush}"
                                 Text="{x:Static res:Mdi.CheckCircleOutline}" IsVisible="{Binding IsActive}" />
                      <TextBlock Grid.Column="0" Classes="mdi" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"
                                 Foreground="{StaticResource InactiveProfileRadioBrush}"
                                 Text="{x:Static res:Mdi.CircleOutline}" IsVisible="{Binding !IsActive}" />
                      <TextBlock Grid.Column="1" Classes="profile-name" Classes.inactive="{Binding !IsActive}"
                                 Text="{Binding Name}" VerticalAlignment="Center" />

                      <!-- the server's menu (ExpansionPanel.vue), off the TV -->
                      <Button Grid.Column="2" Classes="icon small" VerticalAlignment="Center" Margin="0,0,4,0"
                              IsVisible="{Binding ShowMenu}" Click="OnMenuClick">
                        <TextBlock Classes="mdi" FontSize="20" Text="{x:Static res:Mdi.DotsVertical}" />
                        <Button.Flyout>
                          <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="menu">
                            <StackPanel>
                              <Button Classes="menu-item" IsVisible="{Binding CanRename}" Click="OnRenameClick">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                  <TextBlock Classes="mdi" FontSize="18" Text="{x:Static res:Mdi.Pencil}" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding Rename, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                                </StackPanel>
                              </Button>
                              <Button Classes="menu-item" IsEnabled="{Binding CanDiagnose}" Click="OnDiagnoseClick">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                  <TextBlock Classes="mdi" FontSize="18" Text="{x:Static res:Mdi.Speedometer}" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding Diagnose, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                                </StackPanel>
                              </Button>
                              <Button Classes="menu-item" Click="OnCustomEndpointClick">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                  <TextBlock Classes="mdi" FontSize="18" Text="{x:Static res:Mdi.IpOutline}" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding CustomEndpoint, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                                </StackPanel>
                              </Button>
                              <Button Classes="menu-item" IsVisible="{Binding ShowStarlinkTools}" Click="OnStarlinkClick">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                  <TextBlock Classes="mdi" FontSize="18" Text="{x:Static res:Mdi.SatelliteUplink}" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding StarlinkTools, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                                </StackPanel>
                              </Button>
                              <Button Classes="menu-item" IsVisible="{Binding CanRemove}" Click="OnRemoveClick">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                  <TextBlock Classes="mdi" FontSize="18" Text="{x:Static res:Mdi.Delete}" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding Remove, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                                </StackPanel>
                              </Button>
                            </StackPanel>
                          </Flyout>
                        </Button.Flyout>
                      </Button>

                      <TextBlock Grid.Column="3" Classes="mdi disabled" FontSize="27" VerticalAlignment="Center"
                                 Text="{Binding ExpandGlyph}" IsVisible="{Binding HasLocations}" />
                    </Grid>
                  </Button>

                  <!-- closed: the first flags of its locations, and how many more (ExpansionPanelCollapsed.vue) -->
                  <Button Classes="collapsed-row" Margin="16,0,16,8" IsVisible="{Binding ShowCollapsedFlags}" Click="OnCollapsedClick">
                    <StackPanel Orientation="Horizontal">
                      <ItemsControl ItemsSource="{Binding CollapsedFlags}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:CollapsedFlag">
                            <Border Classes="flag-round">
                              <Panel>
                                <TextBlock Classes="mdi" FontSize="24" Foreground="{StaticResource FastestServerBrush}"
                                           Text="{x:Static res:Mdi.Earth}" IsVisible="{Binding IsAuto}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Flag}" IsVisible="{Binding !IsAuto}" />
                              </Panel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="body-small" Text="{Binding MoreLocationsText}" IsVisible="{Binding HasMoreLocations}"
                                 VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                  </Button>

                  <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}"
                                IsVisible="{Binding IsExpanded}" Margin="12,0" />

                  <!-- the support id and the host this server was built from, with the mark of a
                       custom address in force -->
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0,16,14">
                    <TextBlock Classes="body-small disabled" Text="{Binding SupportIdText}" />
                    <TextBlock Grid.Column="1" Classes="mdi disabled" FontSize="16" Margin="0,0,4,0" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Text="{x:Static res:Mdi.IpNetwork}" IsVisible="{Binding HasCustomEndpoint}" />
                    <TextBlock Grid.Column="2" Classes="body-small disabled" Text="{Binding HostName}"
                               TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                  </Grid>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- connect: the one server's locations, without a card of their own -->
        <ItemsControl ItemsSource="{Binding LocationGroups}" ItemTemplate="{StaticResource GroupTemplate}"
                      IsVisible="{Binding IsSingleProfileMode}" />

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
