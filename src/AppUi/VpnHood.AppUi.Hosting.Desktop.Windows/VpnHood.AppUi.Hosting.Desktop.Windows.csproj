<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Description>The VpnHood desktop host on Windows: a LocalSystem service is the app, ProgramData is its storage, and the window, the tray and the commands run as whoever is signed in. Everything the commands themselves do is VpnHood.AppUi.Hosting.Desktop</Description>
	</PropertyGroup>

	<ItemGroup>
		<!-- ServiceBase, for the service control manager's start and stop, and ServiceController. -->
		<PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<!-- The install folder's rules, tried against real folders by the elevated smoke test. -->
		<InternalsVisibleTo Include="VpnHood.AppUi.SmokeTest" />
	</ItemGroup>

	<!-- The console launcher's build step (buildTransitive/), for every Windows head that takes this
	     package. Its whole path in the package: a folder alone as PackagePath would nest it twice. -->
	<ItemGroup>
		<None Update="buildTransitive\VpnHood.AppUi.Hosting.Desktop.Windows.targets" Pack="true"
		      PackagePath="buildTransitive\VpnHood.AppUi.Hosting.Desktop.Windows.targets" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VpnHood.AppUi.Hosting.Desktop\VpnHood.AppUi.Hosting.Desktop.csproj" />
		<!-- The app as the service runs it. -->
		<ProjectReference Include="..\..\AppLib\VpnHood.AppLib.App.Windows\VpnHood.AppLib.App.Windows.csproj" />
	</ItemGroup>
</Project>
