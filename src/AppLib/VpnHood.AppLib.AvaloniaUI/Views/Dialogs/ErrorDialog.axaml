<dialogs:DialogBase xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="using:VpnHood.AppLib.AvaloniaUI.Resources"
                    xmlns:dialogs="using:VpnHood.AppLib.AvaloniaUI.Views.Dialogs"
                    x:Class="VpnHood.AppLib.AvaloniaUI.Views.Dialogs.ErrorDialog">
  <!-- The web UI's ErrorDialog: "Message" with the alert mark, the sentence, then the buttons the
       failure earned - a retry on the automatic location, the premium trial, the ways to replace a
       refused code, a diagnosis, the report - and Close, where the remote lands. -->
  <Border Classes="dialog alert">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="dialog-title" Text="{Binding Message, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="mdi" FontSize="22" Text="{x:Static res:Mdi.AlertCircleOutline}" />
      </Grid>
      <TextBlock x:Name="MessageText" Classes="dialog-text" />
      <Button x:Name="LearnMoreButton" Classes="alert-link" HorizontalAlignment="Left" IsVisible="False" Click="OnLearnMoreClick">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Classes="mdi" FontSize="18" Text="{x:Static res:Mdi.BookOpenPageVariantOutline}" />
          <TextBlock Text="{Binding LearnMoreAboutThisIssue, Source={x:Static res:Strings.Current}}" TextDecorations="Underline" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <StackPanel x:Name="Actions" Spacing="8">
        <Button x:Name="AutoButton" Classes="pill dialog-action flat block" IsVisible="False" Click="OnAutoClick"
                Content="{Binding ChangeToAutoAndReconnect, Source={x:Static res:Strings.Current}}" />
        <Button x:Name="TryPremiumButton" Classes="pill dialog-action flat block" IsVisible="False" Click="OnTryPremiumClick"
                Content="{Binding TryPremiumForFree, Source={x:Static res:Strings.Current}}" />
        <Button x:Name="RestoreButton" Classes="pill dialog-action flat block" IsVisible="False" Click="OnRestoreClick"
                Content="{Binding RestorePremium, Source={x:Static res:Strings.Current}}" />
        <Button x:Name="ChangeCodeButton" Classes="pill dialog-action flat block" IsVisible="False" Click="OnChangeCodeClick"
                Content="{Binding ChangeCode, Source={x:Static res:Strings.Current}}" />
        <Button x:Name="DiagnoseButton" Classes="pill dialog-action block" IsVisible="False" Click="OnDiagnoseClick">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="mdi" FontSize="18" Text="{x:Static res:Mdi.Stethoscope}" />
            <TextBlock Text="{Binding Diagnose, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="ReportButton" Classes="pill dialog-action block" IsVisible="False" Click="OnReportClick">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="mdi" FontSize="18" Text="{x:Static res:Mdi.OpenInNew}" />
            <TextBlock Text="{Binding OpenReport, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
      <Button x:Name="CloseButton" Classes="dialog-btn" HorizontalAlignment="Right"
              Content="{Binding Close, Source={x:Static res:Strings.Current}}" Click="OnCloseClick" />
    </StackPanel>
  </Border>
</dialogs:DialogBase>
