<?xml version="1.0" encoding="utf-8"?>
<!-- The app's network security, which every head names (AndroidAppConstants.NetworkSecurityConfig); a
     head's own file of this name replaces it. Let's Encrypt's roots are trusted beside the system's:
     Android 7.0 lacks X1 (it came in 7.1.1), and hosts the app reads chain to it, GitHub's downloads
     among them - the update feed and the remote settings. Android before 14 lacks X2, no system has
     the 2025 roots YE and YR yet, and a server's chain may end at any of them. This decides only
     Android's own check: .NET checks the VPN tunnel's chain again, against the system's roots alone,
     and the client trusts the same roots there (LetsEncryptRoots). Plain http only to the app's web
     server on the device itself. -->
<network-security-config>
	<base-config>
		<trust-anchors>
			<certificates src="system" />
			<certificates src="@raw/isrg_root_x1" />
			<certificates src="@raw/isrg_root_x2" />
			<certificates src="@raw/isrg_root_ye" />
			<certificates src="@raw/isrg_root_yr" />
		</trust-anchors>
	</base-config>
	<domain-config cleartextTrafficPermitted="true">
		<domain>localhost</domain>
		<domain>127.0.0.1</domain>
	</domain-config>
</network-security-config>
