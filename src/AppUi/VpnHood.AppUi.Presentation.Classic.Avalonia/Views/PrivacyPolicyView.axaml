<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppUi.Common"
             xmlns:controls="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Controls"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.PrivacyPolicyView">
  <!-- The web UI's privacy-policy page, the consent a first run asks for: the product's own
       summary, the links to the full documents, the usage-data box where the law wants a yes
       first, and Accept - which stay on screen at every text length; only the text scrolls. -->
  <DockPanel Classes="page">
    <TextBlock x:Name="TitleText" DockPanel.Dock="Top" Classes="h3" TextAlignment="Center" Margin="0,8,0,8" />
    <Border DockPanel.Dock="Top" Classes="divider" />
    <StackPanel DockPanel.Dock="Bottom" Spacing="0">
      <Border Classes="divider" Opacity="0.6" />
      <!-- the notice and the documents it names, in the summary's column: beside Accept however long
           the summary runs, so a remote reaches them -->
      <StackPanel x:Name="NoticePanel" MaxWidth="720" Spacing="12" Margin="8,16,8,0">
        <TextBlock Classes="body-medium" TextWrapping="Wrap" Text="{Binding AcceptLicenseNotice, Source={x:Static res:Strings.Current}}" />
        <Button x:Name="TermsButton" Classes="text-highlight" HorizontalAlignment="Left" Padding="0" Click="OnTermsClick" IsVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="body-medium highlight" FontWeight="Bold" Text="{Binding TermsOfUse, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
            <TextBlock Classes="mdi highlight" FontSize="18" Text="{x:Static res:Mdi.OpenInNew}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="PrivacyButton" Classes="text-highlight" HorizontalAlignment="Left" Padding="0" Click="OnPrivacyClick" IsVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="body-medium highlight" FontWeight="Bold" Text="{Binding PrivacyPolicy, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
            <TextBlock Classes="mdi highlight" FontSize="18" Text="{x:Static res:Mdi.OpenInNew}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
      <controls:SettingsToggleItem x:Name="TrackerItem" Margin="0,16,0,0" IsVisible="False" />
      <Button x:Name="AcceptButton" Classes="pill btn3 block" Margin="0,16,0,0" Click="OnAcceptClick"
              Content="{Binding AcceptAndContinue, Source={x:Static res:Strings.Current}}" />
    </StackPanel>
    <!-- a box between the title and Accept rather than the page's scroller: it keeps to the inset.
         A remote scrolls it too (text-box) -->
    <ScrollViewer Classes="text-box" HorizontalScrollBarVisibility="Disabled" Margin="0,8" Padding="0">
      <TextBlock x:Name="DocumentText" Classes="body-medium disabled" TextWrapping="Wrap" MaxWidth="720" Margin="8,0" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
