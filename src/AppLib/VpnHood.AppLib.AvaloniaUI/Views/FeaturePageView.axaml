<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppLib.AvaloniaUI.Resources"
             x:Class="VpnHood.AppLib.AvaloniaUI.Views.FeaturePageView">
  <!-- The web UI's FeaturePageLayout: on the gradient sheet, a back button (not on a TV), the
       title with its coloured word, the description, the feature's picture, and a card - the
       numbered steps to turn the feature on with the button that opens the device's own settings,
       or the Go premium pitch when the feature is sold and this session has not bought it; two
       pages fill the card with their own text (cloak mode, the private DNS error). -->
  <Border Classes="grad-sheet">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <DockPanel Classes="page">
        <Grid DockPanel.Dock="Top" Margin="0,8,0,4" MinHeight="43">
          <Button x:Name="BackButton" Classes="back-btn" HorizontalAlignment="Left" VerticalAlignment="Top" Click="OnBackClick">
            <TextBlock Classes="mdi" Text="{x:Static res:Mdi.ChevronLeft}" />
          </Button>
        </Grid>
        <StackPanel MaxWidth="720" Spacing="10" HorizontalAlignment="Stretch">
          <TextBlock x:Name="TitleText" Classes="h3" TextAlignment="Center" />
          <TextBlock x:Name="DescriptionText" Classes="body-medium" TextAlignment="Center" TextWrapping="Wrap" IsVisible="False" />
          <Image x:Name="FeatureImage" Margin="0,12" MaxHeight="240" Stretch="Uniform" />

          <!-- the steps and the action -->
          <Border x:Name="StepsCard" Classes="card-on-grad" Padding="16,12" IsVisible="False">
            <StackPanel Spacing="10">
              <StackPanel x:Name="Steps" Spacing="8" />
              <Button x:Name="ActionButton" Classes="pill btn1 block" IsVisible="False" Click="OnActionClick" />
              <Button x:Name="SkipButton" Classes="pill btn2 block" IsVisible="False" Click="OnSkipClick"
                      Content="{Binding Skip, Source={x:Static res:Strings.Current}}" />
            </StackPanel>
          </Border>

          <!-- the pitch, where the feature is sold -->
          <Border x:Name="PremiumCard" Classes="card-on-grad" Padding="16,12" IsVisible="False">
            <StackPanel Spacing="12">
              <TextBlock Classes="body-medium" TextWrapping="Wrap" Text="{Binding GoPremiumAndUnlockFeatures, Source={x:Static res:Strings.Current}}" />
              <Button x:Name="PremiumButton" Classes="pill btn1 block" Click="OnPremiumClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="mdi" FontSize="18" Text="{x:Static res:Mdi.Crown}" />
                  <TextBlock Text="{Binding GoPremium, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <!-- cloak mode: its two paragraphs -->
          <Border x:Name="CloakCard" Classes="card-on-grad" Padding="16,12" IsVisible="False">
            <StackPanel Spacing="12">
              <TextBlock x:Name="CloakText1" Classes="body-medium" TextWrapping="Wrap" LineHeight="25" />
              <TextBlock Classes="body-medium" TextWrapping="Wrap" LineHeight="25" Text="{Binding CloakModeDesc2, Source={x:Static res:Strings.Current}}" />
            </StackPanel>
          </Border>

          <!-- the private DNS error: turn it off, or go premium -->
          <StackPanel x:Name="PrivateDnsCard" Spacing="12" IsVisible="False">
            <Button x:Name="TurnOffButton" Classes="card-on-grad" Click="OnTurnOffClick">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Classes="mdi" FontSize="25" Margin="0,0,8,0" Foreground="{StaticResource PromotePremiumColorFreeBrush}" Text="{x:Static res:Mdi.ServerOff}" />
                <TextBlock Grid.Column="1" Classes="body-small" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding PrivateDnsTurnOffMsg, Source={x:Static res:Strings.Current}}" />
                <Border Grid.Column="2" Classes="chip flat-btn2 comfortable" Margin="8,0,0,0">
                  <TextBlock Text="{Binding TurnOff, Source={x:Static res:Strings.Current}}" />
                </Border>
              </Grid>
            </Button>
            <Grid x:Name="OrRow" ColumnDefinitions="*,Auto,*" Width="200">
              <Border Classes="divider" VerticalAlignment="Center" Background="{StaticResource ActiveBrush}" Opacity="0.25" />
              <TextBlock Grid.Column="1" Classes="h3 active" Margin="8,0" Text="{Binding Or, Source={x:Static res:Strings.Current}}" />
              <Border Grid.Column="2" Classes="divider" VerticalAlignment="Center" Background="{StaticResource ActiveBrush}" Opacity="0.25" />
            </Grid>
            <Button Classes="card-on-grad" Click="OnPremiumClick">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Classes="mdi" FontSize="25" Margin="0,0,8,0" Foreground="{StaticResource PromotePremiumColorPremiumBrush}" Text="{x:Static res:Mdi.Crown}" />
                <TextBlock Grid.Column="1" Classes="body-small" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding GoPremiumAndUnlockFeatures, Source={x:Static res:Strings.Current}}" />
                <Border Grid.Column="2" Classes="chip flat-premium comfortable" Margin="8,0,0,0">
                  <TextBlock Text="{Binding GoPremium, Source={x:Static res:Strings.Current}}" />
                </Border>
              </Grid>
            </Button>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </ScrollViewer>
  </Border>
</UserControl>
