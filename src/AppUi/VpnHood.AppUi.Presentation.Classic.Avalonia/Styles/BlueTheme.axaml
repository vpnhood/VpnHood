<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Styles.BlueTheme">

  <!-- Blue, the default look. The plain keys are in BlueTheme.Brushes.axaml; below them, what a key
       of one colour cannot say - a gradient, a colour at an alpha. This file and VioletTheme.axaml
       carry the same keys and nothing else: a key added to one belongs in the other the same day.

       A class, like VioletTheme: the App merges the palettes before it loads its own XAML, since
       the styles name their keys with StaticResource, which is read once - and a dictionary that
       arrives after them is never looked at again. -->

  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://VpnHood.AppUi.Presentation.Classic.Avalonia/Styles/Colors.axaml" />
    <ResourceInclude Source="avares://VpnHood.AppUi.Presentation.Classic.Avalonia/Styles/BlueTheme.Brushes.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- the connect button: left to right, the second tone landing at 90%; connected, flat -->
  <LinearGradientBrush x:Key="ConnectBtnBrush" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Offset="0" Color="{StaticResource Blue100}" />
    <GradientStop Offset="0.9" Color="{StaticResource Green100}" />
  </LinearGradientBrush>

  <!-- the Main button look: the connect button's fill, so the app's first button and its Main never part -->
  <StaticResource x:Key="BtnMainBrush" ResourceKey="ConnectBtnBrush" />

  <!-- the home's ground: home-bg-grad-1 over home-bg-grad-2, top to bottom -->
  <LinearGradientBrush x:Key="HomeBgBrush" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="{StaticResource Blue200}" />
    <GradientStop Offset="1" Color="{StaticResource Blue300}" />
  </LinearGradientBrush>

  <!-- the feature pages' sheet: colored-bg-dark up to 60%, then to colored-bg-light at the top -->
  <LinearGradientBrush x:Key="PrimaryBgGradBrush" StartPoint="50%,100%" EndPoint="50%,0%">
    <GradientStop Offset="0" Color="{StaticResource Blue500}" />
    <GradientStop Offset="0.6" Color="{StaticResource Blue500}" />
    <GradientStop Offset="1" Color="{StaticResource Blue330}" />
  </LinearGradientBrush>

  <!-- a home row: config-btn-bg at 70%, its border on-config-btn-bg at 30% -->
  <SolidColorBrush x:Key="HomeConfigBtnBgBrush" Color="#B3122272" />
  <SolidColorBrush x:Key="HomeConfigBtnBorderBrush" Color="#4D16A3FE" />

  <!-- the update notice's surface: config-btn-bg opaque, as the page under it must not show through -->
  <SolidColorBrush x:Key="UpdateNoticeBrush" Color="{StaticResource Blue300}" />

  <!-- a card on the sheet: card-on-grad-bg at 30% -->
  <SolidColorBrush x:Key="CardOnGradBgAlphaBrush" Color="#4D0E1C5F" />

  <!-- a premium session's connection circle, gold where ConnectionCircleShineBrush is green -->
  <SolidColorBrush x:Key="ConnectionCirclePremiumShineBrush" Color="#FFC83D" />

</ResourceDictionary>
