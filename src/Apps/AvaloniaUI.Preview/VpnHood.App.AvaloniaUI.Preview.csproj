<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>false</IsPackable>	<!-- a developer's tool, never shipped -->
		<Description>Runs the Avalonia UI (VpnHood.AppLib.AvaloniaUI) on the Windows device in a window that opens at a TV's size and resizes down to a phone's, so a screen can be walked with the arrow keys and seen in both layouts before a device is involved - the Avalonia counterpart of the web UI's /tv-mode. "--tv" runs it as a TV.</Description>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>VpnHood.App.AvaloniaUI.Preview</RootNamespace>
		<AssemblyName>VpnHoodAvaloniaPreview</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\AppLib\VpnHood.AppLib.AvaloniaUI\VpnHood.AppLib.AvaloniaUI.csproj" />
		<ProjectReference Include="..\..\Core\VpnHood.Core.Client.Devices.Win\VpnHood.Core.Client.Devices.Win.csproj" />
		<!-- Shared client resources: the SPA the pairing hands to the phone, the IP-location db. -->
		<ProjectReference Include="..\Client\VpnHood.App.Client.csproj" />
	</ItemGroup>
</Project>
