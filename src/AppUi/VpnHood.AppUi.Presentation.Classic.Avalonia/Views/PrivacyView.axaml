<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppUi.Common"
             xmlns:controls="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Controls"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.PrivacyView">
  <!-- The web UI's settings/privacy: the consent to anonymous data, where the build collects any,
       and the privacy policy's link. -->
  <DockPanel Classes="page">
    <controls:PageHeader x:Name="Header" DockPanel.Dock="Top" Title="{Binding Privacy, Source={x:Static res:Strings.Current}}" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="720" Spacing="4">
        <controls:SettingsToggleItem x:Name="TrackerItem" Toggled="OnTrackerToggled" />
        <Border x:Name="PolicyCard" Classes="config-card" Padding="16,12">
          <StackPanel Spacing="12">
            <TextBlock x:Name="NoticeText" Classes="card-subtitle" Text="{Binding AnonymousTrackerNotice, Source={x:Static res:Strings.Current}}" />
            <Button x:Name="PolicyButton" Classes="text-highlight" HorizontalAlignment="Left" Padding="0" Click="OnPolicyClick">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="body-medium highlight" Text="{Binding PrivacyPolicy, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                <TextBlock Classes="mdi highlight" FontSize="18" Text="{x:Static res:Mdi.OpenInNew}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
