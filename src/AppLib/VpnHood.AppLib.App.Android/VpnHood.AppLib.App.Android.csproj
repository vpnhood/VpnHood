<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>VpnHood Android Client App Common Library</Description>
		<TargetFramework>net11.0-android37.0</TargetFramework>
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
		<BaseIntermediateOutputPath />
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\VpnHood.AppLib.Api.WebHost\VpnHood.AppLib.Api.WebHost.csproj" />
		<ProjectReference Include="..\..\Core\VpnHood.Core.Client.Devices.Android\VpnHood.Core.Client.Devices.Android.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Draws the app's icons from its SVGs at build time (VpnHood.AppLib.App.targets): its targets reach
		     every head that references this, and nothing of it ships in the app. -->
		<PackageReference Include="Microsoft.Maui.Resizetizer" Version="11.0.0-rc.2.26505.5" />
	</ItemGroup>

	<!-- Every Android app's manifest (buildTransitive/, the targets beside it make it the app's). No build/
	     copy: NuGet takes buildTransitive/ for a direct reference too. Each file on its own line: a folder
	     alone as PackagePath would nest it twice. -->
	<ItemGroup>
		<None Update="buildTransitive\VpnHood.AppLib.App.Android.targets" Pack="true" PackagePath="buildTransitive\VpnHood.AppLib.App.Android.targets" />
		<None Update="buildTransitive\AndroidManifest.xml" Pack="true" PackagePath="buildTransitive\AndroidManifest.xml" />
	</ItemGroup>

</Project>