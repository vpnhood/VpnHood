<Project Sdk="MSTest.Sdk/4.4.1">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<UseVSTest>true</UseVSTest>
		<!--MSTest.Sdk injects the test packages implicitly; override its bundled versions via these properties, NOT
		    PackageReference Update (which is a no-op against the SDK's late .targets Include). MSTestVersion defaults to
		    the SDK's bundled version, so only the VSTest platform needs pinning to the latest.-->
		<MicrosoftNETTestSdkVersion>18.10.1</MicrosoftNETTestSdkVersion>
	</PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Net\VpnHood.Net.TcpStack\VpnHood.Net.TcpStack.csproj" />
    <ProjectReference Include="..\..\src\Net\VpnHood.Net.VpnAdapters.WinDivert\VpnHood.Net.VpnAdapters.WinDivert.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestAdapter" Version="4.4.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestFramework" Version="4.4.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.10.1" />
  </ItemGroup>

</Project>
