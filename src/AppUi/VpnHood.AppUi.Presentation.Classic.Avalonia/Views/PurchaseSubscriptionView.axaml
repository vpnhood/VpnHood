<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppUi.Common"
             xmlns:controls="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Controls"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.PurchaseSubscriptionView">
  <!-- The web UI's purchase-subscription page: what premium brings, in a carousel; then the ways to
       it - the store's plans, or the reason the store cannot be reached; the website, where a link
       can reach the person; a code; and the way back to a premium already owned. -->
  <Border Classes="grad-sheet">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <DockPanel Classes="page">
        <Grid DockPanel.Dock="Top" Margin="0,8,0,4" MinHeight="43">
          <Button x:Name="BackButton" Classes="back-btn" HorizontalAlignment="Left" Click="OnBackClick">
            <TextBlock Classes="mdi" Text="{Binding ChevronBack, Source={x:Static res:Strings.Current}}" />
          </Button>
        </Grid>
        <StackPanel MaxWidth="560" Spacing="12">
          <controls:PremiumFeaturesCarousel x:Name="Carousel" />

          <!-- the catalog, while it loads -->
          <StackPanel x:Name="LoadingPanel" Spacing="10" HorizontalAlignment="Center" Margin="0,16">
            <TextBlock Classes="spinner" FontSize="30" Text="{x:Static res:Mdi.Loading}" HorizontalAlignment="Center" />
            <TextBlock Classes="body-small" Opacity="0.6" Text="{Binding PleaseWait, Source={x:Static res:Strings.Current}}" />
          </StackPanel>

          <StackPanel x:Name="OptionsPanel" Spacing="12" IsVisible="False">

            <!-- PurchaseByStore: the plans, the one chosen outlined; the small print; Purchase -->
            <StackPanel x:Name="StorePanel" Spacing="8" IsVisible="False">
              <ScrollViewer MaxHeight="224" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Plans" Spacing="8" Margin="0,8,0,0" />
              </ScrollViewer>
              <StackPanel x:Name="PlanNotes" Spacing="4" Margin="16,8,0,8" Opacity="0.5">
                <TextBlock x:Name="AutoRenewText" Classes="body-small" TextWrapping="Wrap" />
                <TextBlock Classes="body-small" TextWrapping="Wrap" Text="{Binding CancelAnytimeInStore, Source={x:Static res:Strings.Current}}" />
                <StackPanel x:Name="LinksRow" Orientation="Horizontal" Spacing="4">
                  <Button x:Name="TermsLink" Classes="text-highlight" Padding="0" Click="OnTermsClick">
                    <TextBlock Classes="body-small" Text="{Binding TermsOfUse, Source={x:Static res:Strings.Current}}" />
                  </Button>
                  <TextBlock x:Name="LinksDot" Classes="body-small" Text="·" VerticalAlignment="Center" />
                  <Button x:Name="PrivacyLink" Classes="text-highlight" Padding="0" Click="OnPrivacyClick">
                    <TextBlock Classes="body-small" Text="{Binding PrivacyPolicy, Source={x:Static res:Strings.Current}}" />
                  </Button>
                </StackPanel>
              </StackPanel>
              <Button x:Name="PurchaseButton" Classes="pill block bold" Height="40" Background="{StaticResource PurchaseSubscriptionBtnBrush}"
                      Click="OnPurchaseClick" Content="{Binding Purchase, Source={x:Static res:Strings.Current}}" />
            </StackPanel>

            <!-- StoreUnavailable: the store could not be reached; try again, or read why -->
            <Border x:Name="StoreErrorCard" Classes="card-on-grad" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" IsVisible="False">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Classes="mdi error" FontSize="22" Text="{x:Static res:Mdi.AlertCircleOutline}" VerticalAlignment="Center" />
                  <TextBlock Classes="body-small error" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding OnlinePurchaseIsNotAvailable, Source={x:Static res:Strings.Current}}" />
                </StackPanel>
                <Button x:Name="RetryButton" Classes="flat-error pill block small" Click="OnRetryClick">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Classes="mdi" FontSize="16" Text="{x:Static res:Mdi.Refresh}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TryAgain, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="MoreInfoButton" Classes="tonal-error pill block small" Click="OnMoreInfoClick" Content="{Binding MoreInfo, Source={x:Static res:Strings.Current}}" />
              </StackPanel>
            </Border>

            <!-- the website, where a link can reach the person -->
            <Button x:Name="WebButton" Classes="pill block" Height="40" Background="{StaticResource CardOnGradBgAlphaBrush}" Click="OnWebClick" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBlock Classes="mdi" FontSize="18" Foreground="{StaticResource PremiumCodeBtnBrush}" Text="{x:Static res:Mdi.Web}" VerticalAlignment="Center" />
                <TextBlock Foreground="{StaticResource PremiumCodeBtnBrush}" Text="{Binding PurchaseViaWeb, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- a code -->
            <Button x:Name="CodeButton" Classes="pill block" Height="40" Background="{StaticResource CardOnGradBgAlphaBrush}" Click="OnCodeClick" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBlock Classes="mdi" FontSize="18" Foreground="{StaticResource PremiumCodeBtnBrush}" Text="{x:Static res:Mdi.Key}" VerticalAlignment="Center" />
                <TextBlock Foreground="{StaticResource PremiumCodeBtnBrush}" Text="{Binding IHaveAPremiumCode, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- RestorePremium: the way back to what is already owned -->
            <Button x:Name="RestoreButton" Classes="text-highlight small" HorizontalAlignment="Center" Click="OnRestoreClick" IsVisible="False">
              <TextBlock x:Name="RestoreText" Classes="body-small" Foreground="{StaticResource WhiteBrush}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </ScrollViewer>
  </Border>
</UserControl>
