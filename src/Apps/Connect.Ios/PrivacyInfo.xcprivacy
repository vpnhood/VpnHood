<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Apple's privacy manifest for the HOST APP. Required since May 2024: App Store Connect scans the
     upload for "required reason" API use and rejects with ITMS-91053 when a use is not declared here.
     The Network Extension is a separate bundle and needs its OWN manifest — see
     Connect.Ios.Extension/PrivacyInfo.xcprivacy, which declares less because it runs no analytics.

     Reason codes come from Apple's published lists; they are NOT free text and an unrecognised code
     fails validation. On the first App Store upload, check the Xcode/altool privacy report against
     this file — the .NET BCL can reach a required-reason API from code we never call directly.

     CONNECT vs CLIENT: this app ships Sign in with Apple + StoreKit billing on the Portal backend
     AND runs the AppLib GA4 tracker (Ga4MeasurementId, absent from the Client's settings) in addition
     to the SPA's Firebase Analytics, with AllowEndPointTracker=true. So it declares SIX collected
     types to the Client's three — adding Email Address, Purchase History and Other Usage Data — and
     marks the account-bound ones (Email, Purchase History, User ID) as Linked. The accessed-API list
     is identical because both apps run the same AppLib/iOS code.

     The reasoning behind every answer here — and the matching App Store Connect "App Privacy" panel
     answers, which Apple cross-checks against this manifest — is recorded in
     docs/legal/developer/APP_STORE_PRIVACY.md, section "VpnHood! CONNECT on iOS". Change one, change
     both, and ship a new build: the panel alone cannot fix a mismatch. -->
<plist version="1.0">
<dict>
	<!-- No cross-app/cross-site tracking: no IDFA, no ATTrackingManager, and no ad or attribution SDK is
	     linked into the iOS Connect app. The AdMob / Chartboost / InMobi / AppsFlyer keys that appear in
	     .user/VpnHoodConnect/appsettings.json are ANDROID-only — Connect.Ios/AppConfigs.cs implements
	     IRequiredAppConfigs and simply ignores those properties, and no ad package is referenced by
	     VpnHood.App.Connect.Ios.csproj. false here is what keeps the app out of the App Tracking
	     Transparency prompt requirement; adding any ad/attribution SDK to iOS MUST flip this to true and
	     add NSUserTrackingUsageDescription to Info.plist. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<!-- Only meaningful when NSPrivacyTracking is true. Must stay EMPTY: any domain listed here is
	     hard-blocked by the system when the user denies tracking. -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- What the app can send. Analytics (the AppLib GA4 tracker plus Firebase Analytics in the SPA
	     WebView) stays behind the user's "Share anonymous usage data" consent
	     (UserSettings.AllowAnonymousTracker — when it is off neither tracker is constructed, and
	     VpnHoodApp.cs gates AllowEndPointTracker on the same flag) and stays UNLINKED: the analytics
	     stream keys on the random install id and never carries the account id or email. The
	     account-bound types (Email Address, Purchase History, User ID) are LINKED — Sign in with Apple
	     means an account exists — and exist regardless of the analytics consent, because they are what
	     signs the user in and grants the entitlement (purpose App Functionality). -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- setUserId(clientId): a random per-install id, used to de-duplicate event streams. It also
		     travels in the VPN session handshake (ClientInfo), and VpnHood's own servers keep per-client
		     quota/session records against it — hence App Functionality in addition to Analytics.
		     Linked=true: with sign-in on board the portal can join the id to the account. See
		     docs/legal/developer/APP_STORE_PRIVACY.md ("VpnHood! CONNECT on iOS"); the App Store Connect
		     panel must declare the same purposes and linkage. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Sign in with Apple, email scope ONLY (no name — deliberate policy, see
		     APP_STORE_PRIVACY.md). May be an Apple private-relay address; still an email address. The
		     portal stores it as the account identity. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- StoreKit purchases: the signed transaction and its id go to the account backend, which
		     stores them against the account to grant and restore the entitlement. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- CONNECT-ONLY. The native GA4 tracker is live here (Ga4MeasurementId is set; the Client's
		     TrackerFactory falls back to a NullTracker), so ClientUsageTracker reports periodic usage
		     counters — traffic totals plus request/connection counts, every 25 minutes. That is usage
		     data beyond product interaction, so it gets its own type. Remove this entry if a build ever
		     ships without Ga4MeasurementId. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUsageData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- GA4's automatic app/page events, our own UI events, and the consented endpoint tracking
		     (AllowEndPointTracker: which server location a session used — usage of the product, not a
		     browsing history; the tunnel's traffic itself is never inspected or reported). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- Error-dialog messages and app version reported by ErrorHandler for triage. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- IosAppCultureProvider stores/reads the selected UI culture in NSUserDefaults.
		     CA92.1 = access info from the app itself or its App Group container. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- IosMemoryMonitor reads the previous log's timestamp; the BCL also stats files it writes.
		     C617.1 = timestamps of files inside the app's own container. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<!-- Environment.TickCount64/Stopwatch throughout the client resolve to mach_absolute_time.
		     35F9.1 = measure elapsed time. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
		<!-- Reached by the .NET BCL when writing the settings/log/IP-location files rather than by our
		     own code. E174.1 = check free space before writing, to avoid running out of disk. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
