<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>VpnHood Android Ad Library for AdMob</Description>
		<TargetFramework>net10.0-android36.1</TargetFramework>
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
		<BaseIntermediateOutputPath />
	</PropertyGroup>

	<ItemGroup>
	  <ProjectReference Include="..\VpnHood.AppLib.Abstractions\VpnHood.AppLib.Abstractions.csproj" />
	  <ProjectReference Include="..\..\Core\VpnHood.Core.Client.Devices.Android\VpnHood.Core.Client.Devices.Android.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <!-- Held at 125.4: 125.5 needs AndroidX AppCompat 1.8, which Avalonia.Android (12.1.3) pins
	       below, at 1.7.1, so a head with both does not restore (NU1107). -->
	  <PackageReference Include="Xamarin.GooglePlayServices.Ads" Version="125.4.0.2" />
	</ItemGroup>
</Project>