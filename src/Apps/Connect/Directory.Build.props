<Project>

  <!-- MSBuild imports only the NEAREST Directory.Build.props, so this file shadows src/Apps' one (and
       through it the repo's): import it first, as that one does the repo's. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- The Connect app's identity, once for every head below: each builds its ids and the name it shows
       from these (VpnHood.AppLib.App.targets). The package title is stated, not derived from the name:
       it is the Windows service, the Linux unit and the folders every install already has. -->
  <PropertyGroup>
    <VhAppIdBase>com.vpnhood.connect</VhAppIdBase>
    <VhAppName>VpnHood! CONNECT</VhAppName>
    <VhAppPackageTitle>VpnHoodConnect</VhAppPackageTitle>
    <VhAppCommandName>vhconnect</VhAppCommandName>
    <!-- the AdMob application id the Google Play head's manifest names (AppConstants.AdMobApplicationId) -->
    <VhAdMobApplicationId>ca-app-pub-8662231806304184~1740102860</VhAdMobApplicationId>
    <!-- the Android and iOS icons, as SVGs (VpnHood.AppLib.App.targets) -->
    <VhAppIconsDir>$(MSBuildThisFileDirectory)icons</VhAppIconsDir>
    <!-- the Windows setup's Welcome and Finish picture, a BMP it shows as it is (Publish-WinApp.ps1) -->
    <VhAppSetupImage>$(MSBuildThisFileDirectory)setup.bmp</VhAppSetupImage>
    <!-- the private settings, from the external ".user" folder: the product's project embeds them, and
         the build reads the launch screen's theme from them (VpnHood.AppLib.App.targets). Forward
         slashes: the iOS head builds on macOS. -->
    <VhAppSettingsFile>$(VhUserDir)/$(VhAppPackageTitle)/appsettings.json</VhAppSettingsFile>
  </PropertyGroup>

  <!-- After the values, as NuGet imports a package's props after Directory.Build.props: the same file
       a package reference of VpnHood.AppLib.App imports. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\AppLib\VpnHood.AppLib.App\buildTransitive\VpnHood.AppLib.App.props" />

</Project>
