<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppLib.AvaloniaUI.Resources"
             xmlns:controls="using:VpnHood.AppLib.AvaloniaUI.Controls"
             x:Class="VpnHood.AppLib.AvaloniaUI.Views.TurnOffPrivateDnsView">
  <!-- The web UI's turn-off-private-dns: how to turn the device's private DNS off, in steps, with
       the device's settings a press away where the device opens them. -->
  <DockPanel Classes="page">
    <controls:PageHeader x:Name="Header" DockPanel.Dock="Top" Title="{Binding TurnOffPrivateDns, Source={x:Static res:Strings.Current}}" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="720" Spacing="20">
        <Border Width="80" Height="80" CornerRadius="40" Background="{StaticResource ConfigCardBgBrush}" HorizontalAlignment="Center">
          <TextBlock Classes="mdi" FontSize="50" Foreground="{StaticResource TonalIconBtnBrush}" Text="{x:Static res:Mdi.ServerOff}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Classes="body-medium" TextWrapping="Wrap" Margin="12,0" Text="{Binding PrivateDnsHowToTurnOffDesc, Source={x:Static res:Strings.Current}}" />
        <Border Classes="config-card" Padding="16,20">
          <StackPanel x:Name="Steps" Spacing="8" />
        </Border>
        <Button x:Name="SettingsButton" Classes="btn3 block" Click="OnSettingsClick" IsVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="{Binding OpenSystemSettings, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
            <TextBlock Classes="mdi" FontSize="18" Text="{x:Static res:Mdi.OpenInNew}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Classes="body-medium" TextWrapping="Wrap" Margin="12,0" Text="{Binding PrivateDnsHowToTurnOffFinalDesc, Source={x:Static res:Strings.Current}}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
