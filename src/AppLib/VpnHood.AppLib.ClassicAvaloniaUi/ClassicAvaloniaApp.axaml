<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VpnHood.AppLib.ClassicAvaloniaUi.ClassicAvaloniaApp"
             RequestedThemeVariant="Dark">
  <!-- The client's palette, merged here as the default: every key a style or a view names can
       then be followed to its definition by the tooling. The other product's palette is merged
       over it in code once this file is loaded (Initialize) - a dictionary merged later wins -
       and the styles below read their keys when they are first applied, after both are in
       place. Dark is what the Fluent controls take for the keys no theme of ours names. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VpnHood.AppLib.ClassicAvaloniaUi/Styles/ClientTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://VpnHood.AppLib.ClassicAvaloniaUi/Styles/AppTheme.axaml" />
  </Application.Styles>
</Application>
