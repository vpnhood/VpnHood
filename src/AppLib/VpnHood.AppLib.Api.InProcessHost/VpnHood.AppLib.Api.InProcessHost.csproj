<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Answers the VpnHood app API in the app's own process: the controllers behind the contract, with no listener and no transport. A UI on the device calls them directly; a web host puts the same objects on HTTP.</Description>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>VpnHood.AppLib.Api.InProcessHost</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
	  <!-- The contract these controllers answer, and the app that does the work. -->
	  <ProjectReference Include="..\VpnHood.AppLib.Api\VpnHood.AppLib.Api.csproj" />
	  <ProjectReference Include="..\VpnHood.AppLib.App\VpnHood.AppLib.App.csproj" />
	</ItemGroup>

</Project>
