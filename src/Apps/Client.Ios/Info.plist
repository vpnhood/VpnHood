<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>VpnHood! Client</string>
	<key>CFBundleIdentifier</key>
	<string>com.vpnhood.client.ios</string>
	<!-- NO ITSAppUsesNonExemptEncryption here — deliberate. Declaring true requires an Apple-issued
	     ITSEncryptionExportComplianceCode in the binary, and the non-France App Encryption
	     Documentation flow never issues one, so true-without-code makes altool reject every upload
	     (error 90592). Compliance is declared on the App Store Connect app record instead.
	     See docs/legal/APP_STORE_EXPORT_COMPLIANCE.md before adding any ITS* key. -->
	<!-- CFBundleShortVersionString / CFBundleVersion are injected by the .NET iOS SDK from
	     ApplicationDisplayVersion / ApplicationVersion (set by pub/lib/Publish-IosApp.ps1 from
	     PubVersion.json). Do NOT hardcode them here: a literal value OVERRIDES the MSBuild props and
	     ships every build as 1.0 (1.0), which also collides on the next TestFlight upload. -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The SPA is served over plain HTTP from an in-process loopback web server; allow it. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Opt out of iPad multitasking so IosSpaWebViewController's orientation mask (portrait lock by
	     default; see AllowRotation) is honored — multitasking-capable iPad apps must support all
	     orientations and ignore the view controller's mask. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/AppIcon.appiconset</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
