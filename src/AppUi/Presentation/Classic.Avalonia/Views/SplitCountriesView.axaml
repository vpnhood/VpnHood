<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppLib.Assets"
             xmlns:controls="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Controls"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.SplitCountriesView">
  <!-- The web UI's split-countries: three modes, and the country list with its switches when the
       list is the mode. Inert while splitting is off; the alert on top repairs that. -->
  <DockPanel Classes="page">
    <controls:PageHeader x:Name="Header" DockPanel.Dock="Top" Title="{Binding SplitCountries, Source={x:Static res:Strings.Current}}" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="720">
        <controls:SplitDisabledAlert x:Name="DisabledAlert" TurnedOn="OnTurnedOn" />
        <TextBlock Classes="card-subtitle" Margin="0,0,0,16" Text="{Binding SplitCountriesDesc, Source={x:Static res:Strings.Current}}" />
        <Border x:Name="ModeCard" Classes="config-card" Padding="4,8" Margin="0,0,0,16">
          <StackPanel>
            <controls:OptionRow x:Name="IncludeAllRow" Clicked="OnIncludeAllClick" />
            <controls:OptionRow x:Name="ExcludeMyCountryRow" Clicked="OnExcludeMyCountryClick" />
            <controls:OptionRow x:Name="ExcludeListRow" Clicked="OnExcludeListClick" />
          </StackPanel>
        </Border>
        <controls:FilterList x:Name="List" IsIconFlag="True" IsVisible="False" SelectionChanged="OnSelectionChanged" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
