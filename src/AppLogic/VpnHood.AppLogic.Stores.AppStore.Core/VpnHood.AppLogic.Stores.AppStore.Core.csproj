<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>VpnHood App Store updates and reviews, which any App Store app can use. Billing and Sign in with Apple are in VpnHood.AppLogic.Stores.AppStore.</Description>
		<TargetFrameworks>$(VhAppleTargetFrameworks)</TargetFrameworks>
		<VhApiDocsComplete>true</VhApiDocsComplete>
		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-tvos'))">17.0</SupportedOSPlatformVersion>
		<RootNamespace>VpnHood.AppLogic.Stores.AppStore</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\VpnHood.AppLogic.Abstractions\VpnHood.AppLogic.Abstractions.csproj" />
		<ProjectReference Include="..\..\Core\VpnHood.Core.Client.Devices.Ios\VpnHood.Core.Client.Devices.Ios.csproj" />
	</ItemGroup>

</Project>
