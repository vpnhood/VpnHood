<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Android implementation of the VpnHood QUIC abstractions (IQuicClient/IQuicConnection/Stream) over MsQuic. All native linking (libmsquic.so) and the Microsoft.Quic P/Invoke bindings are provided by the VpnHood.Net.Quic.MsQuic.AndroidNative package; this project is pure managed code.</Description>
		<TargetFramework>net10.0-android36.1</TargetFramework>
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Our managed P/Invoke wrappers (MsQuicApi, AndroidQuicClient/Connection/Stream) use pointers. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<!-- All native QUIC complexity (libmsquic.so per ABI + the Microsoft.Quic P/Invoke bindings) lives
		     in this self-contained package. The fork's GitHub Actions publish a new build on every
		     push, so the version is pinned and moves after a test. -->
		<PackageReference Include="VpnHood.Net.Quic.MsQuic.AndroidNative" Version="8.0.13" />
	</ItemGroup>

	<ItemGroup>
		<!-- VpnHood.Net.Toolkit provides SystemSocketFactory and transitively Quic.Abstractions. -->
		<ProjectReference Include="..\VpnHood.Net.Toolkit\VpnHood.Net.Toolkit.csproj" />
	</ItemGroup>

</Project>
