<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Hosts the app web UI in an iOS WKWebView: the IWebView adapter and the view controller a head mounts as its root</Description>
		<TargetFramework>net11.0-ios</TargetFramework>
		<VhApiDocsComplete>true</VhApiDocsComplete>
		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- The shared controller this adapter reports to. -->
		<ProjectReference Include="..\VpnHood.AppHosting.WebView\VpnHood.AppHosting.WebView.csproj" />
		<!-- The app's iOS bootstrap and UI context. Not a UI - it stays in AppLogic. -->
		<ProjectReference Include="..\..\AppLogic\VpnHood.AppLogic.App.Ios\VpnHood.AppLogic.App.Ios.csproj" />
	</ItemGroup>
</Project>
