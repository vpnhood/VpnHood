<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Hosts the app web UI in an Android WebView: the application and the main activity a head derives from, over its IWebView adapter and web-view clients</Description>
		<TargetFramework>net11.0-android37.0</TargetFramework>
		<VhApiDocsComplete>true</VhApiDocsComplete>
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
		<BaseIntermediateOutputPath />
	</PropertyGroup>

	<ItemGroup>
		<!-- The shared controller this adapter reports to. -->
		<ProjectReference Include="..\VpnHood.AppUi.Hosting.WebView\VpnHood.AppUi.Hosting.WebView.csproj" />
		<!-- The app's Android lifecycle: AndroidAppMainActivityHandler, the activity options, the
		     window-inset helpers. Not a UI - it stays in AppLib and this references it downward. -->
		<ProjectReference Include="..\..\AppLib\VpnHood.AppLib.App.Android\VpnHood.AppLib.App.Android.csproj" />
	</ItemGroup>

</Project>
