<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Readymade Vpn App skeleton for VpnHood clients. You just need to create an UI on it</Description>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Nager.Country" Version="4.7.1" />
	  <PackageReference Include="Nager.Country.Translation" Version="4.7.1" />
	</ItemGroup>

	<ItemGroup>
	  <InternalsVisibleTo Include="VpnHood.Test" />
	  <InternalsVisibleTo Include="VpnHood.AppLib.Test" />
	</ItemGroup>

	<!-- The app's identity (buildTransitive/, the .props and .targets beside this file): every head
	     reaches this package, so an app states its id base and its name once and its heads build their
	     ids, names and constants from them. No build/ copy: NuGet takes buildTransitive/ for a direct
	     reference too. Each file's whole path in the package: a default None item keeps its folder,
	     and a folder alone as PackagePath would nest it twice. -->
	<ItemGroup>
		<None Update="buildTransitive\VpnHood.AppLib.App.props" Pack="true" PackagePath="buildTransitive\VpnHood.AppLib.App.props" />
		<None Update="buildTransitive\VpnHood.AppLib.App.targets" Pack="true" PackagePath="buildTransitive\VpnHood.AppLib.App.targets" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Net\VpnHood.Net.IpLocations\VpnHood.Net.IpLocations.csproj" />
		<ProjectReference Include="..\..\Core\VpnHood.Core.Client.VpnServices.Manager\VpnHood.Core.Client.VpnServices.Manager.csproj" />
		<ProjectReference Include="..\..\Core\VpnHood.Core.Filtering.Sqlite\VpnHood.Core.Filtering.Sqlite.csproj" />
		<ProjectReference Include="..\..\Core\VpnHood.Core.Proxies.Management.Sqlite\VpnHood.Core.Proxies.Management.Sqlite.csproj" />
		<ProjectReference Include="..\VpnHood.AppLib.Abstractions\VpnHood.AppLib.Abstractions.csproj" />
		<!-- The shapes and the six interfaces this app fills: the contract, which knows nothing of it. -->
		<ProjectReference Include="..\VpnHood.AppLib.Api\VpnHood.AppLib.Api.csproj" />
	</ItemGroup>


	<ItemGroup>
	  <Compile Update="Resources.Designer.cs">
	    <DependentUpon>Resources.resx</DependentUpon>
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Resources.resx">
	    <SubType>Designer</SubType>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	    <Generator>ResXFileCodeGenerator</Generator>
	  </EmbeddedResource>
	</ItemGroup>

</Project>
