<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpnHood.AppLib.AvaloniaUI.ViewModels"
             xmlns:res="using:VpnHood.AppLib.Assets"
             x:Class="VpnHood.AppLib.AvaloniaUI.Controls.FilterList">
  <!-- The web UI's FilterList: Select all, Clear all and Search over a list of rows, each an icon
       or a flag, a name and a switch. A row is a button and its press flips its switch; on a TV
       the search box is behind its button, since a remote types nothing until asked. -->
  <Border Classes="config-card" Padding="0,12,0,4">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,16,8">
        <Button x:Name="SelectAllButton" Classes="pill btn5 small" Click="OnSelectAllClick">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="mdi" FontSize="16" Text="{x:Static res:Mdi.SelectAll}" />
            <TextBlock Classes="body-small" Text="{Binding SelectAll, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="ClearAllButton" Classes="pill btn5 small" Click="OnClearAllClick">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="mdi" FontSize="16" Text="{x:Static res:Mdi.SelectRemove}" />
            <TextBlock Classes="body-small" Text="{Binding ClearAll, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="SearchButton" Classes="pill btn5 small" Click="OnSearchClick">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="mdi" FontSize="16" Text="{x:Static res:Mdi.Magnify}" />
            <TextBlock Classes="body-small" Text="{Binding Search, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
      <TextBox x:Name="SearchBox" Classes="outlined" Margin="16,4,16,8" CornerRadius="18" IsVisible="False" TextChanged="OnSearchChanged" />

      <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Spacing="10" Margin="16,24" IsVisible="False">
        <TextBlock Classes="spinner" FontSize="22" Text="{x:Static res:Mdi.Loading}" />
        <TextBlock Classes="body-small disabled" Text="{Binding PleaseWait, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
      </StackPanel>

      <ItemsControl x:Name="List" Margin="0,4,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FilterItem">
            <Button Classes="list-item" Click="OnRowClick">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="icon-box" Width="30" Height="30" CornerRadius="15" ClipToBounds="True" Margin="0,0,12,0">
                  <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                </Border>
                <TextBlock Grid.Column="1" Classes="body-small" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsSelected}" IsHitTestVisible="False" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
