<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppLib.AvaloniaUI.Resources"
             x:Class="VpnHood.AppLib.AvaloniaUI.Views.PromoteView">
  <!-- The web UI's promote-premium page: the location asks to be asked - stay on the free side,
       for a while or after an ad; or the premium side, by an ad, a trial or an upgrade. Each row
       is a plan, and Connect on it connects with that plan. -->
  <Border Classes="grad-sheet">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <DockPanel Classes="page">
        <Grid DockPanel.Dock="Top" Margin="0,8,0,4" MinHeight="43">
          <Button x:Name="BackButton" Classes="back-btn" HorizontalAlignment="Left" Click="OnBackClick">
            <TextBlock Classes="mdi" Text="{Binding ChevronBack, Source={x:Static res:Strings.Current}}" />
          </Button>
        </Grid>
        <StackPanel MaxWidth="720" Spacing="12">
          <TextBlock x:Name="TitleText" Classes="h3" TextAlignment="Center" />
          <Image x:Name="PromoImage" MaxWidth="500" MaxHeight="220" Stretch="Uniform" Margin="0,8" />

          <Button x:Name="FreeRow" Classes="card-on-grad" IsVisible="False" Click="OnFreeClick">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="body-medium" FontWeight="Bold" Text="{Binding SelectedFreeServer, Source={x:Static res:Strings.Current}}" />
                <TextBlock x:Name="FreeDesc" Classes="body-small" Opacity="0.4" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Classes="chip flat-btn2 comfortable" Margin="8,0,0,0">
                <TextBlock Text="{Binding Connect, Source={x:Static res:Strings.Current}}" />
              </Border>
            </Grid>
          </Button>
          <Button x:Name="FreeAdRow" Classes="card-on-grad" IsVisible="False" Click="OnFreeAdClick">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="body-medium" FontWeight="Bold" Text="{Binding SelectedFreeServerByRewardedAd, Source={x:Static res:Strings.Current}}" />
                <TextBlock x:Name="FreeAdDesc" Classes="body-small" Opacity="0.4" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Classes="chip flat-btn2 comfortable" Margin="8,0,0,0">
                <TextBlock Text="{Binding Connect, Source={x:Static res:Strings.Current}}" />
              </Border>
            </Grid>
          </Button>

          <Grid x:Name="OrRow" ColumnDefinitions="*,Auto,*" Width="200" IsVisible="False" Margin="0,8">
            <Border Classes="divider" VerticalAlignment="Center" Background="{StaticResource ActiveBrush}" Opacity="0.25" />
            <TextBlock Grid.Column="1" Classes="h3 active" Margin="8,0" Text="{Binding Or, Source={x:Static res:Strings.Current}}" />
            <Border Grid.Column="2" Classes="divider" VerticalAlignment="Center" Background="{StaticResource ActiveBrush}" Opacity="0.25" />
          </Grid>

          <StackPanel x:Name="PremiumRows" Spacing="12" />
        </StackPanel>
      </DockPanel>
    </ScrollViewer>
  </Border>
</UserControl>
