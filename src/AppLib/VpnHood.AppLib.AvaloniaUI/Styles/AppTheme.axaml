<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:VpnHood.AppLib.AvaloniaUI.Controls">

  <!-- The shapes, in the theme's keys: what a key is worth is the product's, and lives in
       ClientTheme.axaml or ConnectTheme.axaml (the web UI's two themes, theme/themes.ts), so a
       page ported here paints what it painted there in either product. Nothing below names a
       colour of its own. Type and focus fit a TV first (TV plan §3.4): every control wears a ring
       while a remote or a keyboard has it (:focus-visible - a finger's focus shows nothing, as on
       the web UI), and the layouts query the page host's width (the "Page"
       container, MainView): under 600 logical px a two-column page stacks. -->

  <Styles.Resources>
    <FontFamily x:Key="IconFont">fonts:VpnHood#Material Design Icons</FontFamily>

    <!-- What the web UI writes as an opacity rather than a colour, so the same in both products:
         white text at Vuetify's emphasis levels, its 3% border, the ring, a tonal wash of white,
         and the scrim behind a dialog (override.css: black at 60%). -->
    <SolidColorBrush x:Key="AppText50Brush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="AppText40Brush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="AppDisabledBrush" Color="#61FFFFFF" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="AppFocusBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WhiteTonalBrush" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />

    <!-- The Fluent button template (one content presenter) with v-ripple around the presenter:
         every button and toggle button takes it below, the location rows their own. -->
    <ControlTemplate x:Key="RippleButtonTemplate" TargetType="Button">
      <controls:RippleEffect Fill="{TemplateBinding Foreground}"
                             CornerRadius="{TemplateBinding CornerRadius}"
                             BorderThickness="{TemplateBinding BorderThickness}">
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Foreground="{TemplateBinding Foreground}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          RecognizesAccessKey="True"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </controls:RippleEffect>
    </ControlTemplate>
  </Styles.Resources>

  <!-- Every page's root, inset from the edge: the web UI's 16px sides, whatever the window's size -
       a desktop window and a tablet are given no more than a phone there. 48x27 is the 5% overscan
       inset of a TV at 960x540, and it belongs to a television alone, as the web UI gives it only
       to a tv-device (general.css, "TV page inset and measure"): a window on a desk crops nothing,
       and the inset there only pushes the page's header down the screen. MainView carries the
       class, from the device's own word (AppFeatures.IsTv). -->
  <Style Selector=":is(Panel).page">
    <Setter Property="Margin" Value="16,8,16,16" />
  </Style>
  <Style Selector=":is(UserControl).tv :is(Panel).page">
    <Setter Property="Margin" Value="48,27" />
  </Style>

  <!-- The web UI's type scale (Vuetify's MD2 metrics kept by override.css): Poppins Light for
       text, Poppins Bold for titles, both inherited from MainView. -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnBackgroundBrush}" />
  </Style>
  <Style Selector="TextBlock.body-small">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style Selector="TextBlock.body-medium">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.body-large">
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="TextBlock.label-large">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.h4">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource AppText50Brush}" />
  </Style>
  <Style Selector="TextBlock.muted40">
    <Setter Property="Foreground" Value="{StaticResource AppText40Brush}" />
  </Style>
  <Style Selector="TextBlock.disabled">
    <Setter Property="Foreground" Value="{StaticResource AppDisabledBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
  </Style>
  <!-- an icon: one glyph of the icon font, sized like the web UI's v-icon (default 24) -->
  <Style Selector="TextBlock.mdi">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <!-- the web UI's .flasher: an opacity pulse -->
  <Style Selector="TextBlock.flasher">
    <Style.Animations>
      <Animation Duration="0:0:2" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- The TV pairing page's text (kept from the first cut, on the new palette). -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.address">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource AppText50Brush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.note">
    <Setter Property="Background" Value="{StaticResource NoteBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <!-- the note's own text colour: the client's note is a light card, the connect one dark, and
       the text has to follow. It is written here rather than inherited from the border because
       the TextBlock style above gives every block the page's colour. -->
  <Style Selector="Border.note TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnNoteBrush}" />
  </Style>

  <!-- alert-warning: the same shape in the warning colour, its title a touch heavier (the web UI's
       VAlert with type="warning", whose text colour is the theme's on-warning) -->
  <Style Selector="Border.alert-warning">
    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.alert-warning TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnWarningBrush}" />
  </Style>
  <Style Selector="Border.alert-warning TextBlock.alert-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Buttons: the web UI's v-btn, which neither uppercases nor fills, with its ripple; each class
       below is one of its shapes. The transparent 3px border keeps the size from jumping when the
       ring lights. The ring is the border's, so Fluent's focus adorner (a rectangle in the top
       level's adorner layer, which neither rounds nor fades with its page) is dropped. -->
  <Style Selector="Button">
    <Setter Property="Template" Value="{StaticResource RippleButtonTemplate}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource OnBackgroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- #connectBtn: a 180x40 pill, cream on the way in, purple once connected, 0.4s between. -->
  <Style Selector="Button.connect-btn">
    <Setter Property="Background" Value="{StaticResource ConnectBtnBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnConnectBtnDisconnectedBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="MinWidth" Value="180" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.4" />
        <BrushTransition Property="Foreground" Duration="0:0:0.4" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.connect-btn.connected">
    <Setter Property="Background" Value="{StaticResource ConnectBtnConnectedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnConnectBtnConnectedBrush}" />
  </Style>
  <!-- a filled button's ripple: Vuetify doubles the overlay on a light background (its
       overlay multiplier for cream and for the connected purple, both light by its measure) -->
  <Style Selector="Button.connect-btn /template/ controls|RippleEffect, Button.action /template/ controls|RippleEffect">
    <Setter Property="RippleOpacity" Value="0.5" />
  </Style>

  <!-- .config-item, the home's rows: icon, uppercase title, chevron, value, and a flag or a chip at
       the end. -->
  <Style Selector="Button.config-item">
    <Setter Property="Background" Value="{StaticResource HomeConfigBtnBgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnConfigBtnBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HomeConfigBtnBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.config-item:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.config-item TextBlock.config-title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource OnConfigBtnBgBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.config-item TextBlock.config-chevron">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource OnConfigBtnBgBrush}" />
    <Setter Property="Margin" Value="2,0,6,0" />
  </Style>
  <Style Selector="Button.config-item TextBlock.config-icon">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource OnConfigBtnBgBrush}" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="Button.config-item TextBlock.config-value">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource AppText50Brush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- a page header's back button: 43x43, an 18px radius and a faint border -->
  <Style Selector="Button.back-btn">
    <Setter Property="Width" Value="43" />
    <Setter Property="Height" Value="43" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#2EFFFFFF" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.back-btn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- the pairing page's Done -->
  <Style Selector="Button.action">
    <Setter Property="Background" Value="{StaticResource ConnectBtnBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnConnectBtnDisconnectedBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="28,8" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>

  <!-- The version at the end of the home header (HomePageHeader.vue): 40% white text while there
       is nothing to debug, a filled cream chip once a debug field is set. -->
  <Style Selector="Button.version-chip">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource AppText40Brush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.version-chip.debug">
    <Setter Property="Background" Value="{StaticResource VersionOnHomeDebugBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnVersionOnHomeDebugBrush}" />
    <Setter Property="Padding" Value="8,1" />
  </Style>

  <!-- The developer page: a row per debug command, checked when DebugData1 names it, and the one
       free field. Both are that page's alone, but they are shapes like any other here. -->
  <Style Selector="Button.combo-field">
    <Setter Property="Background" Value="{StaticResource HomeConfigBtnBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.combo-field:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <!-- A flyout is a top level of its own, so it takes neither the page's font nor its
       background: both are set here. -->
  <Style Selector="FlyoutPresenter.commands">
    <Setter Property="FontFamily" Value="fonts:VpnHood#Poppins" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="Background" Value="{StaticResource ConfigCardBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="320" />
  </Style>
  <Style Selector="ToggleButton.debug-item">
    <Setter Property="Template" Value="{StaticResource RippleButtonTemplate}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{StaticResource OnBackgroundBrush}" />
  </Style>
  <Style Selector="ToggleButton.debug-item:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource OnBackgroundBrush}" />
  </Style>
  <Style Selector="ToggleButton.debug-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource OnBackgroundBrush}" />
  </Style>
  <Style Selector="ToggleButton.debug-item:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ToggleButton.debug-item TextBlock.check">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ToggleButton.debug-item:checked TextBlock.check">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- A text field keeps the page's own dark fill in every state: Fluent's focused field is black,
       which belongs to neither product. The ring says which field has the keys. -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource HomeConfigBtnBgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource HomeConfigBtnBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource HomeConfigBtnBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Chips: v-chip x-small flat (Active) and small tonal (Auto). -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip-active">
    <Setter Property="Background" Value="{StaticResource ActiveServerChipBrush}" />
  </Style>
  <Style Selector="Border.chip-active TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnActiveServerChipBrush}" />
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="Border.chip-auto">
    <Setter Property="Background" Value="#1FFFFFFF" />
  </Style>
  <Style Selector="Border.chip-auto TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AppText50Brush}" />
  </Style>

  <!-- a flag: the web UI's 23x15 with 3px corners on the home row, 24x16 with 2px in the list -->
  <Style Selector="Border.flag">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.flag.small">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="Border.flag Image">
    <Setter Property="Stretch" Value="UniformToFill" />
  </Style>

  <!-- config-card, the servers page's card; nested is a card inside a server's card -->
  <Style Selector="Border.config-card">
    <Setter Property="Background" Value="{StaticResource ConfigCardBgBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="0,4" />
  </Style>
  <Style Selector="Border.config-card.nested">
    <Setter Property="Background" Value="{StaticResource ExpansionPanelsCollapsedBrush}" />
  </Style>

  <!-- A server's row in the client's list (ExpansionPanel.vue's title row): the mark, the name and
       the +/- that opens it. The whole row is the button, as the panel's title is there. -->
  <Style Selector="Button.profile-header">
    <Setter Property="Template" Value="{StaticResource RippleButtonTemplate}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.profile-header:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
  </Style>
  <Style Selector="TextBlock.profile-name">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.profile-name.inactive">
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- Add server (btn-style-2, tonal): the product's second colour on a wash of itself -->
  <Style Selector="Button.tonal">
    <Setter Property="Background" Value="{StaticResource BtnStyle2TonalBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BtnStyle2Brush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.tonal:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
  </Style>

  <!-- a location group's header: v-list-group's activator, the title with a rule and a chevron -->
  <Style Selector="ToggleButton.group-header">
    <Setter Property="Template" Value="{StaticResource RippleButtonTemplate}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{StaticResource AppDisabledBrush}" />
  </Style>
  <Style Selector="ToggleButton.group-header:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource AppDisabledBrush}" />
  </Style>
  <Style Selector="ToggleButton.group-header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource AppDisabledBrush}" />
  </Style>
  <Style Selector="ToggleButton.group-header:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ToggleButton.group-header TextBlock.chevron">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.group-header:checked TextBlock.chevron">
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
  </Style>

  <!-- The location list: v-list-item rows separated by a rule, each with its ripple; the active one
       in the active colour; the focused one wears the ring. The Fluent selection colours and its
       selection pipe are not wanted, so the rows take their own template. -->
  <Style Selector="ListBox.locations">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.locations ListBoxItem">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource OnBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <controls:RippleEffect Fill="{TemplateBinding Foreground}"
                               CornerRadius="{TemplateBinding CornerRadius}"
                               BorderThickness="{TemplateBinding BorderThickness}">
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </controls:RippleEffect>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.locations ListBoxItem:nth-last-child(1)">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.locations ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.locations ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.locations ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="ListBox.locations ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ListBox.locations TextBlock.location-name">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="ListBox.locations TextBlock.location-name.nested">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ListBox.locations TextBlock.location-name.active">
    <Setter Property="Foreground" Value="{StaticResource ActiveServerBrush}" />
  </Style>
  <!-- the fastest choice's bolt: the fastest-server colour, white on the active row -->
  <Style Selector="ListBox.locations TextBlock.bolt">
    <Setter Property="Foreground" Value="{StaticResource FastestServerBrush}" />
  </Style>
  <Style Selector="ListBox.locations TextBlock.bolt.active">
    <Setter Property="Foreground" Value="{StaticResource OnBackgroundBrush}" />
  </Style>

  <!-- ======================================================================================
       The rest of the web UI's shapes, for the pages ported after the home: its button styles
       (theme/defaults.ts: BtnStyle1..7, TonalIconBtn), its chips and alerts, its cards, the
       switch, the radio and check rows, the drawer, the dialogs and the snackbar.
       ====================================================================================== -->

  <!-- v-btn shapes. A pill unless said otherwise; "block" stretches; "small" is Vuetify's small. -->
  <Style Selector="Button.pill">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="16,4" />
  </Style>
  <Style Selector="Button.block">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="12,2" />
  </Style>
  <Style Selector="Button.bold">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <!-- BtnStyle1: flat, btn-style-1 -->
  <Style Selector="Button.btn1">
    <Setter Property="Background" Value="{StaticResource BtnStyle1Brush}" />
    <Setter Property="Foreground" Value="{StaticResource OnBtnStyle1Brush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <!-- BtnStyle2: flat, btn-style-2 -->
  <Style Selector="Button.btn2">
    <Setter Property="Background" Value="{StaticResource BtnStyle2Brush}" />
    <Setter Property="Foreground" Value="{StaticResource OnBtnStyle2Brush}" />
  </Style>
  <!-- BtnStyle3: flat, btn-style-3 -->
  <Style Selector="Button.btn3">
    <Setter Property="Background" Value="{StaticResource BtnStyle3Brush}" />
    <Setter Property="Foreground" Value="{StaticResource OnBtnStyle3Brush}" />
  </Style>
  <!-- BtnStyle4: tonal, btn-style-4, block, the content spread -->
  <Style Selector="Button.btn4">
    <Setter Property="Background" Value="{StaticResource BtnStyle4TonalBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BtnStyle4Brush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <!-- BtnStyle5: tonal, btn-style-5 (gray), comfortable -->
  <Style Selector="Button.btn5">
    <Setter Property="Background" Value="{StaticResource BtnStyle5TonalBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BtnStyle5Brush}" />
  </Style>
  <!-- BtnStyle6: flat, btn-style-6 -->
  <Style Selector="Button.btn6">
    <Setter Property="Background" Value="{StaticResource BtnStyle6Brush}" />
    <Setter Property="Foreground" Value="{StaticResource OnBtnStyle6Brush}" />
  </Style>
  <!-- variant="text" in the highlight colour: a link-like button -->
  <Style Selector="Button.text-highlight">
    <Setter Property="Foreground" Value="{StaticResource HighlightBrush}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <!-- variant="tonal" in the highlight colour -->
  <Style Selector="Button.tonal-highlight">
    <Setter Property="Background" Value="{StaticResource HighlightTonalBrush}" />
    <Setter Property="Foreground" Value="{StaticResource HighlightBrush}" />
  </Style>
  <Style Selector="Button.tonal-error">
    <Setter Property="Background" Value="{StaticResource ErrorTonalBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
  </Style>
  <Style Selector="Button.flat-error">
    <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
  </Style>
  <Style Selector="Button.text-error">
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
  </Style>
  <Style Selector="Button.tonal-white">
    <Setter Property="Background" Value="{StaticResource WhiteTonalBrush}" />
    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
  </Style>
  <Style Selector="Button.tonal-active">
    <Setter Property="Background" Value="{StaticResource ActiveTonalBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ActiveBrush}" />
  </Style>
  <Style Selector="Button.outlined">
    <Setter Property="BorderBrush" Value="{StaticResource AppText50Brush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.outlined:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <!-- TonalIconBtn: a 40px round tonal button holding one glyph -->
  <Style Selector="Button.tonal-icon">
    <Setter Property="Background" Value="{StaticResource TonalIconBtnTonalBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TonalIconBtnBrush}" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- an icon-only text button, round -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- A row of a list (v-list-item): a button the width of its list, a rule under it, its ripple.
       A card row (SettingsItem, ConfigCard with a click) is the same shape with the card's radius. -->
  <Style Selector="Button.list-item">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
  </Style>
  <Style Selector="Button.list-item:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="Button.list-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="Button.list-item.last">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.card-row">
    <Setter Property="Background" Value="{StaticResource ConfigCardBgBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.card-row:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
  </Style>
  <Style Selector="Button.card-row:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <!-- a row on the gradient sheets (card-on-grad-bg at 30%) -->
  <Style Selector="Button.card-on-grad">
    <Setter Property="Background" Value="{StaticResource CardOnGradBgAlphaBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.card-on-grad:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
  </Style>
  <Style Selector="Border.card-on-grad">
    <Setter Property="Background" Value="{StaticResource CardOnGradBgAlphaBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- ConfigCard's parts: a bold title row, a dim subtitle, dim body text -->
  <Style Selector="TextBlock.card-title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.card-subtitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{StaticResource AppDisabledBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.highlight">
    <Setter Property="Foreground" Value="{StaticResource HighlightBrush}" />
  </Style>
  <Style Selector="TextBlock.active">
    <Setter Property="Foreground" Value="{StaticResource ActiveBrush}" />
  </Style>
  <Style Selector="TextBlock.error-text">
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.learn-more">
    <Setter Property="Foreground" Value="{StaticResource LearnMoreBrush}" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource AppDisabledBrush}" />
  </Style>
  <!-- a rule (v-divider) -->
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource AppBorderBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.divider.vertical">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="Width" Value="1" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <!-- Chips, tonal by default: the colour as text on a wash of itself (v-chip variant="tonal"),
       density comfortable. A flat chip fills. -->
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip.status-on">
    <Setter Property="Background" Value="{StaticResource EnablePremiumTonalBrush}" />
  </Style>
  <Style Selector="Border.chip.status-on TextBlock">
    <Setter Property="Foreground" Value="{StaticResource EnablePremiumBrush}" />
  </Style>
  <Style Selector="Border.chip.status-off">
    <Setter Property="Background" Value="{StaticResource WhiteTonalBrush}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="Border.chip.status-off TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AppText50Brush}" />
  </Style>
  <Style Selector="Border.chip.warning">
    <Setter Property="Background" Value="{StaticResource WarningTonalBrush}" />
  </Style>
  <Style Selector="Border.chip.warning TextBlock">
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
  </Style>
  <Style Selector="Border.chip.switch">
    <Setter Property="Background" Value="{StaticResource SwitchBtnTonalBrush}" />
  </Style>
  <Style Selector="Border.chip.switch TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SwitchBtnBrush}" />
  </Style>
  <Style Selector="Border.chip.highlight">
    <Setter Property="Background" Value="{StaticResource HighlightTonalBrush}" />
  </Style>
  <Style Selector="Border.chip.highlight TextBlock">
    <Setter Property="Foreground" Value="{StaticResource HighlightBrush}" />
  </Style>
  <Style Selector="Border.chip.white">
    <Setter Property="Background" Value="{StaticResource WhiteTonalBrush}" />
  </Style>
  <Style Selector="Border.chip.white TextBlock">
    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
  </Style>
  <Style Selector="Border.chip.error">
    <Setter Property="Background" Value="{StaticResource ErrorTonalBrush}" />
  </Style>
  <Style Selector="Border.chip.error TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
  </Style>
  <Style Selector="Border.chip.active">
    <Setter Property="Background" Value="{StaticResource ActiveTonalBrush}" />
  </Style>
  <Style Selector="Border.chip.active TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ActiveBrush}" />
  </Style>
  <Style Selector="Border.chip.on-note">
    <Setter Property="Background" Value="{StaticResource OnNoteTonalBrush}" />
  </Style>
  <Style Selector="Border.chip.on-note TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnNoteBrush}" />
  </Style>
  <Style Selector="Border.chip.flat-btn2">
    <Setter Property="Background" Value="{StaticResource BtnStyle2Brush}" />
  </Style>
  <Style Selector="Border.chip.flat-btn2 TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnBtnStyle2Brush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.chip.flat-premium">
    <Setter Property="Background" Value="{StaticResource PromotePremiumColorPremiumBrush}" />
  </Style>
  <Style Selector="Border.chip.flat-premium TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnPromotePremiumColorPremiumBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.chip.flat-enable-premium">
    <Setter Property="Background" Value="{StaticResource EnablePremiumBrush}" />
  </Style>
  <Style Selector="Border.chip.flat-enable-premium TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnActiveBrush}" />
  </Style>
  <!-- the sample chips of the split pages: a square-ish code chip -->
  <Style Selector="Border.chip.sample">
    <Setter Property="Background" Value="{StaticResource SampleIpFilterBgBrush}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#40FFFFFF" />
    <Setter Property="Padding" Value="4,0" />
  </Style>
  <Style Selector="Border.chip.sample TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SampleIpFilterTextBrush}" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.chip.comfortable">
    <Setter Property="Padding" Value="10,3" />
  </Style>

  <!-- alert-info and alert-note, the shapes of alert-warning in their own colours -->
  <Style Selector="Border.alert-info">
    <Setter Property="Background" Value="{StaticResource InfoBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.alert-info TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnInfoBrush}" />
  </Style>
  <Style Selector="Border.alert-info TextBlock.alert-title, Border.note TextBlock.alert-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- an inline action in an alert (the reconnect and turn-on links): the alert's own colour,
       underlined and bold -->
  <Style Selector="Border.alert-warning Button.alert-link">
    <Setter Property="Foreground" Value="{StaticResource OnWarningBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Border.alert-warning Button.alert-link:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource OnWarningBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.alert-warning Button.alert-link TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <!-- A switch (v-switch, colour switch-btn). Never focused itself: the row it sits in is the
       thing a remote lands on (the web UI's data-tv-row), and the row's press flips it. -->
  <Style Selector="ToggleSwitch">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="OnContent" Value="{x:Null}" />
    <Setter Property="OffContent" Value="{x:Null}" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{StaticResource SwitchBtnBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SwitchBtnBrush}" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnobOn">
    <Setter Property="Fill" Value="{StaticResource WhiteBrush}" />
  </Style>
  <Style Selector="ToggleSwitch:unchecked /template/ Border#OuterBorder">
    <Setter Property="BorderBrush" Value="{StaticResource AppText50Brush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleSwitch:unchecked /template/ Ellipse#SwitchKnobOff">
    <Setter Property="Fill" Value="{StaticResource AppText50Brush}" />
  </Style>
  <Style Selector="ToggleSwitch:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- The web UI's radio and check rows: a title over a description, the mark at the start, the
       whole row the target. A Button carrying a glyph, so the ring and the ripple are the row's. -->
  <Style Selector="Button.option-row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.option-row:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
  </Style>
  <Style Selector="Button.option-row TextBlock.mark">
    <Setter Property="Foreground" Value="{StaticResource AppDisabledBrush}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.option-row.checked TextBlock.mark">
    <Setter Property="Foreground" Value="{StaticResource HighlightBrush}" />
  </Style>
  <Style Selector="Button.option-row TextBlock.option-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Button.option-row TextBlock.option-desc">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource AppDisabledBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- a text field with the outlined look of the settings pages (v-text-field variant="outlined") -->
  <Style Selector="TextBox.outlined">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource AppText50Brush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="TextBox.outlined:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.outlined:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource HighlightBrush}" />
  </Style>
  <Style Selector="TextBox.multiline">
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MinHeight" Value="120" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="TextBox:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- The drawer (NavigationDrawer.vue), off the TV UI: a panel from the start edge, its header
       in the darker tone, its rows -->
  <Style Selector="Border.drawer">
    <Setter Property="Background" Value="{StaticResource NavigationDrawerBrush}" />
    <Setter Property="CornerRadius" Value="0,24,24,0" />
    <Setter Property="Width" Value="300" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.drawer-header">
    <Setter Property="Background" Value="{StaticResource NavigationDrawerHeaderBrush}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="CornerRadius" Value="0,24,0,0" />
  </Style>
  <Style Selector="TextBlock.drawer-version">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource NavigationDrawerVersionBrush}" />
  </Style>
  <Style Selector="Button.drawer-item">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.drawer-item.minor">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Button.drawer-item:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="Button.drawer-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>

  <!-- Dialogs (v-dialog, VCard rounded xl): the general dialog's card, the alert card, and the
       text buttons of their actions -->
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{StaticResource GeneralDialogBrush}" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="20,16" />
    <Setter Property="MaxWidth" Value="500" />
    <Setter Property="MinWidth" Value="300" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.dialog TextBlock.dialog-title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.dialog TextBlock.dialog-text">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource GeneralDialogTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.dialog.alert">
    <Setter Property="Background" Value="{StaticResource DialogAlertBrush}" />
  </Style>
  <Style Selector="Border.dialog.alert TextBlock.dialog-title">
    <Setter Property="Foreground" Value="{StaticResource OnDialogAlertBrush}" />
  </Style>
  <Style Selector="Border.dialog.alert TextBlock.dialog-text">
    <Setter Property="Foreground" Value="{StaticResource DialogAlertTextBrush}" />
  </Style>
  <Style Selector="Border.dialog.alert TextBlock">
    <Setter Property="Foreground" Value="{StaticResource DialogAlertTextBrush}" />
  </Style>
  <Style Selector="Border.dialog.alert Button.dialog-btn">
    <Setter Property="Foreground" Value="{StaticResource OnDialogAlertBrush}" />
  </Style>
  <Style Selector="Border.dialog.alert Button.dialog-action">
    <Setter Property="Background" Value="{StaticResource DialogAlertBtnTonalBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DialogAlertBtnBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.dialog.alert Button.dialog-action.flat">
    <Setter Property="Background" Value="{StaticResource DialogAlertBtnBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DialogAlertBrush}" />
  </Style>
  <Style Selector="Border.dialog.active">
    <Setter Property="Background" Value="{StaticResource ActiveBrush}" />
  </Style>
  <Style Selector="Border.dialog.active TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnActiveBrush}" />
  </Style>
  <Style Selector="Border.dialog.active Button.dialog-btn">
    <Setter Property="Foreground" Value="{StaticResource OnActiveBrush}" />
  </Style>
  <Style Selector="Button.dialog-btn">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="Foreground" Value="{StaticResource OnGeneralDialogBrush}" />
  </Style>
  <Style Selector="Button.dialog-btn.plain">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <!-- the rows of a dialog's list (the badge dialog): a rule between them in the dialog's tone -->
  <Style Selector="Border.dialog Button.list-item">
    <Setter Property="BorderBrush" Value="#1AFFFFFF" />
    <Setter Property="Padding" Value="8,10" />
  </Style>

  <!-- The snackbar (GeneralSnackbar.vue): a pill at the top, in the colour the caller named -->
  <Style Selector="Border.snackbar">
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="MaxWidth" Value="570" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="16,20" />
    <Setter Property="Background" Value="{StaticResource HighlightBrush}" />
  </Style>
  <Style Selector="Border.snackbar.active">
    <Setter Property="Background" Value="{StaticResource ActiveBrush}" />
  </Style>
  <Style Selector="Border.snackbar.active TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnActiveBrush}" />
  </Style>
  <Style Selector="Border.snackbar.warning">
    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
  </Style>
  <Style Selector="Border.snackbar.warning TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnWarningBrush}" />
  </Style>
  <Style Selector="Border.snackbar.suppress">
    <Setter Property="Background" Value="{StaticResource SuppressSnackbarBrush}" />
  </Style>
  <Style Selector="Border.snackbar.suppress TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnSuppressSnackbarBrush}" />
  </Style>
  <Style Selector="Border.snackbar TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.snackbar Button">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.snackbar Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- the update snackbar's two tones -->
  <Style Selector="Border.snackbar.update-alert">
    <Setter Property="Background" Value="{StaticResource UpdateSnackbarAlertBrush}" />
  </Style>
  <Style Selector="Border.snackbar.update-warning">
    <Setter Property="Background" Value="{StaticResource UpdateSnackbarWarningBrush}" />
  </Style>
  <Style Selector="Border.snackbar.update-alert TextBlock, Border.snackbar.update-warning TextBlock">
    <Setter Property="Foreground" Value="{StaticResource BtnOnUpdateSnackbarBrush}" />
  </Style>
  <Style Selector="Border.snackbar Button.update-btn">
    <Setter Property="Background" Value="{StaticResource BtnOnUpdateSnackbarBrush}" />
    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Border.snackbar Button.update-btn.tonal">
    <Setter Property="Background" Value="{StaticResource BtnOnUpdateSnackbarTonalBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BtnOnUpdateSnackbarBrush}" />
  </Style>

  <!-- the feature pages (FeaturePageLayout.vue): the gradient sheet, the image, the numbered steps -->
  <Style Selector="Border.grad-sheet">
    <Setter Property="Background" Value="{StaticResource PrimaryBgGradBrush}" />
  </Style>
  <Style Selector="TextBlock.step-number">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource AppDisabledBrush}" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="TextBlock.step">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource AppText50Brush}" />
  </Style>

  <!-- a spinner: one glyph turning (v-progress-circular indeterminate) -->
  <Style Selector="TextBlock.spinner">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource SwitchBtnBrush}" />
    <Setter Property="Background" Value="#1AFFFFFF" />
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <!-- the premium crown beside a title: the enable/disable premium colour -->
  <Style Selector="TextBlock.crown">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource DisablePremiumBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.crown.enabled">
    <Setter Property="Foreground" Value="{StaticResource EnablePremiumBrush}" />
  </Style>
  <!-- GoPremiumButton's three shapes: the countdown chip in the three tones of the time left, the
       premium mark, and the outlined pitch with the crown in a filled round -->
  <Style Selector="Border.chip.countdown">
    <Setter Property="Background" Value="{StaticResource CountDownNormalTonalBrush}" />
    <Setter Property="Padding" Value="8,3,3,3" />
  </Style>
  <Style Selector="Border.chip.countdown TextBlock">
    <Setter Property="Foreground" Value="{StaticResource CountDownNormalBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Border.chip.countdown Button.countdown-extend">
    <Setter Property="Background" Value="{StaticResource CountDownNormalBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnActiveBrush}" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,0,4,0" />
  </Style>
  <Style Selector="Border.chip.countdown Button.countdown-extend TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnActiveBrush}" />
  </Style>
  <Style Selector="Border.chip.countdown.alert">
    <Setter Property="Background" Value="{StaticResource CountDownAlertTonalBrush}" />
  </Style>
  <Style Selector="Border.chip.countdown.alert TextBlock">
    <Setter Property="Foreground" Value="{StaticResource CountDownAlertBrush}" />
  </Style>
  <Style Selector="Border.chip.countdown.alert Button.countdown-extend">
    <Setter Property="Background" Value="{StaticResource CountDownAlertBrush}" />
  </Style>
  <Style Selector="Border.chip.countdown.warning-time">
    <Setter Property="Background" Value="{StaticResource CountDownWarningTonalBrush}" />
  </Style>
  <Style Selector="Border.chip.countdown.warning-time TextBlock">
    <Setter Property="Foreground" Value="{StaticResource CountDownWarningBrush}" />
  </Style>
  <Style Selector="Border.chip.countdown.warning-time Button.countdown-extend">
    <Setter Property="Background" Value="{StaticResource CountDownWarningBrush}" />
  </Style>
  <Style Selector="Button.status-on-btn">
    <Setter Property="Background" Value="{StaticResource EnablePremiumTonalBrush}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,2" />
  </Style>
  <Style Selector="Button.go-premium">
    <Setter Property="BorderBrush" Value="{StaticResource GoPremiumBtnBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource GoPremiumBtnBrush}" />
    <Setter Property="Height" Value="35" />
    <Setter Property="MinHeight" Value="35" />
    <Setter Property="Padding" Value="4,0,12,0" />
  </Style>
  <Style Selector="Button.go-premium TextBlock.body-small">
    <Setter Property="Foreground" Value="{StaticResource GoPremiumBtnBrush}" />
  </Style>
  <Style Selector="Button.go-premium:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <!-- the top-right badges of the home (HomeBadge.vue): small, white at 60% -->
  <Style Selector="Button.badge">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <!-- a flag in the round, for the collapsed server card -->
  <Style Selector="Border.flag-round">
    <Setter Property="Width" Value="25" />
    <Setter Property="Height" Value="25" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <Style Selector="Border.flag-round Image">
    <Setter Property="Stretch" Value="UniformToFill" />
  </Style>
  <!-- a filter list's flags: a small rectangle where an app's icon is a round avatar -->
  <Style Selector="ItemsControl.flags Border.icon-box">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <!-- the reconnect-required bar: a warning strip under the page header -->
  <Style Selector="Border.reconnect-bar">
    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="Border.reconnect-bar TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnWarningBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- the plan rows of the purchase page -->
  <Style Selector="Button.plan">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#40FFFFFF" />
  </Style>
  <Style Selector="Button.plan.selected">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{StaticResource WhiteBrush}" />
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="Button.plan:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
  </Style>
  <!-- a menu (v-menu) -->
  <Style Selector="FlyoutPresenter.menu">
    <Setter Property="FontFamily" Value="fonts:VpnHood#Poppins" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="Background" Value="{StaticResource ConfigCardBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="240" />
  </Style>
  <Style Selector="FlyoutPresenter.menu Button.menu-item">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="FlyoutPresenter.menu Button.menu-item:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
  </Style>
  <Style Selector="FlyoutPresenter.menu Button.menu-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <!-- the closed server's row of flags (ExpansionPanelCollapsed.vue), a press opening the server -->
  <Style Selector="Button.collapsed-row">
    <Setter Property="Background" Value="{StaticResource ExpansionPanelsCollapsedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="8,12" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.collapsed-row:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AppFocusBrush}" />
  </Style>
</Styles>
