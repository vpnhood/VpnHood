<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppLib.Assets"
             xmlns:controls="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Controls"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.SplitListView">
  <!-- The shape the web UI's split-domains, split-ips-via-app and split-ips-via-device share: the
       alert while splitting is off, the split's own switch, the lists, and Revert once a save
       failed. Saved on the way out; a save that fails holds the page. -->
  <DockPanel Classes="page">
    <controls:PageHeader x:Name="Header" DockPanel.Dock="Top" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="720">
        <controls:SplitDisabledAlert x:Name="DisabledAlert" TurnedOn="OnTurnedOn" />
        <controls:SettingsToggleItem x:Name="EnabledItem" Toggled="OnToggled" />
        <controls:SplitListInput x:Name="Input" Changed="OnInputChanged" />
        <Button x:Name="RevertButton" Classes="btn3 block" Margin="0,16,0,0" IsVisible="False" Click="OnRevertClick"
                Content="{Binding Revert, Source={x:Static res:Strings.Current}}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
