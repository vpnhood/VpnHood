<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>VpnHood.AppLib.AvaloniaUI.Desktop</RootNamespace>
		<IsPackable>false</IsPackable>
		<Description>Runs the VpnHood Avalonia UI in a desktop window on Windows and Linux</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VpnHood.AppLib.AvaloniaUI\VpnHood.AppLib.AvaloniaUI.csproj" />
		<!-- The web server extracts the bundle whose assets folder the UI draws from. -->
		<ProjectReference Include="..\VpnHood.AppLib.Api.WebHost\VpnHood.AppLib.Api.WebHost.csproj" />
	</ItemGroup>
</Project>
