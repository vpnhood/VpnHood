<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>VpnHood Android Ad Library for AdMob</Description>
		<TargetFramework>net11.0-android37.0</TargetFramework>
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
		<BaseIntermediateOutputPath />
	</PropertyGroup>

	<ItemGroup>
	  <ProjectReference Include="..\VpnHood.AppLib.Abstractions\VpnHood.AppLib.Abstractions.csproj" />
	  <ProjectReference Include="..\..\Core\VpnHood.Core.Client.Devices.Android\VpnHood.Core.Client.Devices.Android.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <!-- Held at 125.4: 125.5 needs AndroidX AppCompat 1.8, which Avalonia.Android (12.1.6) pins
	       below, at 1.7.1, so a head with both does not restore (NU1107). -->
	  <PackageReference Include="Xamarin.GooglePlayServices.Ads" Version="125.4.0.2" />
	  <!-- Ads brings WorkManager and its Tracing.Ktx 1.3, which allows only Tracing 1.3 beside it, while
	       Play Services' Fragment takes Tracing to 2.0 (NU1608). -->
	  <PackageReference Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" Version="2.0.0" />
	</ItemGroup>
</Project>