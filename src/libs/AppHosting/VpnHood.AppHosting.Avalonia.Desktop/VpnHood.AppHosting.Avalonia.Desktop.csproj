<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<VhApiDocsComplete>true</VhApiDocsComplete>
		<Description>Runs the VpnHood Avalonia UI in a desktop window on Windows and Linux</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- The UI itself, over the app's API alone: the engine (VpnHood.AppLogic.App) is the service's, and
		     the window's look is the UI's. -->
		<ProjectReference Include="..\VpnHood.AppHosting.Avalonia\VpnHood.AppHosting.Avalonia.csproj" />
		<!-- The window as the app's UI context (AvaloniaUiContext), which a store's sign-in and purchase ask for. -->
		<ProjectReference Include="..\..\AppLogic\VpnHood.AppLogic.Abstractions\VpnHood.AppLogic.Abstractions.csproj" />
		<!-- IDesktopUi, which a desktop head names this UI as. -->
		<ProjectReference Include="..\VpnHood.AppHosting.Desktop.Abstractions\VpnHood.AppHosting.Desktop.Abstractions.csproj" />
		<!-- The web server extracts the bundle whose assets folder the UI draws from. -->
	</ItemGroup>
</Project>
