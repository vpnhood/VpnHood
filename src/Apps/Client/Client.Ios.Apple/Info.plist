<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
	<!-- CFBundleIdentifier and CFBundleDisplayName are the build's: ApplicationId and ApplicationTitle,
	     from the app's identity (VpnHood.AppLib.App.targets), which this file does not state again. -->
	<!-- false ="no encryption requiring Apple export-compliance documentation" — NOT "no encryption".
	     The app uses only standards-body cryptography (AES-GCM/CTR, RSA, SHA-2, HMAC, TLS — NIST/IETF/
	     ISO), nothing proprietary, no French store: Apple's App Encryption Documentation wizard concludes
	     "no documents needed" for exactly these answers and prescribes this value to skip the per-build
	     compliance questions. NEVER set true — true requires an Apple-issued
	     ITSEncryptionExportComplianceCode in the binary, the non-France flow issues none, and altool then
	     rejects every upload (error 90592). The real export-law duty is the annual BIS self-classification
	     report (5D992.c). See docs/legal/developer/APP_STORE_EXPORT_COMPLIANCE.md. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- CFBundleShortVersionString / CFBundleVersion are injected by the .NET iOS SDK from
	     ApplicationDisplayVersion / ApplicationVersion (set by pub/lib/Publish-IosApp.ps1 from
	     PubVersion.json). Do NOT hardcode them here: a literal value OVERRIDES the MSBuild props and
	     ships every build as 1.0 (1.0), which also collides on the next TestFlight upload. -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- An access key's file opens in the app, whose UI imports the key (IosAvaloniaAppDelegate): .cdy, the
	     extension Android's file managers know, so one file an admin mails opens on every platform. Opened in
	     place, read through its security scope: a copy would be left in Documents/Inbox, which is backed up. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Access key</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.vpnhood.access-key</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.vpnhood.access-key</string>
			<key>UTTypeDescription</key>
			<string>Access key</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cdy</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.cinderella</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- The SPA is served over plain HTTP from an in-process loopback web server; allow it. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Opt out of iPad multitasking so IosSpaWebViewController's orientation mask (portrait lock by
	     default; see AllowRotation) is honored — multitasking-capable iPad apps must support all
	     orientations and ignore the view controller's mask. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
