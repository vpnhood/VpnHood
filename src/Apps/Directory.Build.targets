<Project>

  <!-- MSBuild imports only the NEAREST Directory.Build.targets, so this file shadows the repo's one -
       and with it the Android version code every store build needs. Import that first. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

  <!-- The app's identity - ids, names, constants - for every head of a product that states one
       (src/Apps/<Product>/Directory.Build.props): the same file a package reference of
       VpnHood.AppLib.App imports, since a project reference carries no targets. A project that states
       no identity, as the tools and the server do, is left as it is. -->
  <Import Project="$(MSBuildThisFileDirectory)..\AppLib\VpnHood.AppLib.App\buildTransitive\VpnHood.AppLib.App.targets" />

  <!-- Windows' console launcher beside the window's executable, for the same reason: the Windows
       hosting package's targets, which its project reference does not carry. They act only on a
       WinExe that names a command. -->
  <Import Project="$(MSBuildThisFileDirectory)..\AppUi\VpnHood.AppUi.Hosting.Desktop.Windows\buildTransitive\VpnHood.AppUi.Hosting.Desktop.Windows.targets"
          Condition="$(TargetFramework.Contains('-windows'))" />

  <!-- The app's icon beside a Linux head's binary, AppIcon.png, likewise: the Linux hosting package's
       targets. They act only on an app that names an icon (ApplicationIcon). -->
  <Import Project="$(MSBuildThisFileDirectory)..\AppUi\VpnHood.AppUi.Hosting.Desktop.Linux\buildTransitive\VpnHood.AppUi.Hosting.Desktop.Linux.targets"
          Condition="'$(VhAppPlatform)' == 'linux'" />

</Project>
