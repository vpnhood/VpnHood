<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>VpnHood HTTP/3. A server-side HTTP/3 engine over the VpnHood QUIC abstractions: frames, QPACK without a dynamic table, request validation and the response, with hooks through which an application claims its own streams.</Description>
		<TargetFramework>net11.0</TargetFramework>
		<VhApiDocsComplete>true</VhApiDocsComplete>
	</PropertyGroup>

	<ItemGroup>
		<!-- Tests only: the server uses the public surface, as any application does. -->
		<InternalsVisibleTo Include="VpnHood.Test" />
		<InternalsVisibleTo Include="VpnHood.Test.KestrelParity" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VpnHood.Net.Toolkit\VpnHood.Net.Toolkit.csproj" />
		<ProjectReference Include="..\VpnHood.Net.Quic.Abstractions\VpnHood.Net.Quic.Abstractions.csproj" />
	</ItemGroup>

</Project>
