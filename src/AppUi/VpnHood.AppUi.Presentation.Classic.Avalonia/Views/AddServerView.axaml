<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppUi.Common"
             xmlns:controls="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Controls"
             xmlns:hosting="using:VpnHood.AppUi.Hosting.Avalonia"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.AddServerView">
  <!-- The web UI's AddServerDialog as a page: the key field and what it is for. Shown only where a
       key can be typed - a TV sends the person to their phone instead (LocationsView). Adding
       connects with the new server, as that dialog does. -->
  <DockPanel Classes="page">
    <controls:PageHeader x:Name="Header" DockPanel.Dock="Top"
                         Title="{Binding AddAccessKeyTitle, Source={x:Static res:Strings.Current}}" />

    <StackPanel MaxWidth="720" Spacing="14" VerticalAlignment="Top">
      <controls:ServerKeyPicture Margin="0,10,0,6" />
      <TextBlock Classes="body-small disabled" Text="{Binding AddAccessKeySubtitle, Source={x:Static res:Strings.Current}}" />
      <!-- a key runs to a few hundred characters with no space: it wraps, so all of it is seen to arrive -->
      <TextBox x:Name="KeyBox" AutomationProperties.Name="{Binding AddAccessKeyTitle, Source={x:Static res:Strings.Current}}" PlaceholderText="vh:" AcceptsReturn="False" FlowDirection="LeftToRight"
               TextWrapping="Wrap" Height="100" VerticalContentAlignment="Top"
               hosting:NativeTextInput.IsPreferred="True" />
      <TextBlock x:Name="ErrorText" AutomationProperties.LiveSetting="Assertive" Classes="body-small error" IsVisible="False" TextWrapping="Wrap" />
      <!-- the page's one action: the header's Back is its cancel, as on any page -->
      <Button x:Name="AddButton" Classes="action" HorizontalAlignment="Right" Margin="0,6,0,0"
              Content="{Binding Add, Source={x:Static res:Strings.Current}}" Click="OnAddClick" />
    </StackPanel>
  </DockPanel>
</UserControl>
