<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>false</IsPackable>	<!-- application, not a NuGet package -->
		<Description>VpnHood Linux Connect App</Description>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<UseWindowsForms>False</UseWindowsForms>
		<!-- A plain target framework names no platform, so the head does. -->
		<VhAppPlatform>linux</VhAppPlatform>
		<!-- The binary, its unit and their folders are called by the app's package title
		     (../Directory.Build.props); a Debug build's by the title and "Debug", so it runs beside an
		     installed release (VhAppExecutableName). -->
		<AssemblyName>$(VhAppExecutableName)</AssemblyName>
		<!-- The website hands this build out, and its id says so, leaving the bare one to a store build
		     (Snap, Flatpak). It shipped without the channel, so every install counts once more against
		     its access code's device limit until its old entry expires - accepted by the owner on
		     2026-08-26. -->
		<VhAppIdChannel>web</VhAppIdChannel>
		<!-- The app's icon, beside its identity (../Directory.Build.props), which every desktop head names:
		     the build places its 256 px picture beside the binary as AppIcon.png, for the tray and the
		     menu (VpnHood.AppHosting.Desktop.Linux's targets). -->
		<ApplicationIcon>..\app.ico</ApplicationIcon>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<PublishTrimmed>False</PublishTrimmed>
	</PropertyGroup>

	<PropertyGroup>
		<StartupObject></StartupObject>
	</PropertyGroup>

	<!-- Default access key, embedded as its own resource so it can be sourced from a GitHub secret.
	     Keys are per-entitlement, not per-store: only the ad-supported build (Android Google) embeds
	     access_key_ad; every ad-free build — Linux included — embeds access_key_premium.
	     The configuration-specific file wins (Debug embeds access_key_premium.Debug.txt), otherwise
	     the base access_key_premium.txt is used. Both are optional here: a fork without them has no
	     built-in key (a Debug build takes the engine's sample, ConnectAppOptions), while a real
	     (strict) publish is gated by Assert-DefaultAccessKey in pub/lib/AppPublishConfig.ps1. The
	     product's settings are embedded by the product project (ConnectAppConfigs). -->
	<ItemGroup>
		<EmbeddedResource Include="$(VhUserDir)\$(VhAppPackageTitle)\access_key_premium.$(Configuration).txt" LogicalName="access_key_default.txt" Condition="Exists('$(VhUserDir)\$(VhAppPackageTitle)\access_key_premium.$(Configuration).txt')" />
		<EmbeddedResource Include="$(VhUserDir)\$(VhAppPackageTitle)\access_key_premium.txt" LogicalName="access_key_default.txt" Condition="!Exists('$(VhUserDir)\$(VhAppPackageTitle)\access_key_premium.$(Configuration).txt') And Exists('$(VhUserDir)\$(VhAppPackageTitle)\access_key_premium.txt')" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Connect\VpnHood.App.Connect.csproj" />
		<ProjectReference Include="..\..\..\libs\AppLogic\VpnHood.AppLogic.App.Linux\VpnHood.AppLogic.App.Linux.csproj" />
		<!-- The command line, and the daemon and window it dispatches to: the same on every Linux head. -->
		<ProjectReference Include="..\..\..\libs\AppHosting\VpnHood.AppHosting.Desktop.Linux\VpnHood.AppHosting.Desktop.Linux.csproj" />
		<!-- The VPN host, the VPN service's own process, which the service starts beside this binary: built first
		     and placed beside it, never compiled against (VhAppVpnHost, VpnHood.AppHosting.Desktop.Daemon's targets). -->
		<ProjectReference Include="..\Connect.Linux.VpnHost\VpnHood.App.Connect.Linux.VpnHost.csproj" ReferenceOutputAssembly="false" VhAppVpnHost="true" />
		<!-- The UI this head runs, in its own window. -->
		<ProjectReference Include="..\..\..\libs\AppHosting\VpnHood.AppHosting.Avalonia.Desktop\VpnHood.AppHosting.Avalonia.Desktop.csproj" />
		<!-- The UI itself: the pages, the controls, the themes. -->
		<ProjectReference Include="..\..\..\libs\AppUi\VpnHood.AppUi.Avalonia.Classic\VpnHood.AppUi.Avalonia.Classic.csproj" />
		<ProjectReference Include="..\..\..\libs\AppLogic\VpnHood.AppLogic.Portal\VpnHood.AppLogic.Portal.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="VpnHood.Net.IpLocations.Assets.Ip2LocationLite" Version="9.0.871" />
	</ItemGroup>

	<!-- The assets folder - the images, flags, fonts, documents and words every UI draws from - placed the way
	     this platform reads files: the same targets a package reference of VpnHood.AppUi.Assets.Classic imports. -->
	<Import Project="..\..\..\libs\AppUi\VpnHood.AppUi.Assets.Classic\buildTransitive\VpnHood.AppUi.Assets.Classic.targets" />
	<!-- The page the web host serves - the Avalonia UI's browser build - placed the same way: the same
	     targets a package reference of VpnHood.AppUi.Avalonia.Classic imports; the head
	     reads it at "assets/web-root.zip". -->
	<Import Project="..\..\..\libs\AppUi\VpnHood.AppUi.Avalonia.Classic\buildTransitive\VpnHood.AppUi.Avalonia.Classic.targets" />
</Project>
