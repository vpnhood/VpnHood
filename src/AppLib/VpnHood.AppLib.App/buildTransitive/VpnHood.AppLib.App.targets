<Project>
	<!-- The app's identity, built from the two values the app states once (VhAppIdBase, VhAppName; see
	     VpnHood.AppLib.App.props) after the head is read, so a head names no id and no name. What a
	     head, or a build's command line, states itself is kept: every value here but the version
	     numbers is set only where nothing is yet.

	     The app's id is the base, the platform and, when the id names one, the channel, with .debug
	     after it in a Debug build:

	       com.example.vpn.android              the Play build
	       com.example.vpn.android.web.debug    the website's APK, built in Debug
	       com.example.vpn.windows.web          the website's Windows installer
	       com.example.vpn.ios                  the App Store build, in Debug too: every iOS bundle id
	                                            needs a provisioning profile of its own

	     The platform comes from the target framework; a head on a plain one, as a Linux head is,
	     states it (VhAppPlatform: linux). A head names its channel when its id carries one
	     (VhAppIdChannel: web, for the builds a website hands out; a store's build names none, the
	     store being where its id is registered). The id is ApplicationId on every platform: Android
	     and iOS make their package and bundle of it, and the constants below give it to the code.
	     Stating ApplicationId overrides the rule, as Publish-AndroidApp.ps1 does with publish.json's.

	     An id never changes once it has shipped: the stores key their listings on it, and on Windows
	     and Linux it is part of every install's client id. A head whose shipped id the rule does not
	     give states its own, in the rule's parts. -->
	<PropertyGroup Condition="'$(VhAppIdBase)' != ''">
		<!-- An app, not a library that passes the reference on: .NET for Android rewrites an app's
		     OutputType to Library, and AndroidApplication is what then tells it apart. An iOS app
		     extension is a library with IsAppExtension. -->
		<VhAppIsApp Condition="'$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe' Or '$(AndroidApplication)' == 'true'">true</VhAppIsApp>
		<VhAppIsExtension Condition="'$(IsAppExtension)' == 'true'">true</VhAppIsExtension>
		<VhAppIsDebug Condition="'$(Configuration)' == 'Debug'">true</VhAppIsDebug>
		<!-- From TargetFramework, which is set wherever this file is read; TargetPlatformIdentifier is
		     not yet when a head imports this from its own body. -->
		<VhAppPlatform Condition="'$(VhAppPlatform)' == '' And $(TargetFramework.Contains('-android'))">android</VhAppPlatform>
		<VhAppPlatform Condition="'$(VhAppPlatform)' == '' And $(TargetFramework.Contains('-ios'))">ios</VhAppPlatform>
		<VhAppPlatform Condition="'$(VhAppPlatform)' == '' And $(TargetFramework.Contains('-windows'))">windows</VhAppPlatform>
	</PropertyGroup>

	<!-- The app's ids: its own, and the AdMob application id that a head showing AdMob ads names in its
	     manifest - the identity's (VhAdMobApplicationId), else Google's sample app id, under which only
	     Google's test ad units serve. -->
	<PropertyGroup Condition="'$(VhAppIdBase)' != '' And '$(VhAppIsApp)' == 'true' And '$(VhAppPlatform)' != ''">
		<_VhAppId>$(VhAppIdBase).$(VhAppPlatform)</_VhAppId>
		<_VhAppId Condition="'$(VhAppIdChannel)' != ''">$(_VhAppId).$(VhAppIdChannel)</_VhAppId>
		<_VhAppId Condition="'$(VhAppIsDebug)' == 'true' And '$(VhAppPlatform)' != 'ios'">$(_VhAppId).debug</_VhAppId>
		<ApplicationId Condition="'$(ApplicationId)' == ''">$(_VhAppId)</ApplicationId>
		<VhAdMobApplicationId Condition="'$(VhAdMobApplicationId)' == ''">ca-app-pub-3940256099942544~3347511713</VhAdMobApplicationId>
	</PropertyGroup>

	<!-- The app's version: the Version it states beside its identity, which every assembly of the app
	     carries and a head passes to the app (AppConstants.AppVersion). Android and iOS take two numbers
	     of it: the whole, as the version people see (versionName,
	     CFBundleShortVersionString), and its third number, as the one a store orders the builds by
	     (versionCode, CFBundleVersion: 9.0.856 -> 856). So the third number counts the releases: one
	     more with each and never reset, since a store takes only a higher one. Unlike the values above,
	     these are set whatever they hold: Android's SDK has given the code its default, 1, by now. A
	     build's command line still wins, as it always does. A NuGet smoke publish stamps
	     X.Y.Z.<run>-prerelease, which System.Version cannot parse whole: the suffix goes first. -->
	<PropertyGroup Condition="'$(VhAppIdBase)' != '' And ('$(VhAppIsApp)' == 'true' Or '$(VhAppIsExtension)' == 'true') And ('$(VhAppPlatform)' == 'android' Or '$(VhAppPlatform)' == 'ios')">
		<_VhAppVersionNumbers>$(Version.Split('-')[0])</_VhAppVersionNumbers>
		<ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
		<ApplicationVersion>$([System.Version]::Parse('$(_VhAppVersionNumbers)').Build)</ApplicationVersion>
	</PropertyGroup>

	<!-- Android takes no version code below 1, and its own error names an empty one. -->
	<Target Name="VhCheckAppVersionCode" BeforeTargets="BeforeBuild"
	        Condition="'$(VhAppIdBase)' != '' And '$(VhAppIsApp)' == 'true' And '$(VhAppPlatform)' == 'android'">
		<Error Condition="'$(ApplicationVersion)' == '0'"
		       Text="The app's version code is the third number of its Version, $(Version), and Android takes none below 1: state a Version whose third number is 1 or more, such as 1.0.1." />
	</Target>

	<!-- The command's name (VhAppCommandName), in the app's own assembly, where the desktop host reads
	     it for the names its help and hints print: an attribute rather than a constant, so a head
	     passes the host nothing. -->
	<ItemGroup Condition="'$(VhAppIdBase)' != '' And '$(VhAppIsApp)' == 'true' And '$(VhAppCommandName)' != ''">
		<AssemblyMetadata Include="VhAppCommandName" Value="$(VhAppCommandName)" />
	</ItemGroup>

	<!-- The name this build shows (VhAppDisplayName), a head's and the product library's alike. Debug
	     says so in the name. -->
	<PropertyGroup Condition="'$(VhAppIdBase)' != ''">
		<VhAppDisplayName Condition="'$(VhAppDisplayName)' == '' And '$(VhAppIsDebug)' == 'true'">$(VhAppName) (DEBUG)</VhAppDisplayName>
		<VhAppDisplayName Condition="'$(VhAppDisplayName)' == ''">$(VhAppName)</VhAppDisplayName>
	</PropertyGroup>

	<!-- iOS: the App Group the app and its network extension share, and the extension's id. Both
	     follow the base, since Apple wants an extension's bundle id to start with its app's: an iOS
	     app changes its ids through the base, not through ApplicationId. The group reaches the
	     entitlements here, so a head's Entitlements.plist names only its capabilities. -->
	<PropertyGroup Condition="'$(VhAppIdBase)' != '' And '$(VhAppPlatform)' == 'ios'">
		<VhAppGroupId Condition="'$(VhAppGroupId)' == ''">group.$(VhAppIdBase).ios</VhAppGroupId>
		<VhAppExtensionId Condition="'$(VhAppExtensionId)' == ''">$(VhAppIdBase).ios.networkextension</VhAppExtensionId>
	</PropertyGroup>
	<PropertyGroup Condition="'$(VhAppIdBase)' != '' And '$(VhAppPlatform)' == 'ios' And '$(VhAppIsApp)' == 'true'">
		<ApplicationTitle Condition="'$(ApplicationTitle)' == ''">$(VhAppDisplayName)</ApplicationTitle>
	</PropertyGroup>
	<PropertyGroup Condition="'$(VhAppIdBase)' != '' And '$(VhAppPlatform)' == 'ios' And '$(VhAppIsExtension)' == 'true'">
		<ApplicationId Condition="'$(ApplicationId)' == ''">$(VhAppExtensionId)</ApplicationId>
		<ApplicationTitle Condition="'$(ApplicationTitle)' == ''">$(VhAppName) Extension</ApplicationTitle>
	</PropertyGroup>
	<ItemGroup Condition="'$(VhAppIdBase)' != '' And '$(VhAppPlatform)' == 'ios' And ('$(VhAppIsApp)' == 'true' Or '$(VhAppIsExtension)' == 'true')">
		<CustomEntitlements Include="com.apple.security.application-groups" Type="StringArray" Value="$(VhAppGroupId)" />
	</ItemGroup>

	<!-- The app's icons: four SVGs in the folder the app names beside its identity (VhAppIconsDir),
	     drawn at build time at every size a platform asks for (Microsoft.Maui.Resizetizer, a build-only
	     dependency of VpnHood.AppLib.App.Android and .Ios). Each is named for its role in the app; Link
	     gives what is drawn from it the name its platform and the library ask for.

	       icon_background.svg   the icon's background, full bleed
	       icon_foreground.svg   its logo at full size: Android draws it at 70%, inside what every
	                             launcher's mask shows; iOS, which shows the whole square, whole
	       icon_monochrome.svg   the logo in one colour, which the system paints: Android's notifications,
	                             Quick Settings tile and themed icon (android/mipmap-anydpi-v33)
	       banner.svg            the wide banner, 16:9: Android TV's

	     An iOS extension takes none: the system shows its app's icon. -->
	<PropertyGroup Condition="'$(VhAppIdBase)' != '' And '$(VhAppIconsDir)' != '' And '$(VhAppIsApp)' == 'true'">
		<_VhAppIconsDir>$([MSBuild]::EnsureTrailingSlash('$(VhAppIconsDir)'))</_VhAppIconsDir>
		<AppIcon Condition="'$(AppIcon)' == '' And '$(VhAppPlatform)' == 'ios'">ic_launcher</AppIcon>
	</PropertyGroup>
	<ItemGroup Condition="'$(_VhAppIconsDir)' != '' And '$(VhAppPlatform)' == 'android'">
		<MauiIcon Include="$(_VhAppIconsDir)icon_background.svg" Link="ic_launcher.svg" ForegroundFile="$(_VhAppIconsDir)icon_foreground.svg" ForegroundScale="0.7" />
		<MauiImage Include="$(_VhAppIconsDir)icon_monochrome.svg" Link="notification.svg" BaseSize="24,24" />
		<MauiImage Include="$(_VhAppIconsDir)icon_monochrome.svg" Link="ic_launcher_monochrome.svg" BaseSize="44,44" />
		<MauiImage Include="$(_VhAppIconsDir)banner.svg" Link="ic_banner.svg" BaseSize="160,90" />
		<AndroidResource Include="$(MSBuildThisFileDirectory)android\mipmap-anydpi-v33\ic_launcher.xml" Link="Resources\mipmap-anydpi-v33\ic_launcher.xml" />
	</ItemGroup>
	<ItemGroup Condition="'$(_VhAppIconsDir)' != '' And '$(VhAppPlatform)' == 'ios'">
		<MauiIcon Include="$(_VhAppIconsDir)icon_background.svg" Link="ic_launcher.svg" ForegroundFile="$(_VhAppIconsDir)icon_foreground.svg" ForegroundScale="1" />
	</ItemGroup>

	<!-- The app's launch colour: what iOS's launch screen and Android's cold start show before any of the
	     app's code runs, so the UI comes up on the colour already there. The theme's, never the app's:
	     the window background of the theme the app's settings name - UiTheme in the file the app states
	     as VhAppSettingsFile beside its name, the appsettings.json its product embeds; "blue" where it
	     names none, as the app reads it - from that theme's manifest in the UI's store
	     (themes/<theme>/manifest.json in VhAssetsZip, VpnHood.AppUi.Assets.Classic): the colour the UI's
	     host paints the chrome around it with (ThemeColors). Without the file or the store (a code-only
	     checkout) both screens keep their defaults: white on iOS, the library's on Android. -->
	<UsingTask TaskName="VhReadLaunchColor" TaskFactory="RoslynCodeTaskFactory"
	           AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<SettingsFile ParameterType="System.String" Required="true" />
			<StoreZip ParameterType="System.String" Required="true" />
			<Color ParameterType="System.String" Output="true" />
			<Red ParameterType="System.String" Output="true" />
			<Green ParameterType="System.String" Output="true" />
			<Blue ParameterType="System.String" Output="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.Globalization" />
			<Using Namespace="System.IO.Compression" />
			<Using Namespace="System.Text.RegularExpressions" />
			<Code Type="Fragment" Language="cs"><![CDATA[
var theme = "blue";
var setting = Regex.Match(File.ReadAllText(SettingsFile.Replace('\\', '/')), "\"UiTheme\"\\s*:\\s*\"([^\"]+)\"");
if (setting.Success)
    theme = setting.Groups[1].Value;

var entryName = "themes/" + theme + "/manifest.json";
string manifest = null;
using (var zip = ZipFile.OpenRead(StoreZip.Replace('\\', '/'))) {
    var entry = zip.GetEntry(entryName);
    if (entry != null)
        using (var reader = new StreamReader(entry.Open()))
            manifest = reader.ReadToEnd();
}

if (manifest == null) {
    Log.LogError("The UI's store has no '" + theme + "' theme, which the app's settings name: no " + entryName + " in " + StoreZip + ".");
    return false;
}

var match = Regex.Match(manifest, "\"windowBackground\"\\s*:\\s*\"#([0-9A-Fa-f]{6})\"");
if (!match.Success) {
    Log.LogError("The '" + theme + "' theme's manifest names no window background as #rrggbb: " + entryName + " in " + StoreZip + ".");
    return false;
}

var hex = match.Groups[1].Value.ToLowerInvariant();
Func<int, string> component = start =>
    (Convert.ToInt32(hex.Substring(start, 2), 16) / 255.0).ToString("0.###", CultureInfo.InvariantCulture);
Color = "#" + hex;
Red = component(0);
Green = component(2);
Blue = component(4);
]]></Code>
		</Task>
	</UsingTask>

	<Target Name="VhReadLaunchColor"
	        Condition="'$(VhAppIsApp)' == 'true' And ('$(VhAppPlatform)' == 'ios' Or '$(VhAppPlatform)' == 'android')">
		<Warning Condition="'$(VhAppSettingsFile)' == ''"
		         Text="The app states no settings file, so its launch screen is not in its theme's colour: state VhAppSettingsFile beside VhAppName, the appsettings.json its product embeds." />
		<VhReadLaunchColor Condition="'$(VhAppSettingsFile)' != '' And Exists('$(VhAppSettingsFile)') And '$(VhAssetsZip)' != '' And Exists('$(VhAssetsZip)')"
		                   SettingsFile="$(VhAppSettingsFile)" StoreZip="$(VhAssetsZip)">
			<Output TaskParameter="Color" PropertyName="_VhLaunchColor" />
			<Output TaskParameter="Red" PropertyName="_VhLaunchRed" />
			<Output TaskParameter="Green" PropertyName="_VhLaunchGreen" />
			<Output TaskParameter="Blue" PropertyName="_VhLaunchBlue" />
		</VhReadLaunchColor>
	</Target>

	<!-- iOS: the launch screen every app's Info.plist names (UILaunchStoryboardName, LaunchScreen): one
	     view in that colour, from ios/LaunchScreen.storyboard beside this file. A head with a
	     LaunchScreen.storyboard of its own keeps it. -->
	<Target Name="VhWriteLaunchScreen" BeforeTargets="BeforeBuild" DependsOnTargets="VhReadLaunchColor"
	        Condition="'$(VhAppIsApp)' == 'true' And '$(VhAppPlatform)' == 'ios'">
		<ItemGroup>
			<_VhOwnLaunchScreen Include="@(InterfaceDefinition)" Condition="'%(Filename)%(Extension)' == 'LaunchScreen.storyboard'" />
		</ItemGroup>
		<PropertyGroup Condition="'@(_VhOwnLaunchScreen)' == ''">
			<_VhLaunchRed Condition="'$(_VhLaunchRed)' == ''">1</_VhLaunchRed>
			<_VhLaunchGreen Condition="'$(_VhLaunchGreen)' == ''">1</_VhLaunchGreen>
			<_VhLaunchBlue Condition="'$(_VhLaunchBlue)' == ''">1</_VhLaunchBlue>
			<_VhLaunchScreenFile>$(IntermediateOutputPath)LaunchScreen.storyboard</_VhLaunchScreenFile>
			<_VhLaunchScreenText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)ios/LaunchScreen.storyboard'))</_VhLaunchScreenText>
			<_VhLaunchScreenText>$(_VhLaunchScreenText.Replace('VH_RED', '$(_VhLaunchRed)').Replace('VH_GREEN', '$(_VhLaunchGreen)').Replace('VH_BLUE', '$(_VhLaunchBlue)'))</_VhLaunchScreenText>
		</PropertyGroup>
		<WriteLinesToFile Condition="'$(_VhLaunchScreenFile)' != ''" File="$(_VhLaunchScreenFile)"
		                  Lines="$([MSBuild]::Escape('$(_VhLaunchScreenText)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup Condition="'$(_VhLaunchScreenFile)' != ''">
			<InterfaceDefinition Include="$(_VhLaunchScreenFile)" Link="LaunchScreen.storyboard" />
			<FileWrites Include="$(_VhLaunchScreenFile)" />
		</ItemGroup>
	</Target>

	<!-- Android: the cold start - the activity's window background, which Android 12 and later also put
	     behind the splash screen's icon - in that colour. Theme.VpnHood.Avalonia names
	     @color/vh_launch_background, which this resource of the app's overrides over the library's. -->
	<Target Name="VhWriteLaunchColor" BeforeTargets="BeforeBuild" DependsOnTargets="VhReadLaunchColor"
	        Condition="'$(VhAppIsApp)' == 'true' And '$(VhAppPlatform)' == 'android'">
		<PropertyGroup Condition="'$(_VhLaunchColor)' != ''">
			<_VhLaunchColorFile>$(IntermediateOutputPath)vh_launch_background.xml</_VhLaunchColorFile>
			<_VhLaunchColorXml>&lt;?xml version="1.0" encoding="utf-8"?&gt;
&lt;resources&gt;
  &lt;color name="vh_launch_background"&gt;$(_VhLaunchColor)&lt;/color&gt;
&lt;/resources&gt;</_VhLaunchColorXml>
		</PropertyGroup>
		<WriteLinesToFile Condition="'$(_VhLaunchColorFile)' != ''" File="$(_VhLaunchColorFile)"
		                  Lines="$([MSBuild]::Escape('$(_VhLaunchColorXml)'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup Condition="'$(_VhLaunchColorFile)' != ''">
			<AndroidResource Include="$(_VhLaunchColorFile)" Link="Resources\values\vh_launch_background.xml" />
			<FileWrites Include="$(_VhLaunchColorFile)" />
		</ItemGroup>
	</Target>

	<!-- What the code reads: AppConstants.AppId and AdMobApplicationId, AppName, AppVersion, CompanyName,
	     PackageTitle and IsDebugMode, and on iOS AppGroupId and ProviderBundleId. The product library - a project of
	     the app that is neither a head nor the iOS extension - gets the same but the ids, which are each
	     head's own, so its options builder needs nothing from a head. Constants, because Android's manifest attributes take nothing else. In no
	     namespace, so every file of the app finds it: the Android publish builds a copy of the head's
	     project under another name, and with it another root namespace. Written before each compile,
	     and only when it changed; the names go in as verbatim strings, so only a quote is escaped. -->
	<Target Name="VhWriteAppConstants" BeforeTargets="CoreCompile" DependsOnTargets="PrepareForBuild"
	        Condition="'$(VhAppIdBase)' != '' And '$(VhAppIsExtension)' != 'true'">
		<Error Condition="'$(VhAppIsApp)' == 'true' And '$(VhAppPlatform)' == ''"
		       Text="The app's platform does not follow from its target framework '$(TargetFramework)'. State it beside the target framework, as a Linux head does: &lt;VhAppPlatform&gt;linux&lt;/VhAppPlatform&gt;." />
		<Error Condition="'$(VhAppName)' == ''"
		       Text="The app states an id base (VhAppIdBase) but no name: state VhAppName beside it." />
		<Error Condition="'$(_VhAppHasCompany)' != 'true'"
		       Text="The app states no maker: state Company beside VhAppName." />

		<PropertyGroup>
			<_VhAppConstantsFile>$(IntermediateOutputPath)AppConstants.g.cs</_VhAppConstantsFile>
			<_VhAppIsDebugCs>false</_VhAppIsDebugCs>
			<_VhAppIsDebugCs Condition="'$(VhAppIsDebug)' == 'true'">true</_VhAppIsDebugCs>
			<_VhAppIdConstant />
			<_VhAppIdConstant Condition="'$(VhAppIsApp)' == 'true'">
    public const string AppId = @"$(ApplicationId.Replace('"', '""'))";
    public const string AdMobApplicationId = @"$(VhAdMobApplicationId.Replace('"', '""'))";</_VhAppIdConstant>
			<_VhAppIosConstants />
			<_VhAppIosConstants Condition="'$(VhAppIsApp)' == 'true' And '$(VhAppPlatform)' == 'ios'">
    public const string AppGroupId = @"$(VhAppGroupId.Replace('"', '""'))";
    public const string ProviderBundleId = @"$(VhAppExtensionId.Replace('"', '""'))";</_VhAppIosConstants>
			<_VhAppConstantsCode>// &lt;auto-generated&gt;
// What this build of the app is, from the app's identity (VhAppIdBase, VhAppName) by
// VpnHood.AppLib.App.targets. Every build writes it again: change the identity, not this file.
// &lt;/auto-generated&gt;

internal static class AppConstants
{$(_VhAppIdConstant)
    public const string AppName = @"$(VhAppDisplayName.Replace('"', '""'))";
    public const string AppVersion = @"$(Version.Replace('"', '""'))";
    public const string CompanyName = @"$(Company.Replace('"', '""'))";
    public const string PackageTitle = @"$(VhAppPackageTitle.Replace('"', '""'))";
    public const bool IsDebugMode = $(_VhAppIsDebugCs);$(_VhAppIosConstants)
}</_VhAppConstantsCode>
		</PropertyGroup>

		<!-- One line of one item, escaped whole: WriteLinesToFile would split a list at a semicolon in
		     the name and trim each line's indent. -->
		<WriteLinesToFile File="$(_VhAppConstantsFile)" Lines="$([MSBuild]::Escape('$(_VhAppConstantsCode)'))"
		                  Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<Compile Include="$(_VhAppConstantsFile)" />
			<FileWrites Include="$(_VhAppConstantsFile)" />
		</ItemGroup>
	</Target>
</Project>
