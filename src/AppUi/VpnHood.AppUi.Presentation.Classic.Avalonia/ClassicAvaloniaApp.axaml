<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.ClassicAvaloniaApp"
             RequestedThemeVariant="Dark">
  <!-- No palette here: Initialize merges them - the client's blue as the default, the other
       product's over it where a head asked for it - and it does so before it loads this file,
       because the styles below name their keys with StaticResource, which is read once, as they
       load. A palette merged after them is never looked at again, which is a violet head painted
       blue. Dark is what the Fluent controls take for the keys no theme of ours names. -->
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://VpnHood.AppUi.Presentation.Classic.Avalonia/Styles/AppTheme.axaml" />
  </Application.Styles>
</Application>
