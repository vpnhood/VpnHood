<?xml version="1.0" encoding="utf-8"?>
<!-- What Auto Backup and a transfer to a new device leave out on Android 12 and newer (backup_rules.xml
     for older ones): the SDKs' own files - their unsent reports, their state and ids for this install,
     the ad web view's data. The app's own device-only files are in the no-backup folder, which
     neither takes (AppOptionsContext.NoBackupStoragePath, IDevice.VpnServiceConfigFolder), so none is
     named here. The rest travels, credentials included, encrypted where the phone can (owner,
     2026-10-12). -->
<data-extraction-rules>
	<cloud-backup>
		<exclude domain="file" path=".crashlytics.v3" />
		<exclude domain="file" path="datastore" />
		<exclude domain="file" path="profileInstalled" />
		<exclude domain="database" path="com.google.android.datatransport.events" />
		<exclude domain="database" path="com.google.android.datatransport.events-journal" />
		<exclude domain="sharedpref" path="admob.xml" />
		<exclude domain="sharedpref" path="com.google.android.gms.measurement.prefs.xml" />
		<exclude domain="sharedpref" path="com.google.firebase.crashlytics.xml" />
		<exclude domain="sharedpref" path="paid_storage_sp.xml" />
		<exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
		<exclude domain="sharedpref" path="AwOriginVisitLoggerPrefs.xml" />
		<exclude domain="root" path="app_webview" />
	</cloud-backup>
	<device-transfer>
		<exclude domain="file" path=".crashlytics.v3" />
		<exclude domain="file" path="datastore" />
		<exclude domain="file" path="profileInstalled" />
		<exclude domain="database" path="com.google.android.datatransport.events" />
		<exclude domain="database" path="com.google.android.datatransport.events-journal" />
		<exclude domain="sharedpref" path="admob.xml" />
		<exclude domain="sharedpref" path="com.google.android.gms.measurement.prefs.xml" />
		<exclude domain="sharedpref" path="com.google.firebase.crashlytics.xml" />
		<exclude domain="sharedpref" path="paid_storage_sp.xml" />
		<exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
		<exclude domain="sharedpref" path="AwOriginVisitLoggerPrefs.xml" />
		<exclude domain="root" path="app_webview" />
	</device-transfer>
</data-extraction-rules>
