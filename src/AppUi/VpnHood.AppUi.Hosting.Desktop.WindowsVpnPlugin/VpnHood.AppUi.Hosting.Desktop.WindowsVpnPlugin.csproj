<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
		<Description>The VpnHood desktop host on the Windows VPN plug-in, from an MSIX package: the app and its window run in one process as whoever is signed in, LocalState is their storage, and Windows' own VPN host holds the tunnel. The window itself is VpnHood.AppUi.Hosting.Desktop</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\VpnHood.AppUi.Hosting.Desktop\VpnHood.AppUi.Hosting.Desktop.csproj" />
		<!-- The app as the window's process runs it. -->
		<ProjectReference Include="..\..\AppLib\VpnHood.AppLib.App.WindowsVpnPlugin\VpnHood.AppLib.App.WindowsVpnPlugin.csproj" />
	</ItemGroup>
</Project>
