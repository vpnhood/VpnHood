<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppUi.Services"
             xmlns:controls="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Controls"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.StarlinkToolsView">
  <!-- The web UI's starlink-tools: a MOCK page behind the /starlink debug command. Nothing here is
       wired to the app - no setting is read or saved - and Find only says so. The state is local to
       the page and dies with it. -->
  <DockPanel Classes="page">
    <controls:PageHeader x:Name="Header" DockPanel.Dock="Top" Title="{Binding StarlinkTools, Source={x:Static res:Strings.Current}}" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="720" Spacing="16">
        <TextBlock Classes="mdi" FontSize="96" Foreground="{StaticResource TonalIconBtnBrush}" Text="{x:Static res:Mdi.SatelliteUplink}" HorizontalAlignment="Center" />
        <StackPanel Spacing="4" Margin="12,0">
          <TextBlock Classes="card-subtitle" Text="{Binding StarlinkToolsDesc, Source={x:Static res:Strings.Current}}" />
          <TextBlock x:Name="ScopeText" Classes="body-small highlight" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>
        <Border Classes="config-card" Padding="4,8">
          <StackPanel Spacing="4">
            <controls:OptionRow x:Name="DisabledRow" Clicked="OnDisabledClick" />
            <controls:OptionRow x:Name="RemoteRow" Clicked="OnRemoteClick" />
            <TextBox x:Name="RemoteBox" Classes="outlined" PlaceholderText="192.0.2.1" Margin="44,0,12,8" IsVisible="False" FlowDirection="LeftToRight" />
            <controls:OptionRow x:Name="LocalRow" Clicked="OnLocalClick" />
            <StackPanel x:Name="LocalPanel" Spacing="8" Margin="44,0,12,8" IsVisible="False">
              <!-- the address and its Find button read left to right in every language, as
                   starlink-tools.vue keeps them inside one locale provider -->
              <Grid ColumnDefinitions="*,Auto" FlowDirection="LeftToRight">
                <TextBox x:Name="LocalBox" Classes="outlined" PlaceholderText="192.0.2.1" />
                <Button Grid.Column="1" Classes="btn2 small pill" Margin="8,0,0,0" Click="OnFindClick"
                        Content="{Binding StarlinkFind, Source={x:Static res:Strings.Current}}" />
              </Grid>
              <controls:OptionRow x:Name="AutoFindRow" IsCheckBox="True" IsChecked="True" Clicked="OnAutoFindClick" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
