<dialogs:DialogBase xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="using:VpnHood.AppLib.Assets"
                    xmlns:dialogs="using:VpnHood.AppLib.ClassicAvaloniaUi.Views.Dialogs"
                    x:Class="VpnHood.AppLib.ClassicAvaloniaUi.Views.Dialogs.CustomEndpointDialog">
  <!-- The web UI's custom endpoint dialog: an address of the person's own for the server, and the
       switch that puts it in force. -->
  <Border Classes="dialog" MaxWidth="520">
    <StackPanel Spacing="12">
      <TextBlock Classes="dialog-title" Text="{Binding CustomEndpoint, Source={x:Static res:Strings.Current}}" />
      <Button x:Name="EnabledRow" Classes="list-item last" Padding="0,4" Click="OnEnabledClick">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="body-medium" Text="{Binding CustomEndpointEnable, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
          <ToggleSwitch x:Name="EnabledSwitch" Grid.Column="1" />
        </Grid>
      </Button>
      <TextBox x:Name="EndpointBox" Classes="outlined" TextChanged="OnEndpointChanged" KeyDown="OnEndpointKeyDown" FlowDirection="LeftToRight" />
      <TextBlock x:Name="ErrorText" Classes="body-small error-text" TextWrapping="Wrap" IsVisible="False" />
      <TextBlock Classes="body-small dialog-text" TextWrapping="Wrap" Text="{Binding CustomEndpointDesc, Source={x:Static res:Strings.Current}}" />
      <WrapPanel Orientation="Horizontal">
        <Border Classes="chip sample" Margin="0,0,8,0"><TextBlock Text="IPv4: 192.0.2.1:443" /></Border>
        <Border Classes="chip sample"><TextBlock Text="IPv6: [2001:db8::1]:443" /></Border>
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="dialog-btn" Click="OnCancelClick" Content="{Binding Cancel, Source={x:Static res:Strings.Current}}" />
        <Button x:Name="SaveButton" Classes="dialog-btn plain" Click="OnSaveClick" Content="{Binding Save, Source={x:Static res:Strings.Current}}" />
      </StackPanel>
    </StackPanel>
  </Border>
</dialogs:DialogBase>
