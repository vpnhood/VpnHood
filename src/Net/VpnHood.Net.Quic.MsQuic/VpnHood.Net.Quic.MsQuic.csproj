<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>MsQuic (System.Net.Quic) implementation of the VpnHood QUIC abstractions. Supported on Windows and Linux.</Description>
		<TargetFramework>net11.0</TargetFramework>
		<!-- the whole public API is documented: a missing or broken doc comment fails the build -->
		<VhApiDocsComplete>true</VhApiDocsComplete>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Native.Quic.MsQuic.OpenSSL" Version="2.6.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VpnHood.Net.Toolkit\VpnHood.Net.Toolkit.csproj" />
		<ProjectReference Include="..\VpnHood.Net.Quic.Abstractions\VpnHood.Net.Quic.Abstractions.csproj" />
	</ItemGroup>

</Project>
