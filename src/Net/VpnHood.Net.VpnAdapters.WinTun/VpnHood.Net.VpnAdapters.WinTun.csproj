<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>VpnHood VpnAdapter for WinTun</Description>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
	  <ProjectReference Include="..\VpnHood.Net.VpnAdapters.Abstractions\VpnHood.Net.VpnAdapters.Abstractions.csproj" />
	</ItemGroup>

	<!-- WinTun's DLLs as wintun.net ships them, embedded and installed at run time into a protected folder
	     of their own (WindowsCommonFiles): nothing beside the app, and signing our assembly leaves them as
	     they are, which their license requires. -->
	<ItemGroup>
		<EmbeddedResource Include="Resources\wintun-x64.dll" LogicalName="wintun-x64.dll" />
		<EmbeddedResource Include="Resources\wintun-arm64.dll" LogicalName="wintun-arm64.dll" />
	</ItemGroup>

</Project>
