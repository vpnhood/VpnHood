<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>VpnHood.AppUi.Presentation.Classic.Avalonia</RootNamespace>
		<IsPackable>false</IsPackable>
		<Description>VpnHood's own Avalonia UI: the web UI's pages, page for page, in one responsive layout - the views, the controls and the two products' themes</Description>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<!-- This UI embeds no assets: its images, country flags, fonts, content documents and words are
	     the files of VpnHood.AppUi.Assets.Classic, read at run time through the IAssetProvider the
	     head hands in - the zip that package's targets placed, extracted; or the app's web host,
	     from a browser page. -->

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.2" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
		<!-- The QR of the pairing address: Android has no encoder of its own and Core Image is tvOS-only,
		     so one dependency-free .NET encoder serves both (TV plan, Phase 4). -->
		<PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- Mounting Avalonia and the app's state as the pages read it, which any Avalonia UI needs. -->
		<ProjectReference Include="..\..\Hosting\Avalonia\Avalonia\VpnHood.AppUi.Hosting.Avalonia.csproj" />
		<!-- The words, the error sentences, the formatting - what the pages say, for any toolkit. -->
		<ProjectReference Include="..\..\Services\VpnHood.AppUi.Services.csproj" />
		<!-- The look this UI draws: the store's files, which the head's build places by importing the
		     store's targets (a project reference carries none; a package reference will). Declared, not
		     compiled against - the store has no assembly. -->
		<ProjectReference Include="..\..\Assets\Classic\VpnHood.AppUi.Assets.Classic.csproj" ReferenceOutputAssembly="false" />
		<!-- The pairing page starts and stops the LAN listener the phone dials into. -->
	</ItemGroup>
</Project>
