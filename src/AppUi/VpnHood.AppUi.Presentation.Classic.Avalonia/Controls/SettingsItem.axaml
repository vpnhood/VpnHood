<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppUi.Common"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Controls.SettingsItem">
  <!-- The web UI's SettingsItem: a card that opens a page - the title, a chip saying its state or
       its choice, a warning chip when its posture can leak (the chips under the title when a long
       language leaves no room beside it), the crown when it is sold, the subtitle and the chevron.
       The whole card is the button, and the ring is its. -->
  <Button x:Name="Card" Classes="card-row" Click="OnCardClick" Margin="0,0,0,12">
    <StackPanel Spacing="4">
      <Grid ColumnDefinitions="*,Auto">
        <WrapPanel ItemSpacing="8" LineSpacing="4" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Classes="body-medium" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Border x:Name="StatusChip" Classes="chip comfortable" IsVisible="False">
            <TextBlock x:Name="StatusText" />
          </Border>
          <Button x:Name="WarningChip" Classes="icon" Width="NaN" Height="NaN" Padding="0" MinHeight="0" CornerRadius="12"
                  IsVisible="False" Click="OnWarningClick">
            <Border Classes="chip warning comfortable">
              <TextBlock x:Name="WarningText" />
            </Border>
          </Button>
        </WrapPanel>
        <TextBlock x:Name="Crown" Grid.Column="1" Classes="crown" Text="{x:Static res:Mdi.Crown}" IsVisible="False" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="SubtitleText" Classes="card-subtitle" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="mdi disabled" FontSize="20" Margin="12,0,0,0" Text="{Binding ChevronForward, Source={x:Static res:Strings.Current}}" />
      </Grid>
    </StackPanel>
  </Button>
</UserControl>
