<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net11.0-browser</TargetFramework>
		<VhApiDocsComplete>true</VhApiDocsComplete>
		<Description>Runs any VpnHood Avalonia UI as a browser page: the app's web host serves it to a paired device, and the page dials the app's API over HTTP. Names no UI; a page project names one (AvaloniaBrowserHost.RunAsync) and imports build/*.props for the WebAssembly settings.</Description>
		<!-- [JSImport]'s generated marshalling is unsafe code (BrowserTextInputInterop, BrowserExport). -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Browser" Version="12.2.0" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="BrowserTextInput.js" LogicalName="VhBrowserTextInput.js" />
		<EmbeddedResource Include="BrowserExport.js" LogicalName="VhBrowserExport.js" />
	</ItemGroup>

	<ItemGroup>
		<!-- The Application every host builds and the contract a UI fulfils (IAvaloniaUi). -->
		<ProjectReference Include="..\VpnHood.AppHosting.Avalonia\VpnHood.AppHosting.Avalonia.csproj" />
		<!-- The API over HTTP: the page runs nothing of the app, it talks to the one that served it. -->
		<ProjectReference Include="..\..\AppLogic\VpnHood.AppLogic.Api.HttpClients\VpnHood.AppLogic.Api.HttpClients.csproj" />
	</ItemGroup>
</Project>
