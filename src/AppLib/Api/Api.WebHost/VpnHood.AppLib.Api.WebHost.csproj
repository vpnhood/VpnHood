<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Tiny internal webserver to server your single-page application (SPA). You need this only if you want to create a UI for your VpnHood client by single-page application (SPA)</Description>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Watson.Lite" Version="6.6.0" />
	</ItemGroup>

	<ItemGroup>
	  <!-- The contract this server puts on HTTP, and the in-process host that answers it. The
	       dependency goes this way only: a UI on the device takes the host without this server. -->
	  <ProjectReference Include="..\Api\VpnHood.AppLib.Api.csproj" />
	  <ProjectReference Include="..\..\App\App\VpnHood.AppLib.App.csproj" />
	</ItemGroup>

</Project>
