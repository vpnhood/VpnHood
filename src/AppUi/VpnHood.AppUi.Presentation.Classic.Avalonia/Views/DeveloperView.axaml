<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VpnHood.AppUi.Presentation.Classic.Avalonia.ViewModels"
             xmlns:res="using:VpnHood.AppUi.Common"
             xmlns:controls="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Controls"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.DeveloperView">
  <!-- The web UI's developer dialog (components/Home/DeveloperDialog.vue) as a page: the title
       with its bug icon, the debug commands, the free debug field and the log - not the dialog's
       support id, which a developer has no use for here and a profile often lacks. The dialog's
       Close is the page's Back, which saves. DebugData1 is that dialog's combobox: the chosen
       commands as chips in a field, and the list behind the chevron, as wide as the field and
       scrolling on its own so the page never does. The items are the app's own
       (AppFeatures.DebugCommands); a chip is dropped by unticking it in the list, not by a close
       button on the chip, which a remote could not aim at. The words here are English literals, as
       they are in that dialog - a developers' screen has no locale keys. -->
  <DockPanel Classes="page">
    <controls:PageHeader x:Name="Header" DockPanel.Dock="Top" Title="Only developers" Icon="{x:Static res:Mdi.BugOutline}" />

    <StackPanel MaxWidth="720" Spacing="14" VerticalAlignment="Top">

      <!-- DebugData1: what is on, as chips; the list is the drop-down -->
      <TextBlock Classes="body-small muted40" Text="DebugData1" />
      <Button x:Name="CommandsField" Classes="combo-field">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="NoCommandText" Classes="body-small disabled" Text="None" VerticalAlignment="Center" />
          <ItemsControl x:Name="ChosenList" Grid.Column="0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DebugCommandItem">
                <Border Classes="chip chip-auto" Margin="0,2,6,2">
                  <TextBlock Text="{Binding Command}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Grid.Column="1" Classes="mdi" FontSize="20" Margin="8,0,0,0"
                     Text="{x:Static res:Mdi.ChevronDown}" VerticalAlignment="Center" />
        </Grid>
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="commands" Opening="OnCommandsOpening">
            <Border x:Name="CommandsPanel" Classes="commands-list">
              <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="CommandList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DebugCommandItem">
                      <ToggleButton Classes="debug-item" IsChecked="{Binding IsOn, Mode=TwoWay}">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="body-small" Text="{Binding Command}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Classes="mdi check" FontSize="18" Margin="16,0,0,0"
                                     Foreground="{StaticResource ActiveServerBrush}" Text="{x:Static res:Mdi.Check}" />
                        </Grid>
                      </ToggleButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </Flyout>
        </Button.Flyout>
      </Button>

      <!-- DebugData2: free text, as the dialog's second field -->
      <TextBlock Classes="body-small muted40" Text="DebugData2" />
      <TextBox x:Name="DebugData2Box" />

      <!-- as wide as the fields, as a page's main button is; on a TV its own size (the code) -->
      <Button x:Name="LogButton" Classes="pill btn1 block" Content="Open log" Click="OnLogClick" Margin="0,6,0,0" />

    </StackPanel>
  </DockPanel>
</UserControl>
