<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>false</IsPackable>	<!-- application, not a NuGet package -->
		<Description>VpnHood Android Client Connect App with Ads and memebership</Description>
		<TargetFramework>net10.0-android36.1</TargetFramework>
		<RootNamespace>VpnHood.App.Connect.Droid.Google</RootNamespace>
		<OutputType>Exe</OutputType>
		<ApplicationId>com.vpnhood.connect.android</ApplicationId>
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<DebugSymbols>True</DebugSymbols>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<!--android-arm is required for some android TVs-->
		<UseCurrentRuntimeIdentifier>false</UseCurrentRuntimeIdentifier>
		<RuntimeIdentifier>android-arm64</RuntimeIdentifier>
		<RuntimeIdentifiers>android-arm64;android-x64;android-arm</RuntimeIdentifiers>
		<PublishTrimmed>True</PublishTrimmed>
		<RunAOTCompilation>True</RunAOTCompilation>
		<!--<AndroidLinkTool>r8</AndroidLinkTool> debugging-->
	</PropertyGroup>

	<PropertyGroup>
		<BaseIntermediateOutputPath />
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <AndroidKeyStore>False</AndroidKeyStore>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <AndroidKeyStore>False</AndroidKeyStore>
	</PropertyGroup>

	<!-- Optional private app settings (from the external ".user" folder) embedded as resources.
	     Conditional so a fork without them still builds; AppConfigs reads them at startup. -->
	<ItemGroup>
		<EmbeddedResource Include="$(VhUserDir)\VpnHoodConnect\appsettings.json"
			LogicalName="AppSettings.json"
			Condition="Exists('$(VhUserDir)\VpnHoodConnect\appsettings.json')" />
		<EmbeddedResource Include="$(VhUserDir)\VpnHoodConnect\appsettings.$(Configuration).json"
			LogicalName="AppSettings_Environment.json"
			Condition="Exists('$(VhUserDir)\VpnHoodConnect\appsettings.$(Configuration).json')" />
	</ItemGroup>

	<!-- Default access key, embedded as its own resource so it can be sourced from a GitHub secret.
	     The configuration-specific file wins (Debug embeds access_key_default_google.Debug.txt), otherwise
	     the base access_key_default_google.txt is used. Both are optional: a fork without them falls back to the
	     in-code default in AppConfigs. -->
	<ItemGroup>
		<EmbeddedResource Include="$(VhUserDir)\VpnHoodConnect\google\access_key_default_google.$(Configuration).txt"
			LogicalName="access_key_default.txt"
			Condition="Exists('$(VhUserDir)\VpnHoodConnect\google\access_key_default_google.$(Configuration).txt')" />
		<EmbeddedResource Include="$(VhUserDir)\VpnHoodConnect\google\access_key_default_google.txt"
			LogicalName="access_key_default.txt"
			Condition="!Exists('$(VhUserDir)\VpnHoodConnect\google\access_key_default_google.$(Configuration).txt') And Exists('$(VhUserDir)\VpnHoodConnect\google\access_key_default_google.txt')" />
	</ItemGroup>

	<ItemGroup>
		<AndroidResource Update="Resources\xml\locales_config.xml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:UpdateGeneratedFiles</Generator>
		</AndroidResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Xamarin.Firebase.Analytics" Version="123.2.0.1" />
		<PackageReference Include="Xamarin.Firebase.Crashlytics" Version="120.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\AppLib\VpnHood.AppLib.Android.Ads.AdMob\VpnHood.AppLib.Android.Ads.AdMob.csproj" />
		<ProjectReference Include="..\..\AppLib\VpnHood.AppLib.Android.GooglePlay.Core\VpnHood.AppLib.Android.GooglePlay.Core.csproj" />
		<ProjectReference Include="..\..\AppLib\VpnHood.AppLib.Android.GooglePlay\VpnHood.AppLib.Android.GooglePlay.csproj" />
		<ProjectReference Include="..\..\AppLib\VpnHood.AppLib.Android.Common\VpnHood.AppLib.Android.Common.csproj" />
		<ProjectReference Include="..\..\AppLib\VpnHood.AppLib.Portal\VpnHood.AppLib.Portal.csproj" />
		<ProjectReference Include="..\Client\VpnHood.App.Client.csproj" />
	</ItemGroup>

	<ItemGroup>
		<GoogleServicesJson Include="Properties\google-services.json" />
	</ItemGroup>

</Project>