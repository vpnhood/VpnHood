<dialogs:DialogBase xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="using:VpnHood.AppUi.Common"
                    xmlns:controls="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Controls"
                    xmlns:dialogs="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Views.Dialogs"
                    xmlns:hosting="using:VpnHood.AppUi.Hosting.Avalonia"
                    x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.Dialogs.UserReviewDialog">
  <!-- Three faces to pick from; the sad ones open a box for the
       words, the happy one thanks and hands over to the store's own prompt. -->
  <Border Classes="dialog" BorderBrush="{StaticResource RateDialogBorderBrush}" BorderThickness="1">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="Auto,*">
        <Button x:Name="CloseButton" Classes="tonal-icon" Click="OnCloseClick" AutomationProperties.Name="{Binding Close, Source={x:Static res:Strings.Current}}">
          <TextBlock Classes="mdi" FontSize="20" Text="{x:Static res:Mdi.Close}" />
        </Button>
      </Grid>

      <!-- step 1: the faces -->
      <StackPanel x:Name="RateStep" Spacing="16">
        <TextBlock Classes="h3" TextAlignment="Center" Text="{Binding Feedback, Source={x:Static res:Strings.Current}}" />
        <TextBlock x:Name="FeedbackDescText" Classes="body-large dialog-text" TextAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center">
          <Button x:Name="Rate1" Classes="icon" Width="64" Height="64" CornerRadius="32" Click="OnRate1Click"
                  AutomationProperties.Name="{Binding Bad, Source={x:Static res:Strings.Current}}">
            <controls:RateFace x:Name="Face1" Rating="1" />
          </Button>
          <Button x:Name="Rate2" Classes="icon" Width="64" Height="64" CornerRadius="32" Click="OnRate2Click"
                  AutomationProperties.Name="{Binding Ok, Source={x:Static res:Strings.Current}}">
            <controls:RateFace x:Name="Face2" Rating="2" />
          </Button>
          <Button x:Name="Rate3" Classes="icon" Width="64" Height="64" CornerRadius="32" Click="OnRate3Click"
                  AutomationProperties.Name="{Binding Good, Source={x:Static res:Strings.Current}}">
            <controls:RateFace x:Name="Face3" Rating="3" />
          </Button>
        </StackPanel>
      </StackPanel>

      <!-- step 2: the words, for a sad face -->
      <StackPanel x:Name="TextStep" Spacing="12" IsVisible="False">
        <controls:RateFace x:Name="PickedFace" IsPicked="True" Width="88" Height="88" HorizontalAlignment="Center" />
        <TextBlock Classes="label-large" Text="{Binding UserReviewSorryMsg, Source={x:Static res:Strings.Current}}" TextWrapping="Wrap" />
        <!-- sentences in the user's own language: capitals and corrections, and on a paired phone its own fonts -->
        <TextBox x:Name="ReviewBox" Classes="outlined multiline" MaxLength="500" MinHeight="90"
                 TextInputOptions.AutoCapitalization="True" TextInputOptions.ShowSuggestions="True"
                 hosting:NativeTextInput.IsPreferred="True" />
      </StackPanel>

      <!-- step 3: the thanks -->
      <StackPanel x:Name="ThanksStep" Spacing="8" IsVisible="False" HorizontalAlignment="Center">
        <TextBlock Classes="mdi" FontSize="80" HorizontalAlignment="Center" Foreground="{StaticResource RateDialogThanksBrush}" Text="{x:Static res:Mdi.CheckCircleOutline}" />
        <TextBlock Classes="body-medium" TextAlignment="Center" Foreground="{StaticResource RateDialogThanksBrush}" Text="{Binding UserReviewGladMsg, Source={x:Static res:Strings.Current}}" />
        <TextBlock Classes="body-medium" TextAlignment="Center" Text="{Binding ThankYou, Source={x:Static res:Strings.Current}}" />
      </StackPanel>

      <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button x:Name="LaterButton" Classes="btn-text" Click="OnCloseClick" />
        <Button x:Name="SubmitButton" Classes="btn-main" IsEnabled="False" Click="OnSubmitClick"
                Content="{Binding Submit, Source={x:Static res:Strings.Current}}" />
        <Button x:Name="SendButton" Classes="btn-main" IsVisible="False" IsEnabled="False" Click="OnSendClick"
                Content="{Binding Send, Source={x:Static res:Strings.Current}}" />
      </StackPanel>
    </StackPanel>
  </Border>
</dialogs:DialogBase>
