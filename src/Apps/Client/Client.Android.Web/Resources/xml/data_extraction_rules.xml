<?xml version="1.0" encoding="utf-8"?>
<!-- What Auto Backup and a device-to-device transfer leave out on Android 12 and newer:
     the logs (backup_rules.xml for older ones). The logs stay on the device that wrote
     them. -->
<data-extraction-rules>
	<cloud-backup>
		<exclude domain="file" path=".local/share/VpnHood/app.log" />
		<exclude domain="file" path=".local/share/vpn-service" />
	</cloud-backup>
	<device-transfer>
		<exclude domain="file" path=".local/share/VpnHood/app.log" />
		<exclude domain="file" path=".local/share/vpn-service" />
	</device-transfer>
</data-extraction-rules>
