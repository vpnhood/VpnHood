<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>VpnHood shared code for iOS client apps (WebView host + app bootstrap)</Description>
		<TargetFrameworks>$(VhAppleTargetFrameworks)</TargetFrameworks>
		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-tvos'))">17.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\VpnHood.AppLib.App\VpnHood.AppLib.App.csproj" />
		<ProjectReference Include="..\VpnHood.AppLib.Api.WebHost\VpnHood.AppLib.Api.WebHost.csproj" />
		<ProjectReference Include="..\..\Core\VpnHood.Core.Client.Devices.Ios\VpnHood.Core.Client.Devices.Ios.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Draws the app's icons from its SVGs at build time (VpnHood.AppLib.App.targets): its targets reach
		     every head that references this, and nothing of it ships in the app. -->
		<PackageReference Include="Microsoft.Maui.Resizetizer" Version="11.0.0" />
	</ItemGroup>
</Project>
