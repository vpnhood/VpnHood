<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>iOS (Apple Network.framework, iOS 15+) implementation of the VpnHood QUIC abstractions.</Description>
		<TargetFramework>net11.0-ios</TargetFramework>
		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<!-- VpnHood.Net.Toolkit provides SystemSocketFactory and transitively references
		     VpnHood.Net.Quic.Abstractions -->
		<ProjectReference Include="..\VpnHood.Net.Toolkit\VpnHood.Net.Toolkit.csproj" />
	</ItemGroup>

</Project>
