<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>	<!-- application, not a NuGet package -->
    <OutputType>Exe</OutputType>
    <!-- iOS and the Apple TV: one app on both, the same bundle id, App Group and extension id, so one App
         Store record, its subscriptions included. -->
    <TargetFrameworks>$(VhAppleTargetFrameworks)</TargetFrameworks>
    <UseMaui>false</UseMaui>
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    <!-- The SDK trims only its own assemblies here, so the shared code's reflection finds our types whole.
         Android's SDK keeps this analysis off for such a build; Apple's leaves it on. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- The project is named for its channel (the App Store); the bundle's executable is the app's
         package title. The bundle id, the name, the App Group and the extension's id come from the app's
         identity (../Directory.Build.props). -->
    <AssemblyName>$(VhAppPackageTitle)</AssemblyName>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>

    <!-- Automatic signing: Xcode picks the cert/profile for the team (6KKW3MKLR7, OmegaHood LLC). -->
    <AutomaticProvisioning>true</AutomaticProvisioning>
    <CodesignKey>Apple Development</CodesignKey>

  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- The Apple TV: its own manifest; the first tvOS with Network Extension; and the split filters' SQLite
       (VpnHood.Core.Filtering.Sqlite), whose package ships no tvOS build of the library, answered by tvOS's
       own libsqlite3 - all but the one call it leaves out, which the filters never make, so the linker is
       asked for no such symbol. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tvos'">
    <RuntimeIdentifier>tvos-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <AppBundleManifest>Info.tvOS.plist</AppBundleManifest>
    <MtouchExtraArgs>$(MtouchExtraArgs) --gcc_flags=-lsqlite3</MtouchExtraArgs>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tvos'">
    <ReferenceNativeSymbol Include="sqlite3_enable_load_extension" SymbolType="Function" SymbolMode="Ignore" />
  </ItemGroup>


  <!-- Apple's privacy manifest. MUST sit at the ROOT of the .app bundle for App Store Connect's scanner
       to find it, hence the explicit LogicalName; without it the file would be nested under its source
       path and the upload still fails ITMS-91053. The .appex carries its own copy (see that csproj). -->
  <ItemGroup>
    <BundleResource Include="PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <!-- Default access key, embedded as its own resource so it can be sourced from a GitHub secret.
       Keys are per-entitlement, not per-store: only the ad-supported build (Android Google) embeds
       access_key_ad; every ad-free build — iOS included (the App Store head has no ads) — embeds
       access_key_premium. The configuration-specific file wins (Debug embeds access_key_premium.Debug.txt),
       otherwise the base access_key_premium.txt is used. Both optional: a fork without them has no
       built-in key (a Debug build takes the engine's sample, ConnectAppOptions). The product's settings
       are embedded by the product project (ConnectAppConfigs). Forward slashes: this builds on macOS. -->
  <ItemGroup>
    <EmbeddedResource Include="$(VhUserDir)/$(VhAppPackageTitle)/access_key_premium.$(Configuration).txt"
        LogicalName="access_key_default.txt"
        Condition="Exists('$(VhUserDir)/$(VhAppPackageTitle)/access_key_premium.$(Configuration).txt')" />
    <EmbeddedResource Include="$(VhUserDir)/$(VhAppPackageTitle)/access_key_premium.txt"
        LogicalName="access_key_default.txt"
        Condition="!Exists('$(VhUserDir)/$(VhAppPackageTitle)/access_key_premium.$(Configuration).txt') And Exists('$(VhUserDir)/$(VhAppPackageTitle)/access_key_premium.txt')" />
  </ItemGroup>

  <ItemGroup>
    <!-- App framework + iOS device abstraction. -->
    <ProjectReference Include="..\..\..\AppLib\VpnHood.AppLib.App\VpnHood.AppLib.App.csproj" />
    <ProjectReference Include="..\..\..\Core\VpnHood.Core.Client.Devices.Abstractions\VpnHood.Core.Client.Devices.Abstractions.csproj" />
    <!-- Concrete iOS IDevice (IosDevice) + IPC message client live in the core Device.iOS project. -->
    <ProjectReference Include="..\..\..\Core\VpnHood.Core.Client.Devices.Ios\VpnHood.Core.Client.Devices.Ios.csproj" />
    <!-- iOS shared app code: the VpnHoodIosApp bootstrap and the UI context. -->
    <ProjectReference Include="..\..\..\AppLib\VpnHood.AppLib.App.Ios\VpnHood.AppLib.App.Ios.csproj" />
    <!-- The UI this head runs, which AppDelegate is the application delegate of. -->
    <ProjectReference Include="..\..\..\AppUi\VpnHood.AppUi.Hosting.Avalonia.Ios\VpnHood.AppUi.Hosting.Avalonia.Ios.csproj" />
    <!-- The UI itself: the pages, the controls, the themes. -->
    <ProjectReference Include="..\..\..\AppUi\VpnHood.AppUi.Presentation.Classic.Avalonia\VpnHood.AppUi.Presentation.Classic.Avalonia.csproj" />
    <!-- App Store updates and, on iOS, reviews (AppStoreAppUpdaterProvider / AppStoreInAppUserReviewProvider). -->
    <ProjectReference Include="..\..\..\AppLib\VpnHood.AppLib.Stores.AppStore.Core\VpnHood.AppLib.Stores.AppStore.Core.csproj" />
    <!-- StoreKit 2 billing + Sign in with Apple (AppStoreBillingProvider / AppleAuthenticationProvider).
         The Swift facade + binding come from the VpnHood.AppLib.Stores.AppStore.Native NuGet it
         references; being a binding package, its xcframework links into the app automatically. -->
    <ProjectReference Include="..\..\..\AppLib\VpnHood.AppLib.Stores.AppStore\VpnHood.AppLib.Stores.AppStore.csproj" />
    <!-- Portal (WHMCS vpnhoodiap) account backend: sign-in sessions, entitlements, purchase verify. -->
    <ProjectReference Include="..\..\..\AppLib\VpnHood.AppLib.Portal\VpnHood.AppLib.Portal.csproj" />
    <!-- Shared client resources: the IP-location db and ConnectAppResources. -->
    <ProjectReference Include="..\Connect\VpnHood.App.Connect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the Network Extension as a PlugIn (.appex) inside the host app. UndefineProperties drops
         the app's global /p:CodesignProvision (the App Store publish passes the *app* profile) when
         building this reference, so the .appex resolves its OWN App Store profile from its csproj
         instead of being signed with the app profile (App-ID mismatch -> codesign failure). Built and
         bundled, never compiled against: the app sees nothing of the VPN service's side. It targets the
         app's platforms, so each target bundles its own platform's build. -->
    <ProjectReference Include="..\Connect.Ios.Extension\VpnHood.App.Connect.Ios.Extension.csproj">
      <IsAppExtension>true</IsAppExtension>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <UndefineProperties>CodesignProvision</UndefineProperties>
    </ProjectReference>
  </ItemGroup>

	<!-- The assets folder - the images, flags, fonts, documents and words every UI draws from - placed the way
	     this platform reads files: the same targets a package reference of VpnHood.AppUi.Assets.Classic imports. -->
	<Import Project="..\..\..\AppUi\VpnHood.AppUi.Assets.Classic\buildTransitive\VpnHood.AppUi.Assets.Classic.targets" />
	<!-- The page the web host serves - the Avalonia UI's browser build - placed the same way: the same
	     targets a package reference of VpnHood.AppUi.Presentation.Classic.Avalonia imports; the head
	     reads it at "assets/web-root.zip". -->
	<Import Project="..\..\..\AppUi\VpnHood.AppUi.Presentation.Classic.Avalonia\buildTransitive\VpnHood.AppUi.Presentation.Classic.Avalonia.targets" />
</Project>
