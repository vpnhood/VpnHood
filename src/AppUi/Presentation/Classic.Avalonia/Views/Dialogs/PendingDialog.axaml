<dialogs:DialogBase xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="using:VpnHood.AppLib.Assets"
                    xmlns:dialogs="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Views.Dialogs"
                    x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.Dialogs.PendingDialog">
  <!-- The web UI's PendingDialog: the order is with the store; nothing to press until it answers. -->
  <Border Classes="dialog" MaxWidth="360">
    <StackPanel Spacing="12">
      <TextBlock Classes="dialog-text" Text="{Binding WaitingToCompleteOrderProcess, Source={x:Static res:Strings.Current}}" />
      <ProgressBar IsIndeterminate="True" />
    </StackPanel>
  </Border>
</dialogs:DialogBase>
