<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppLib.AvaloniaUI.Resources"
             xmlns:controls="using:VpnHood.AppLib.AvaloniaUI.Controls"
             x:Class="VpnHood.AppLib.AvaloniaUI.Views.SplitIpv6View">
  <!-- The web UI's split-ipv6: what becomes of IPv6 on a server that cannot carry it - blocked,
       or let out with its warning -->
  <DockPanel Classes="page">
    <controls:PageHeader x:Name="Header" DockPanel.Dock="Top" Title="{Binding SplitIpv6, Source={x:Static res:Strings.Current}}" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="720">
        <controls:SplitDisabledAlert x:Name="DisabledAlert" TurnedOn="OnTurnedOn" />
        <TextBlock x:Name="DescriptionText" Classes="card-subtitle" Margin="0,0,0,16" />
        <Border x:Name="LeakAlert" Classes="alert-warning" Margin="0,0,0,16" IsVisible="False">
          <TextBlock Classes="body-small" TextWrapping="Wrap" Text="{Binding SplitIpv6LeakWarning, Source={x:Static res:Strings.Current}}" />
        </Border>
        <Border x:Name="Card" Classes="config-card" Padding="4,8">
          <StackPanel>
            <controls:OptionRow x:Name="BlockRow" Clicked="OnBlockClick" />
            <controls:OptionRow x:Name="ExcludeRow" Clicked="OnExcludeClick" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
