<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppUi.Common"
             xmlns:ui="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Resources"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.ExtendSessionView">
  <!-- The web UI's servers/extend-session: more time on a premium session, by an ad while the
       session allows it, or by an upgrade. -->
  <Border Classes="grad-sheet">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <DockPanel Classes="page">
        <Grid DockPanel.Dock="Top" Margin="0,8,0,4" MinHeight="43">
          <Button x:Name="BackButton" Classes="back-btn" HorizontalAlignment="Left" Click="OnBackClick">
            <TextBlock Classes="mdi" Text="{Binding ChevronBack, Source={x:Static res:Strings.Current}}" />
          </Button>
        </Grid>
        <StackPanel MaxWidth="720" Spacing="12">
          <TextBlock x:Name="TitleText" Classes="h3" TextAlignment="Center" Margin="0,16,0,0" />
          <Image ui:AppImage.Source="images/extend-session.webp" MaxWidth="400" MaxHeight="220" Stretch="Uniform" Margin="0,8" />
          <StackPanel x:Name="Rows" Spacing="12" />
        </StackPanel>
      </DockPanel>
    </ScrollViewer>
  </Border>
</UserControl>
