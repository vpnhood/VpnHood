<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>VpnHood's C#/WinRT component for the Windows VPN plug-in: what Windows activates and calls in the VPN host</Description>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
		<Platforms>x64</Platforms>
		<!-- The object Windows calls must be authored in a C#/WinRT component: in a plain library it compiles but
		     lacks the callable wrapper Windows needs, and activation fails. -->
		<CsWinRTComponent>true</CsWinRTComponent>
		<CsWinRTWindowsMetadata>C:\Windows\System32\WinMetadata</CsWinRTWindowsMetadata>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
		<ProjectReference Include="..\VpnHood.Core.Client.Devices.WindowsVpnPlugin\VpnHood.Core.Client.Devices.WindowsVpnPlugin.csproj" />
	</ItemGroup>

	<!-- The runtime's options: without them, activation fails with 0x80008093. Windows activates the component's
	     classes by their own names, which WinRT.Host finds by their namespace, so no class is mapped. -->
	<ItemGroup>
		<None Update="WinRT.Host.runtimeconfig.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
