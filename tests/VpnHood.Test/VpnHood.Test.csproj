<Project Sdk="MSTest.Sdk/4.4.1">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<UseVSTest>true</UseVSTest>
		<!--MSTest.Sdk injects the test packages implicitly; override its bundled versions via these properties, NOT
		    PackageReference Update (which is a no-op against the SDK's late .targets Include). MSTestVersion defaults to
		    the SDK's bundled version, so only the VSTest platform needs pinning to the latest.-->
		<MicrosoftNETTestSdkVersion>18.10.1</MicrosoftNETTestSdkVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
		<PackageReference Include="PacketDotNet" Version="1.4.9-pre53" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\AppLib\VpnHood.AppLib.Api.WebHost\VpnHood.AppLib.Api.WebHost.csproj" />
		<ProjectReference Include="..\..\src\Core\VpnHood.Core.Client\VpnHood.Core.Client.csproj" />
		<ProjectReference Include="..\..\src\Core\VpnHood.Core.Filtering.Sqlite\VpnHood.Core.Filtering.Sqlite.csproj" />
		<ProjectReference Include="..\..\src\Net\VpnHood.Net.Quic.MsQuic\VpnHood.Net.Quic.MsQuic.csproj" />
		<ProjectReference Include="..\..\src\Core\VpnHood.Core.Server.Access.Managers.FileAccessManagers\VpnHood.Core.Server.Access.Managers.FileAccessManagers.csproj" />
		<ProjectReference Include="..\..\src\Core\VpnHood.Core.Server\VpnHood.Core.Server.csproj" />
		<ProjectReference Include="..\..\src\Core\VpnHood.Core.Client.Devices.Windows\VpnHood.Core.Client.Devices.Windows.csproj" />
		<ProjectReference Include="..\..\src\Net\VpnHood.Net.VpnAdapters.LinuxTun\VpnHood.Net.VpnAdapters.LinuxTun.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Assets\VpnHood.UnitTest.pfx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="MSTest.TestAdapter" Version="4.4.1" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="MSTest.TestFramework" Version="4.4.1" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.10.1" />
	</ItemGroup>

</Project>
