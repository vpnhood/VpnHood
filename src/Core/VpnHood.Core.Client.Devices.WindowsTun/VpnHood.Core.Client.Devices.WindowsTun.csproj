		<TargetFramework>net11.0</TargetFramework>
		<VhApiDocsComplete>true</VhApiDocsComplete>
	</PropertyGroup>

	<ItemGroup>
		<!-- EventLog, for a service's warnings and errors in the Application log. -->
		<PackageReference Include="System.Diagnostics.EventLog" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VpnHood.Core.Client.Devices.Abstractions\VpnHood.Core.Client.Devices.Abstractions.csproj" />
		<ProjectReference Include="..\..\Net\VpnHood.Net.Quic.MsQuic\VpnHood.Net.Quic.MsQuic.csproj" />
		<!-- the kill switch knows the adapter by the name WinTun gives it (WinTunVpnAdapter.BuildGuidFromName) -->
		<ProjectReference Include="..\..\Net\VpnHood.Net.VpnAdapters.WinTun\VpnHood.Net.VpnAdapters.WinTun.csproj" />
	</ItemGroup>


</Project>
