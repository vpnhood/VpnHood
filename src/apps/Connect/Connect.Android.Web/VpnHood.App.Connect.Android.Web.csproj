<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>false</IsPackable>	<!-- application, not a NuGet package -->
		<Description>VpnHood Android Client Connect App with Ads and membership</Description>
		<TargetFramework>net11.0-android37.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<!-- The website hands this APK out, and its id says so (../Directory.Build.props). -->
		<VhAppIdChannel>web</VhAppIdChannel>
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<DebugSymbols>True</DebugSymbols>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<RuntimeIdentifiers>android-arm64;android-x64;</RuntimeIdentifiers>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<!--android-arm is required for some android TVs-->
		<UseCurrentRuntimeIdentifier>false</UseCurrentRuntimeIdentifier>
		<RuntimeIdentifier>android-arm64</RuntimeIdentifier>
		<RuntimeIdentifiers>android-arm64;android-x64;android-arm</RuntimeIdentifiers>
		<PublishTrimmed>True</PublishTrimmed>
		<!-- R8 shrinks and optimizes the Java code; proguard-rules.pro keeps every name. -->
		<AndroidLinkTool>r8</AndroidLinkTool>
	</PropertyGroup>

	<PropertyGroup>
		<BaseIntermediateOutputPath />
	</PropertyGroup>

	<!-- Default access key, embedded as its own resource so it can be sourced from a GitHub secret.
	     Keys are per-entitlement, not per-store: only the ad-supported build (Android Google) embeds
	     access_key_ad; every ad-free build — this web APK included — embeds access_key_premium.
	     The configuration-specific file wins (Debug embeds access_key_premium.Debug.txt), otherwise
	     the base access_key_premium.txt is used. Both are optional: a fork without them has no built-in
	     key (a Debug build takes the engine's sample, ConnectAppOptions). The product's settings are
	     embedded by the product project (ConnectAppConfigs). -->
	<ItemGroup>
		<EmbeddedResource Include="$(VhUserDir)\$(VhAppPackageTitle)\access_key_premium.$(Configuration).txt" LogicalName="access_key_default.txt" Condition="Exists('$(VhUserDir)\$(VhAppPackageTitle)\access_key_premium.$(Configuration).txt')" />
		<EmbeddedResource Include="$(VhUserDir)\$(VhAppPackageTitle)\access_key_premium.txt" LogicalName="access_key_default.txt" Condition="!Exists('$(VhUserDir)\$(VhAppPackageTitle)\access_key_premium.$(Configuration).txt') And Exists('$(VhUserDir)\$(VhAppPackageTitle)\access_key_premium.txt')" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\libs\AppLogic\VpnHood.AppLogic.App.Android\VpnHood.AppLogic.App.Android.csproj" />
		<!-- the VPN service, which the APK carries beside the app -->
		<ProjectReference Include="..\..\..\libs\Core\VpnHood.Core.Client.VpnServices.Host.Android\VpnHood.Core.Client.VpnServices.Host.Android.csproj" />
		<!-- The APK updates itself; never in a store's head. -->
		<ProjectReference Include="..\..\..\libs\AppLogic\VpnHood.AppLogic.Stores.AndroidWeb\VpnHood.AppLogic.Stores.AndroidWeb.csproj" />
		<!-- The UI this head runs, which MainActivity is the activity of. -->
		<ProjectReference Include="..\..\..\libs\AppHosting\VpnHood.AppHosting.Avalonia.Android\VpnHood.AppHosting.Avalonia.Android.csproj" />
		<!-- The UI itself: the pages, the controls, the themes. -->
		<ProjectReference Include="..\..\..\libs\AppUi\VpnHood.AppUi.Avalonia.Classic\VpnHood.AppUi.Avalonia.Classic.csproj" />
		<ProjectReference Include="..\..\..\libs\AppLogic\VpnHood.AppLogic.Portal\VpnHood.AppLogic.Portal.csproj" />
		<ProjectReference Include="..\Connect\VpnHood.App.Connect.csproj" />
	</ItemGroup>

	<!-- The assets folder - the images, flags, fonts, documents and words every UI draws from - placed the way
	     this platform reads files: the same targets a package reference of VpnHood.AppUi.Assets.Classic imports. -->
	<Import Project="..\..\..\libs\AppUi\VpnHood.AppUi.Assets.Classic\buildTransitive\VpnHood.AppUi.Assets.Classic.targets" />
	<!-- The page the web host serves - the Avalonia UI's browser build - placed the same way: the same
	     targets a package reference of VpnHood.AppUi.Avalonia.Classic imports; the head
	     reads it at "assets/web-root.zip". -->
	<Import Project="..\..\..\libs\AppUi\VpnHood.AppUi.Avalonia.Classic\buildTransitive\VpnHood.AppUi.Avalonia.Classic.targets" />
</Project>