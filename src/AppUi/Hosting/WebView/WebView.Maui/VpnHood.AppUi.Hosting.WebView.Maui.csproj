<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Hosts the app web UI in a MAUI WebView page. Not shipped - it keeps the MAUI path compiling</Description>
		<TargetFrameworks>net10.0-android36.1</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.26100.0</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<RootNamespace>VpnHood.AppUi.Hosting.WebView.Maui</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<BaseOutputPath></BaseOutputPath>
		<BaseIntermediateOutputPath />
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Core" Version="10.0.100" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WebView\VpnHood.AppUi.Hosting.WebView.csproj" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<ProjectReference Include="..\..\..\..\AppLib\App\App.Android\VpnHood.AppLib.App.Android.csproj" />
		<ProjectReference Include="..\..\..\..\Core\Client\Devices\Devices.Android\VpnHood.Core.Client.Devices.Android.csproj" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ProjectReference Include="..\..\..\..\AppLib\App\App.Win\VpnHood.AppLib.App.Win.csproj" />
		<ProjectReference Include="..\..\..\..\Core\Client\Devices\Devices.Win\VpnHood.Core.Client.Devices.Win.csproj" />
	</ItemGroup>

</Project>
