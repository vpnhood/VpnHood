<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppLib.Assets"
             xmlns:ui="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Resources"
             xmlns:controls="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Controls"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.DnsView">
  <!-- The web UI's dns/index: the device's private DNS as the first card, opening its page, and the
       adapter DNS - the default, or two addresses of the person's own - as the second. -->
  <DockPanel Classes="page">
    <controls:PageHeader x:Name="Header" DockPanel.Dock="Top" Title="{Binding Dns, Source={x:Static res:Strings.Current}}" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="720">
        <Image Source="{ui:AppImage private-dns.webp}" MaxHeight="130" Stretch="Uniform" />
        <TextBlock Classes="card-subtitle" Margin="12,8,12,20" Text="{Binding DnsDesc, Source={x:Static res:Strings.Current}}" />

        <!-- Private DNS: the device's setting, read here and set in its own page -->
        <Button x:Name="PrivateDnsCard" Classes="card-row" Margin="0,0,0,12" Click="OnPrivateDnsClick">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="body-medium" Text="{Binding PrivateDns, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                <Border x:Name="PrivateDnsChip" Classes="chip comfortable">
                  <TextBlock x:Name="PrivateDnsStatus" />
                </Border>
              </StackPanel>
              <TextBlock x:Name="PrivateDnsCrown" Grid.Column="1" Classes="crown" Text="{x:Static res:Mdi.Crown}" IsVisible="False" />
            </Grid>
            <!-- a host name, left to right in every language (dns/index.vue's dir="ltr") -->
            <TextBlock x:Name="ProviderText" Classes="body-small highlight" TextTrimming="CharacterEllipsis" IsVisible="False" FlowDirection="LeftToRight" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="card-subtitle" Text="{Binding PrivateDnsDesc, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="mdi disabled" FontSize="20" Margin="12,0,0,0" Text="{Binding ChevronForward, Source={x:Static res:Strings.Current}}" />
            </Grid>
          </StackPanel>
        </Button>

        <!-- Adapter DNS: the default, or the person's own two -->
        <Border Classes="config-card" Padding="16,12">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="body-medium" Text="{Binding AdapterDns, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
              <TextBlock x:Name="AdapterCrown" Grid.Column="1" Classes="crown" Text="{x:Static res:Mdi.Crown}" IsVisible="False" />
            </Grid>
            <TextBlock Classes="card-subtitle" Text="{Binding AdapterDnsDesc, Source={x:Static res:Strings.Current}}" />
            <Border x:Name="EnforcedAlert" Classes="alert-warning" IsVisible="False">
              <TextBlock Classes="body-small" TextWrapping="Wrap" Text="{Binding EnforcedByServer, Source={x:Static res:Strings.Current}}" />
            </Border>
            <Border x:Name="PrivateDnsAlert" Classes="alert-warning" IsVisible="False">
              <TextBlock Classes="body-small" TextWrapping="Wrap" Text="{Binding PrivateDnsAvailableAlertMsg, Source={x:Static res:Strings.Current}}" />
            </Border>
            <StackPanel x:Name="ModeRows" Margin="-12,8,-12,0">
              <controls:OptionRow x:Name="DefaultRow" Clicked="OnDefaultClick" />
              <controls:OptionRow x:Name="CustomRow" Clicked="OnCustomClick" />
            </StackPanel>
            <!-- the addresses read left to right in every language, as the web UI's locale provider
                 keeps the whole form -->
            <StackPanel x:Name="CustomPanel" Spacing="6" IsVisible="False" Margin="0,8,0,0" FlowDirection="LeftToRight">
              <TextBlock Classes="body-medium" Text="DNS 1" />
              <TextBox x:Name="Dns1Box" Classes="outlined" PlaceholderText="8.8.8.8" TextChanged="OnDnsChanged" />
              <TextBlock x:Name="Dns1Error" Classes="body-small error-text" IsVisible="False" />
              <TextBlock Classes="body-medium" Text="DNS 2" Margin="0,8,0,0" />
              <TextBox x:Name="Dns2Box" Classes="outlined" PlaceholderText="8.8.4.4" TextChanged="OnDnsChanged" />
              <TextBlock x:Name="Dns2Error" Classes="body-small error-text" IsVisible="False" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
