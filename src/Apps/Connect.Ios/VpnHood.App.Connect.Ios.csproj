<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-ios</TargetFramework>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    <UseMaui>false</UseMaui>
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    <RootNamespace>VpnHood.App.Connect.Ios</RootNamespace>
    <BundleIdentifier>com.vpnhood.connect.ios</BundleIdentifier>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>

    <!-- Automatic signing: Xcode picks the cert/profile for the team (6KKW3MKLR7, OmegaHood LLC). -->
    <AutomaticProvisioning>true</AutomaticProvisioning>
    <CodesignKey>Apple Development</CodesignKey>

  </PropertyGroup>


  <!-- Apple's privacy manifest. MUST sit at the ROOT of the .app bundle for App Store Connect's scanner
       to find it, hence the explicit LogicalName; without it the file would be nested under its source
       path and the upload still fails ITMS-91053. The .appex carries its own copy (see that csproj). -->
  <ItemGroup>
    <BundleResource Include="PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <!-- Optional private app settings (from the external ".user" folder, sibling to the solution) embedded as
       resources. Mirrors Connect.Android.Web. Conditional so a fork without them still builds; AppConfigs
       reads them at startup via AppConfigsBase.LoadConfig(). Forward slashes: this builds on macOS. -->
  <ItemGroup>
    <EmbeddedResource Include="$(VhUserDir)/VpnHoodConnect/appsettings.json"
        LogicalName="AppSettings.json"
        Condition="Exists('$(VhUserDir)/VpnHoodConnect/appsettings.json')" />
    <EmbeddedResource Include="$(VhUserDir)/VpnHoodConnect/appsettings.$(Configuration).json"
        LogicalName="AppSettings_Environment.json"
        Condition="Exists('$(VhUserDir)/VpnHoodConnect/appsettings.$(Configuration).json')" />
  </ItemGroup>

  <!-- Default access key, embedded as its own resource so it can be sourced from a GitHub secret. iOS has
       its own key (ios/), separate from the android web/google ones. The configuration-specific file wins
       (Debug embeds access_key_default_ios.Debug.txt), otherwise the base access_key_default_ios.txt is
       used. Both optional: a fork without them falls back to the in-code default in AppConfigs
       (null -> the UI prompts for a key). -->
  <ItemGroup>
    <EmbeddedResource Include="$(VhUserDir)/VpnHoodConnect/ios/access_key_default_ios.$(Configuration).txt"
        LogicalName="access_key_default.txt"
        Condition="Exists('$(VhUserDir)/VpnHoodConnect/ios/access_key_default_ios.$(Configuration).txt')" />
    <EmbeddedResource Include="$(VhUserDir)/VpnHoodConnect/ios/access_key_default_ios.txt"
        LogicalName="access_key_default.txt"
        Condition="!Exists('$(VhUserDir)/VpnHoodConnect/ios/access_key_default_ios.$(Configuration).txt') And Exists('$(VhUserDir)/VpnHoodConnect/ios/access_key_default_ios.txt')" />
  </ItemGroup>

  <ItemGroup>
    <!-- App framework + iOS device abstraction. -->
    <ProjectReference Include="..\..\AppLib\VpnHood.AppLib.App\VpnHood.AppLib.App.csproj" />
    <ProjectReference Include="..\..\Core\VpnHood.Core.Client.Devices.Abstractions\VpnHood.Core.Client.Devices.Abstractions.csproj" />
    <!-- Concrete iOS IDevice (IosDevice) + IPC message client live in the core Device.iOS project. -->
    <ProjectReference Include="..\..\Core\VpnHood.Core.Client.Devices.Ios\VpnHood.Core.Client.Devices.Ios.csproj" />
    <!-- iOS shared app code: VpnHoodIosApp bootstrap + the WKWebView SPA host. -->
    <ProjectReference Include="..\..\AppLib\VpnHood.AppLib.Ios.Common\VpnHood.AppLib.Ios.Common.csproj" />
    <!-- StoreKit 2 billing + Sign in with Apple (AppStoreBillingProvider / AppleAuthenticationProvider).
         Compiles without the VpnHoodStoreKit.xcframework (its NativeReference is conditional); billing
         then fails at first use with a pointed message, so the Swift facade must be built before a
         store-ready release — see that project's swift/README.md. -->
    <ProjectReference Include="..\..\AppLib\VpnHood.AppLib.Ios.AppStore\VpnHood.AppLib.Ios.AppStore.csproj" />
    <!-- Portal (WHMCS vpnhoodiap) account backend: sign-in sessions, entitlements, purchase verify. -->
    <ProjectReference Include="..\..\AppLib\VpnHood.AppLib.Portal\VpnHood.AppLib.Portal.csproj" />
    <!-- Shared client resources: embedded SPA (SpaZipData) + IP-location db + ConnectAppResources. -->
    <ProjectReference Include="..\Client\VpnHood.App.Client.csproj" />
  </ItemGroup>

  <!-- The StoreKit facade must be referenced from the APP project: a plain class library's
       NativeReference does not flow through ProjectReference (only binding projects package a
       .resources sidecar), so without this the app link drops the vhsk_* symbols and every
       DllImport("__Internal") in NativeStoreKitBridge fails to link. Same conditional as the
       lib: buildable before the xcframework exists, billing then throws at first use. -->
  <ItemGroup Condition="Exists('..\..\AppLib\VpnHood.AppLib.Ios.AppStore\swift\VpnHoodStoreKit.xcframework')">
    <NativeReference Include="..\..\AppLib\VpnHood.AppLib.Ios.AppStore\swift\VpnHoodStoreKit.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>true</SmartLink>
    </NativeReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the Network Extension as a PlugIn (.appex) inside the host app. UndefineProperties drops
         the app's global /p:CodesignProvision (the App Store publish passes the *app* profile) when
         building this reference, so the .appex resolves its OWN App Store profile from its csproj
         instead of being signed with the app profile (App-ID mismatch -> codesign failure). -->
    <ProjectReference Include="..\Connect.Ios.Extension\VpnHood.App.Connect.Ios.Extension.csproj">
      <IsAppExtension>true</IsAppExtension>
      <UndefineProperties>CodesignProvision</UndefineProperties>
    </ProjectReference>
  </ItemGroup>

</Project>
