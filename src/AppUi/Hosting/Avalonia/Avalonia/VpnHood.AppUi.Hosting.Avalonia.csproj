<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Description>What mounts any Avalonia UI for the VpnHood app: the Application every host builds and the contract a UI fulfils. The app's state as pages read it is VpnHood.AppUi.Common, which this references. No theme, no layout, no control, no words</Description>
	</PropertyGroup>

	<!-- Deliberately without VpnHood.AppUi.Assets.Classic: a UI built on this package brings its own
	     images and words, or takes ours by referencing that package itself. Nothing here shows a
	     word or draws a picture, so nothing here needs them. -->

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.2" />
	</ItemGroup>

	<ItemGroup>
		<!-- The app's API, and the whole of what this package knows about the app: the six
		     interfaces and the shapes they carry, in process or over HTTP. No engine, no listener. -->
		<ProjectReference Include="..\..\..\..\AppLib\Api\Api\VpnHood.AppLib.Api.csproj" />
		<!-- The app as a UI sees it (VhApp), which every host configures at start. -->
		<ProjectReference Include="..\..\..\Common\VpnHood.AppUi.Common.csproj" />
	</ItemGroup>
</Project>
