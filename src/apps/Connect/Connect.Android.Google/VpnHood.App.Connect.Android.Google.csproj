<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>false</IsPackable>	<!-- application, not a NuGet package -->
		<Description>VpnHood Android Client Connect App with Ads and membership</Description>
		<TargetFramework>net11.0-android37.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<!-- The Play id in Debug too, not the rule's .debug one (../Directory.Build.props):
		     google-services.json, and the Google sign-in client behind it, know no other package. -->
		<ApplicationId>$(VhAppIdBase).android</ApplicationId>
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<DebugSymbols>True</DebugSymbols>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<!--android-arm is required for some android TVs-->
		<UseCurrentRuntimeIdentifier>false</UseCurrentRuntimeIdentifier>
		<RuntimeIdentifier>android-arm64</RuntimeIdentifier>
		<RuntimeIdentifiers>android-arm64;android-x64;android-arm</RuntimeIdentifiers>
		<PublishTrimmed>True</PublishTrimmed>
		<!-- Play's DEX-optimization requirement (from February 2027): over 10 MB of DEX needs at least 25%
		     optimization, obfuscation and shrinking.
		     The SDK's rules keep every class name and every public and protected member, and rename only
		     private ones (AndroidR8ObfuscationMode), so JNI and reflection lookups stay valid.
		     Its command line takes about 30,800 of Windows' 32,767 characters (2026-10-09): a dozen more
		     Android libraries or a longer checkout path fail it with error 206. The fix then is in the
		     build (fewer, merged ProGuard files, or shorter paths), not in CI. -->
		<AndroidLinkTool>r8</AndroidLinkTool>
	</PropertyGroup>

	<PropertyGroup>
		<BaseIntermediateOutputPath />
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <AndroidKeyStore>False</AndroidKeyStore>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <AndroidKeyStore>False</AndroidKeyStore>
	</PropertyGroup>

	<!-- Default access key, embedded as its own resource so it can be sourced from a GitHub secret.
	     Keys are per-entitlement, not per-store: this Google build is the only ad-supported one, so it
	     embeds access_key_ad; every other distribution embeds access_key_premium.
	     The configuration-specific file wins (Debug embeds access_key_ad.Debug.txt), otherwise
	     the base access_key_ad.txt is used. Both are optional: a fork without them has no built-in key
	     (a Debug build takes the engine's sample, ConnectAppOptions). The product's settings are
	     embedded by the product project (ConnectAppConfigs). -->
	<ItemGroup>
		<EmbeddedResource Include="$(VhUserDir)\$(VhAppPackageTitle)\access_key_ad.$(Configuration).txt"
			LogicalName="access_key_default.txt"
			Condition="Exists('$(VhUserDir)\$(VhAppPackageTitle)\access_key_ad.$(Configuration).txt')" />
		<EmbeddedResource Include="$(VhUserDir)\$(VhAppPackageTitle)\access_key_ad.txt"
			LogicalName="access_key_default.txt"
			Condition="!Exists('$(VhUserDir)\$(VhAppPackageTitle)\access_key_ad.$(Configuration).txt') And Exists('$(VhUserDir)\$(VhAppPackageTitle)\access_key_ad.txt')" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Xamarin.Firebase.Analytics" Version="124.0.0" />
		<PackageReference Include="Xamarin.Firebase.Crashlytics" Version="121.0.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- A network whose ads the app shows has its sellers' lines in vpnhood.com/app-ads.txt, which buyers read at the
		     root of the website the store listing names: a network added here without them loses the buyers who check. -->
		<ProjectReference Include="..\..\..\libs\AppLogic\VpnHood.AppLogic.Ads.AdMob.Android\VpnHood.AppLogic.Ads.AdMob.Android.csproj" />
		<ProjectReference Include="..\..\..\libs\AppLogic\VpnHood.AppLogic.Stores.GooglePlay.Core\VpnHood.AppLogic.Stores.GooglePlay.Core.csproj" />
		<ProjectReference Include="..\..\..\libs\AppLogic\VpnHood.AppLogic.Stores.GooglePlay\VpnHood.AppLogic.Stores.GooglePlay.csproj" />
		<ProjectReference Include="..\..\..\libs\AppLogic\VpnHood.AppLogic.App.Android\VpnHood.AppLogic.App.Android.csproj" />
		<!-- the VPN service, which the APK carries beside the app -->
		<ProjectReference Include="..\..\..\libs\Core\VpnHood.Core.Client.VpnServices.Host.Android\VpnHood.Core.Client.VpnServices.Host.Android.csproj" />
		<!-- The UI this head runs, which MainActivity is the activity of. -->
		<ProjectReference Include="..\..\..\libs\AppHosting\VpnHood.AppHosting.Avalonia.Android\VpnHood.AppHosting.Avalonia.Android.csproj" />
		<!-- The UI itself: the pages, the controls, the themes. -->
		<ProjectReference Include="..\..\..\libs\AppUi\VpnHood.AppUi.Avalonia.Classic\VpnHood.AppUi.Avalonia.Classic.csproj" />
		<ProjectReference Include="..\..\..\libs\AppLogic\VpnHood.AppLogic.Portal\VpnHood.AppLogic.Portal.csproj" />
		<ProjectReference Include="..\Connect\VpnHood.App.Connect.csproj" />
	</ItemGroup>

	<ItemGroup>
		<GoogleServicesJson Include="Properties\google-services.json" />
	</ItemGroup>

	<!-- The assets folder - the images, flags, fonts, documents and words every UI draws from - placed the way
	     this platform reads files: the same targets a package reference of VpnHood.AppUi.Assets.Classic imports. -->
	<Import Project="..\..\..\libs\AppUi\VpnHood.AppUi.Assets.Classic\buildTransitive\VpnHood.AppUi.Assets.Classic.targets" />
	<!-- The page the web host serves - the Avalonia UI's browser build - placed the same way: the same
	     targets a package reference of VpnHood.AppUi.Avalonia.Classic imports; the head
	     reads it at "assets/web-root.zip". -->
	<Import Project="..\..\..\libs\AppUi\VpnHood.AppUi.Avalonia.Classic\buildTransitive\VpnHood.AppUi.Avalonia.Classic.targets" />

	<!-- The internal ad's film, which only THIS head can ever show: the internal ad is the fallback
	     provider registered in App.cs, and no other head registers one. 1.8 MB, so it is not carried
	     by the shared assets package that nine other heads also build.

	     It comes from the CONNECT product's own repo, where the rest of the promotion material lives
	     (promotions/), through $(VhDir). A film changes on the product's schedule, not the code's, and
	     this repo keeps code.

	     Its own asset root, deliberately NOT under assets\: that is the UI's store, a zip extracted
	     to storage, and a film inside it would be a second 1.8 MB on disk for no reason.
	     AssetVideoActivity reads it where it lies, through the descriptor AssetManager gives for a
	     stored entry. The leading assets\ in the link is the package's asset root and is dropped by
	     the Android SDK, so the asset path is "ads/internal-ad.mp4".

	     Optional on purpose: a build without that repo beside this one - a CI run that checks out only
	     the code, a fork, a clone - simply carries no film, and App.cs registers the still page as the
	     internal ad instead. It is a promotion, not a feature. Without the condition this is error
	     XA2001 and no package at all. -->
	<ItemGroup Condition="Exists('$(VhDir)\Vpnhood.App.Connect\promotions\internal-ad.mp4')">
		<AndroidAsset Include="$(VhDir)\Vpnhood.App.Connect\promotions\internal-ad.mp4"
		              Link="assets\ads\internal-ad.mp4" Visible="false" />
	</ItemGroup>
</Project>