<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Controls"
             xmlns:res="using:VpnHood.AppUi.Common"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.LogView"
             Focusable="True" FocusAdorner="{x:Null}">
  <!-- What the developer dialog's "Open log" opens in a browser tab (the app web server's
       /api/app/log.txt): the same text, on a page, because this head has no browser. The end is
       what matters, so it opens scrolled there. -->
  <DockPanel Classes="page">
    <Panel DockPanel.Dock="Top">
      <controls:PageHeader Title="Log" />
      <!-- The one way out of this page: a phone's share sheet, or the clipboard where there is none.
           The share mark is drawn here rather than cut into the icon font, which would mean a new
           asset package for one glyph. -->
      <Button x:Name="ShareButton" Classes="back-btn" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,8,0,0" Click="OnShareClick">
        <Panel>
          <PathIcon x:Name="ShareIcon" Width="20" Height="20" IsVisible="False"
                    Data="M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z" />
          <TextBlock x:Name="CopyGlyph" Classes="mdi" FontSize="20" IsVisible="False"
                     Text="{x:Static res:Mdi.ContentCopy}" />
        </Panel>
      </Button>
    </Panel>
    <ScrollViewer x:Name="Scroller">
      <!-- Wrapped, not cut: a log line is a stack trace or a path, and the end of it is the part
           worth reading. There is no sideways scroll on a remote, so a line that runs off the
           edge is a line nobody can read. Left to right in every language: it is not localized,
           and a right-to-left page would move each line's time to its end. -->
      <SelectableTextBlock x:Name="LogText" FlowDirection="LeftToRight" FontFamily="Consolas,Menlo,Droid Sans Mono,monospace" FontSize="12"
                           Foreground="{StaticResource AppText50Brush}" TextWrapping="Wrap" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
