<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Hosts the VpnHood app under a .NET MAUI UI on Android and Windows, in the app's own process: the platform's start, the Android activity's events, and the app's API for the MAUI pages</Description>
		<TargetFrameworks>net11.0-android37.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.26100.0</TargetFrameworks>
		<VhApiDocsComplete>true</VhApiDocsComplete>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
		<BaseOutputPath></BaseOutputPath>
		<BaseIntermediateOutputPath />
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Core" Version="11.0.10" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
	</ItemGroup>

	<ItemGroup>
		<!-- The theme's colours (WebViewTheme): a page cannot colour the native chrome around it. -->
		<ProjectReference Include="..\VpnHood.AppHosting.WebView\VpnHood.AppHosting.WebView.csproj" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<ProjectReference Include="..\..\AppLogic\VpnHood.AppLogic.App.Android\VpnHood.AppLogic.App.Android.csproj" />
		<ProjectReference Include="..\..\Core\VpnHood.Core.Client.Devices.Android\VpnHood.Core.Client.Devices.Android.csproj" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ProjectReference Include="..\..\AppLogic\VpnHood.AppLogic.App.WindowsTun\VpnHood.AppLogic.App.WindowsTun.csproj" />
		<ProjectReference Include="..\..\Core\VpnHood.Core.Client.Devices.WindowsTun\VpnHood.Core.Client.Devices.WindowsTun.csproj" />
	</ItemGroup>

</Project>
