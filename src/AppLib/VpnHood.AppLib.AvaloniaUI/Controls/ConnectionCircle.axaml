<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VpnHood.AppLib.AvaloniaUI.Controls.ConnectionCircle"
             Width="150" Height="150" ClipToBounds="False">
  <!-- The web UI's #connectionCircleIndicator (general.css "Home Circle Section"), value for value:
       a 150px ring, faint white at rest and cream while the app works; two dots on a 3s turn while
       connecting; on connect the dots slide to the centre, a green ring grows past the circle and
       glows (resize-and-shine), a green flash fills it and fades (resize-and-hide), and the ring
       turns white. The phase drives the classes on RootGrid (code-behind); the styles below do the
       rest, with the CSS's durations and delays. ClipToBounds is off because a UserControl clips
       by default, and the turning dots and the glow both reach past the 150px box. -->
  <UserControl.Styles>

    <!-- the outer ring -->
    <Style Selector="Border#Ring">
      <Setter Property="Opacity" Value="0.3" />
      <Setter Property="BorderBrush" Value="White" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.8" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.8" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Grid.live Border#Ring">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource CircleBorderBrush}" />
    </Style>
    <Style Selector="Grid.connected Border#Ring">
      <Setter Property="BorderBrush" Value="White" />
    </Style>

    <!-- the rotor: a 3s turn while connecting (#rotateCircle), a 2s pulse while unstable (.flasher) -->
    <Style Selector="Grid.spinning Canvas#Rotor">
      <Style.Animations>
        <Animation Duration="0:0:3" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Grid.unstable Canvas#Rotor">
      <Style.Animations>
        <Animation Duration="0:0:2" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- the dots: white at rest, cream while live; on connect they slide to the centre in .5s and
         hand over to the shine -->
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Fill" Value="White" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Canvas.Left" Duration="0:0:0.5" Easing="CubicEaseIn" />
          <DoubleTransition Property="Canvas.Right" Duration="0:0:0.5" Easing="CubicEaseIn" />
          <DoubleTransition Property="Canvas.Top" Duration="0:0:0.5" Easing="CubicEaseIn" />
          <DoubleTransition Property="Canvas.Bottom" Duration="0:0:0.5" Easing="CubicEaseIn" />
          <BrushTransition Property="Fill" Duration="0:0:0.5" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Grid.live Ellipse.dot">
      <Setter Property="Fill" Value="{StaticResource CircleBorderBrush}" />
    </Style>
    <Style Selector="Ellipse#DotA">
      <Setter Property="Canvas.Left" Value="6" />
      <Setter Property="Canvas.Bottom" Value="24" />
    </Style>
    <Style Selector="Ellipse#DotB">
      <Setter Property="Canvas.Right" Value="6" />
      <Setter Property="Canvas.Top" Value="24" />
    </Style>
    <Style Selector="Grid.connected Ellipse#DotA">
      <Setter Property="Canvas.Left" Value="68" />
      <Setter Property="Canvas.Bottom" Value="68" />
    </Style>
    <Style Selector="Grid.connected Ellipse#DotB">
      <Setter Property="Canvas.Right" Value="66" />
      <Setter Property="Canvas.Top" Value="66" />
    </Style>
    <!-- The end of every connect animation is a setter of the connected style, never a held last
         keyframe (FillMode Forward): a held value outlives the class, so a disconnect kept the
         glow and lost the dots. Backward holds the first keyframe through a delay instead. -->
    <Style Selector="Grid.connected Ellipse.dot">
      <Setter Property="Opacity" Value="0" />
      <Style.Animations>
        <Animation Duration="0:0:0.2" Delay="0:0:0.4" FillMode="Backward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- the shine: a ring that grows from the centre to 105% with a green glow and stays -->
    <Style Selector="Border#Shine">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="CornerRadius" Value="79" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource CircleShineBrush}" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Grid.connected Border#Shine">
      <Setter Property="Width" Value="157" />
      <Setter Property="Height" Value="157" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="BoxShadow" Value="0 0 30 11 #15F5BA" />
      <Style.Animations>
        <Animation Duration="0:0:0.8" Delay="0:0:0.4" FillMode="Backward" Easing="CubicEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="BoxShadow" Value="0 0 0 0 #0015F5BA" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Width" Value="157" />
            <Setter Property="Height" Value="157" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="BoxShadow" Value="0 0 30 11 #15F5BA" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- the flash: green, fills the circle from the centre and fades out -->
    <Style Selector="Ellipse#Flash">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Fill" Value="{StaticResource CircleShineBrush}" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Grid.connected Ellipse#Flash">
      <Style.Animations>
        <Animation Duration="0:0:0.8" Delay="0:0:0.4" Easing="CubicEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="150" />
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Grid x:Name="RootGrid" Width="150" Height="150">
    <Border x:Name="Shine" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <Ellipse x:Name="Flash" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <Border x:Name="Ring" CornerRadius="75" BorderThickness="1" />
    <Canvas x:Name="Rotor" Width="150" Height="150" RenderTransformOrigin="50%,50%">
      <Canvas.RenderTransform>
        <RotateTransform />
      </Canvas.RenderTransform>
      <Ellipse x:Name="DotA" Classes="dot" />
      <Ellipse x:Name="DotB" Classes="dot" />
    </Canvas>

    <!-- the state, and under it the check, the plug, or the session's usage -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
      <TextBlock x:Name="StateTextBlock" Classes="body-small" TextAlignment="Center" />
      <TextBlock x:Name="GlyphBlock" Classes="mdi" FontSize="40" HorizontalAlignment="Center" IsVisible="False" />
      <TextBlock x:Name="UsageBlock" Classes="body-large" TextAlignment="Center" IsVisible="False" />
    </StackPanel>

    <!-- the progress of a connection, at the bottom of the circle -->
    <StackPanel x:Name="ProgressPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,10" Width="75" IsVisible="False">
      <ProgressBar x:Name="Bar" Height="5" MinHeight="5" Minimum="0" Maximum="100" CornerRadius="3"
                   Foreground="{StaticResource CircleShineBrush}" Background="#1AFFFFFF" />
      <TextBlock x:Name="ProgressText" FontSize="10" TextAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
