		<ProjectReference Include="..\VpnHood.Core.Filtering.Abstractions\VpnHood.Core.Filtering.Abstractions.csproj" />
		<ProjectReference Include="..\VpnHood.Core.Filtering.DomainFiltering\VpnHood.Core.Filtering.DomainFiltering.csproj" />
		<ProjectReference Include="..\VpnHood.Core.Proxies.Management.Abstractions\VpnHood.Core.Proxies.Management.Abstractions.csproj" />
		<ProjectReference Include="..\..\Net\VpnHood.Net.TcpStack\VpnHood.Net.TcpStack.csproj" />
		<ProjectReference Include="..\..\Net\VpnHood.Net.Quic.Abstractions\VpnHood.Net.Quic.Abstractions.csproj" />
		<ProjectReference Include="..\VpnHood.Core.Tunneling\VpnHood.Core.Tunneling.csproj" />
		<ProjectReference Include="..\..\Net\VpnHood.Net.VpnAdapters.Abstractions\VpnHood.Net.VpnAdapters.Abstractions.csproj" />
