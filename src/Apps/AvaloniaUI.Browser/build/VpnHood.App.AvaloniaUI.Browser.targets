<Project>
	<!-- The page every head's web host serves - to the app's own web view and to a paired phone
	     alike: the Avalonia UI's browser build, as _publish.ps1 in this folder zips it. Placed the way
	     each platform reads files, so a head reads it at the asset path "assets/web-root.zip" through
	     its platform's IAssetProvider and hands it to the app (AppOptions.WebRootZipAsset), which
	     extracts it once. That path is the whole contract between this file and the head.

	     A placed file rather than an embedded resource because of Android: the assembly store is kept
	     once per CPU architecture, so anything inside a .dll ships once per ABI, while a package's
	     assets ship once. The same shape as VpnHood.AppUi.Assets.Classic's targets, which say why each
	     condition below is what it is; this is not a package, so a head imports this file directly,
	     as it does that one.

	     A build that has not published the browser UI places nothing and does not fail: the first
	     request for the page says which file is missing, rather than a head discovering at startup
	     that it has half a UI. -->
	<PropertyGroup>
		<VhWebRootZip>$(MSBuildThisFileDirectory)..\bin\avalonia-browser.zip</VhWebRootZip>
		<VhWebRootIsApp Condition="'$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe' Or '$(AndroidApplication)' == 'true'">true</VhWebRootIsApp>
		<VhWebRootIsAndroidApp Condition="'$(VhWebRootIsApp)' == 'true'">$(TargetFramework.Contains('-android'))</VhWebRootIsAndroidApp>
		<VhWebRootIsAppleApp Condition="'$(VhWebRootIsApp)' == 'true' And ($(TargetFramework.Contains('-ios')) Or $(TargetFramework.Contains('-tvos')) Or $(TargetFramework.Contains('-maccatalyst')))">true</VhWebRootIsAppleApp>
		<VhWebRootIsBrowserApp Condition="'$(VhWebRootIsApp)' == 'true'">$(TargetFramework.Contains('-browser'))</VhWebRootIsBrowserApp>
	</PropertyGroup>

	<!-- Android: one entry in base/assets of the package. The folder's name twice on purpose: .NET
	     for Android takes a leading assets\ in the link as the package's asset root and drops it. -->
	<ItemGroup Condition="'$(VhWebRootIsAndroidApp)' == 'true' And Exists('$(VhWebRootZip)')">
		<AndroidAsset Include="$(VhWebRootZip)" Link="assets\assets\web-root.zip" Visible="false" />
	</ItemGroup>

	<!-- iOS and tvOS: a file of the app bundle, read in place. -->
	<ItemGroup Condition="'$(VhWebRootIsAppleApp)' == 'true' And Exists('$(VhWebRootZip)')">
		<BundleResource Include="$(VhWebRootZip)" Link="assets\web-root.zip" Visible="false" />
	</ItemGroup>

	<!-- Windows and Linux: a file beside the executable, read in place. -->
	<ItemGroup Condition="'$(VhWebRootIsApp)' == 'true' And '$(TargetFramework)' != '' And '$(VhWebRootIsAndroidApp)' != 'true' And '$(VhWebRootIsAppleApp)' != 'true' And '$(VhWebRootIsBrowserApp)' != 'true' And Exists('$(VhWebRootZip)')">
		<None Include="$(VhWebRootZip)" Link="assets\web-root.zip" CopyToOutputDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>
</Project>
