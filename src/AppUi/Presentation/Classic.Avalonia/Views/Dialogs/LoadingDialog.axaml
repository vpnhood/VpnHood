<dialogs:DialogBase xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="using:VpnHood.AppUi.Services"
                    xmlns:dialogs="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Views.Dialogs"
                    x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.Dialogs.LoadingDialog">
  <!-- The web UI's LoadingDialog: a spinner and "Please wait", with no way out until the work that
       raised it is done. -->
  <Border Classes="dialog" MaxWidth="320">
    <StackPanel Spacing="10" HorizontalAlignment="Center">
      <TextBlock Classes="spinner" FontSize="30" Text="{x:Static res:Mdi.Loading}" HorizontalAlignment="Center" />
      <TextBlock x:Name="MessageText" Classes="dialog-text" TextAlignment="Center" Text="{Binding PleaseWait, Source={x:Static res:Strings.Current}}" />
    </StackPanel>
  </Border>
</dialogs:DialogBase>
