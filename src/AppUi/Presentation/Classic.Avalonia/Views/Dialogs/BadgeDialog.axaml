<dialogs:DialogBase xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="using:VpnHood.AppLib.Assets"
                    xmlns:vm="using:VpnHood.AppUi.Presentation.Classic.Avalonia.ViewModels"
                    xmlns:dialogs="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Views.Dialogs"
                    x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.Dialogs.BadgeDialog">
  <!-- The web UI's BadgeDialog: the features in use, each a row to its page - or, on a TV, to the
       phone, since those pages are its work there. -->
  <Border Classes="dialog">
    <StackPanel Spacing="8">
      <TextBlock Classes="dialog-title" Text="{Binding InUseFeatures, Source={x:Static res:Strings.Current}}" />
      <TextBlock Classes="dialog-text" FontSize="12" Text="{Binding InUseFeaturesDesc, Source={x:Static res:Strings.Current}}" />
      <ItemsControl x:Name="List">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FeatureBadge">
            <Button Classes="list-item" Click="OnFeatureClick">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Panel Width="28" Height="28" Margin="0,0,16,0">
                  <TextBlock Classes="mdi" Text="{Binding Icon}" />
                  <TextBlock Classes="mdi" FontSize="14" Text="{Binding SecondIcon}" IsVisible="{Binding HasSecondIcon}"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" />
                </Panel>
                <TextBlock Grid.Column="1" Classes="body-medium" Text="{Binding Title}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="mdi disabled" FontSize="20" Text="{Binding ChevronForward, Source={x:Static res:Strings.Current}}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button x:Name="CloseButton" Classes="dialog-btn" HorizontalAlignment="Left" Margin="0,8,0,0"
              Content="{Binding Close, Source={x:Static res:Strings.Current}}" Click="OnCloseClick" />
    </StackPanel>
  </Border>
</dialogs:DialogBase>
