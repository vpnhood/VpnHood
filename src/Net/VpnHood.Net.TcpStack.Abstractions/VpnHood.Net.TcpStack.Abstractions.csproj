<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>The interfaces of VpnHood's user-space TCP stack, for code that takes a stack without depending on VpnHood.Net.TcpStack.</Description>
        <TargetFramework>net11.0</TargetFramework>
        <!-- the whole public API is documented: a missing or broken doc comment fails the build -->
        <VhApiDocsComplete>true</VhApiDocsComplete>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\VpnHood.Net.Packets\VpnHood.Net.Packets.csproj" />
    </ItemGroup>

</Project>
