<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>	<!-- application, not a NuGet package -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-ios</TargetFramework>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    <UseMaui>false</UseMaui>
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    <!-- The project is named for its channel (the App Store); the bundle's executable keeps the platform name. -->
    <AssemblyName>VpnHoodConnect</AssemblyName>
    <BundleIdentifier>com.vpnhood.connect.ios</BundleIdentifier>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>

    <!-- Automatic signing: Xcode picks the cert/profile for the team (6KKW3MKLR7, OmegaHood LLC). -->
    <AutomaticProvisioning>true</AutomaticProvisioning>
    <CodesignKey>Apple Development</CodesignKey>

  </PropertyGroup>


  <!-- Apple's privacy manifest. MUST sit at the ROOT of the .app bundle for App Store Connect's scanner
       to find it, hence the explicit LogicalName; without it the file would be nested under its source
       path and the upload still fails ITMS-91053. The .appex carries its own copy (see that csproj). -->
  <ItemGroup>
    <BundleResource Include="PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <!-- Optional private app settings (from the external ".user" folder, sibling to the solution) embedded as
       resources. Mirrors Connect.Android.Web. Conditional so a fork without them still builds; AppConfigs
       reads them at startup via AppConfigsBase.LoadConfig(). Forward slashes: this builds on macOS. -->
  <ItemGroup>
    <EmbeddedResource Include="$(VhUserDir)/VpnHoodConnect/appsettings.json"
        LogicalName="AppSettings.json"
        Condition="Exists('$(VhUserDir)/VpnHoodConnect/appsettings.json')" />
    <EmbeddedResource Include="$(VhUserDir)/VpnHoodConnect/appsettings.$(Configuration).json"
        LogicalName="AppSettings_Environment.json"
        Condition="Exists('$(VhUserDir)/VpnHoodConnect/appsettings.$(Configuration).json')" />
  </ItemGroup>

  <!-- Default access key, embedded as its own resource so it can be sourced from a GitHub secret.
       Keys are per-entitlement, not per-store: only the ad-supported build (Android Google) embeds
       access_key_ad; every ad-free build — iOS included (the App Store head has no ads) — embeds
       access_key_premium. The configuration-specific file wins (Debug embeds access_key_premium.Debug.txt),
       otherwise the base access_key_premium.txt is used. Both optional: a fork without them falls back
       to the in-code default in AppConfigs (null -> the UI prompts for a key). -->
  <ItemGroup>
    <EmbeddedResource Include="$(VhUserDir)/VpnHoodConnect/access_key_premium.$(Configuration).txt"
        LogicalName="access_key_default.txt"
        Condition="Exists('$(VhUserDir)/VpnHoodConnect/access_key_premium.$(Configuration).txt')" />
    <EmbeddedResource Include="$(VhUserDir)/VpnHoodConnect/access_key_premium.txt"
        LogicalName="access_key_default.txt"
        Condition="!Exists('$(VhUserDir)/VpnHoodConnect/access_key_premium.$(Configuration).txt') And Exists('$(VhUserDir)/VpnHoodConnect/access_key_premium.txt')" />
  </ItemGroup>

  <ItemGroup>
    <!-- App framework + iOS device abstraction. -->
    <ProjectReference Include="..\..\..\AppLib\App\App\VpnHood.AppLib.App.csproj" />
    <ProjectReference Include="..\..\..\Core\Client\Client.Devices\Devices.Abstractions\VpnHood.Core.Client.Devices.Abstractions.csproj" />
    <!-- Concrete iOS IDevice (IosDevice) + IPC message client live in the core Device.iOS project. -->
    <ProjectReference Include="..\..\..\Core\Client\Client.Devices\Devices.Ios\VpnHood.Core.Client.Devices.Ios.csproj" />
    <!-- iOS shared app code: the VpnHoodIosApp bootstrap and the UI context. -->
    <ProjectReference Include="..\..\..\AppLib\App\App.Ios\VpnHood.AppLib.App.Ios.csproj" />
    <!-- The UI this head runs, mounted by AppDelegate as UIKit finishes launching. -->
    <ProjectReference Include="..\..\..\AppUi\Hosting\Avalonia\Avalonia\VpnHood.AppUi.Hosting.Avalonia.csproj" />
    <!-- The UI itself: the pages, the controls, the themes. -->
    <ProjectReference Include="..\..\..\AppUi\Presentation\Classic.Avalonia\VpnHood.AppUi.Presentation.Classic.Avalonia.csproj" />
    <PackageReference Include="Avalonia.iOS" Version="12.1.2" />
    <!-- StoreKit 2 billing + Sign in with Apple (AppStoreBillingProvider / AppleAuthenticationProvider).
         The Swift facade + binding come from the VpnHood.AppLib.Stores.AppStore.Native NuGet it
         references; being a binding package, its xcframework links into the app automatically. -->
    <ProjectReference Include="..\..\..\AppLib\Stores\AppStore\VpnHood.AppLib.Stores.AppStore.csproj" />
    <!-- Portal (WHMCS vpnhoodiap) account backend: sign-in sessions, entitlements, purchase verify. -->
    <ProjectReference Include="..\..\..\AppLib\Portal\VpnHood.AppLib.Portal.csproj" />
    <!-- Shared client resources: the IP-location db and ConnectAppResources. -->
    <ProjectReference Include="..\Connect\VpnHood.App.Connect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the Network Extension as a PlugIn (.appex) inside the host app. UndefineProperties drops
         the app's global /p:CodesignProvision (the App Store publish passes the *app* profile) when
         building this reference, so the .appex resolves its OWN App Store profile from its csproj
         instead of being signed with the app profile (App-ID mismatch -> codesign failure). -->
    <ProjectReference Include="..\Connect.Ios.Extension\VpnHood.App.Connect.Ios.Extension.csproj">
      <IsAppExtension>true</IsAppExtension>
      <UndefineProperties>CodesignProvision</UndefineProperties>
    </ProjectReference>
  </ItemGroup>

	<!-- The assets folder - the images, flags, fonts, documents and words every UI draws from - placed the way
	     this platform reads files: the same targets a package reference of VpnHood.AppUi.Assets.Classic imports. -->
	<Import Project="..\..\..\AppUi\Assets\Classic\build\VpnHood.AppUi.Assets.Classic.targets" />
	<!-- The page the web host serves - the Avalonia UI's browser build - placed the same way, from
	     Classic.Avalonia.Browser's publish; the head reads it at "assets/web-root.zip". -->
	<Import Project="..\..\..\AppUi\Presentation\Classic.Avalonia.Browser\build\VpnHood.AppUi.Presentation.Classic.Avalonia.Browser.targets" />
</Project>
