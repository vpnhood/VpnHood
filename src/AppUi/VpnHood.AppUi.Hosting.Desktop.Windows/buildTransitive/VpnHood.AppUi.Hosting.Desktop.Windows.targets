<Project>
	<!-- Windows' console launcher: the command's name (VhAppCommandName, the app's identity), vhclient.exe,
	     beside the window's executable and over the same dll. The window's executable is a GUI program,
	     so a shell neither waits for it nor gets its output or exit code; this one is the same apphost
	     marked console. It is the SDK's own step run a second time (CreateAppHost, as _CreateAppHost
	     runs it), copied to the output and the publish folder as the SDK copies the first
	     (_ComputeNETCoreBuildOutputFiles), so a head adds nothing. The apphost finds its dll by the
	     name written into it, and the runtime finds runtimeconfig.json and deps.json by the dll's
	     name: the two launchers share all three. -->
	<PropertyGroup>
		<_VhConsoleAppHostEnabled Condition="'$(OutputType)' == 'WinExe' And '$(VhAppCommandName)' != '' And '$(UseAppHost)' != 'false'">true</_VhConsoleAppHostEnabled>
	</PropertyGroup>

	<Target Name="_VhGetConsoleAppHostPath" DependsOnTargets="_GetAppHostPaths"
	        Condition="'$(_VhConsoleAppHostEnabled)' == 'true'">
		<PropertyGroup Condition="'$(AppHostIntermediatePath)' != ''">
			<_VhConsoleAppHostPath>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)$(VhAppCommandName)$(_NativeExecutableExtension)'))</_VhConsoleAppHostPath>
		</PropertyGroup>
	</Target>

	<Target Name="_VhAddConsoleAppHostToOutput" BeforeTargets="AssignTargetPaths" DependsOnTargets="_VhGetConsoleAppHostPath"
	        Condition="'$(_VhConsoleAppHostEnabled)' == 'true'">
		<ItemGroup Condition="'$(_VhConsoleAppHostPath)' != ''">
			<None Include="$(_VhConsoleAppHostPath)">
				<Link>$(VhAppCommandName)$(_NativeExecutableExtension)</Link>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</None>
		</ItemGroup>
	</Target>

	<Target Name="_VhCreateConsoleAppHost" AfterTargets="_CreateAppHost"
	        DependsOnTargets="_VhGetConsoleAppHostPath;_GetAppHostCreationConfiguration"
	        Inputs="@(IntermediateAssembly);$(AppHostSourcePath)" Outputs="$(_VhConsoleAppHostPath)"
	        Condition="'$(_VhConsoleAppHostEnabled)' == 'true'">
		<CreateAppHost Condition="'$(_VhConsoleAppHostPath)' != '' And Exists('@(IntermediateAssembly)') And Exists('$(AppHostSourcePath)')"
		               AppHostSourcePath="$(AppHostSourcePath)"
		               AppHostDestinationPath="$(_VhConsoleAppHostPath)"
		               AppBinaryName="$(AssemblyName)$(TargetExt)"
		               IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
		               WindowsGraphicalUserInterface="false"
		               Retries="$(CopyRetryCount)"
		               RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
		               DisableCetCompat="$(_DisableCetCompat)" />
		<ItemGroup>
			<FileWrites Include="$(_VhConsoleAppHostPath)" />
		</ItemGroup>
	</Target>

	<!-- The install root's two launchers, for an installer: the window's and the console's, named as the
	     version's own, but over current\<app>.dll - the version folder that the root's "current" junction
	     names (WindowsDesktopPaths.CurrentFolderName) - so shortcuts, the service and the PATH name the root and an update only re-points the
	     junction. The apphost takes a path under its own folder; the runtime is then found beside the
	     dll, in current. Made only when an installer's publish names a folder for them
	     (VhRootLaunchersDir), since nothing else has a root. -->
	<Target Name="_VhCreateRootLaunchers" AfterTargets="_CreateAppHost"
	        DependsOnTargets="_GetAppHostCreationConfiguration"
	        Condition="'$(VhRootLaunchersDir)' != '' And '$(OutputType)' == 'WinExe' And '$(UseAppHost)' != 'false'">
		<ItemGroup>
			<_VhRootLauncher Include="$(VhRootLaunchersDir)\$(AssemblyName)$(_NativeExecutableExtension)" Gui="true" />
			<_VhRootLauncher Include="$(VhRootLaunchersDir)\$(VhAppCommandName)$(_NativeExecutableExtension)" Gui="false"
			                 Condition="'$(VhAppCommandName)' != ''" />
		</ItemGroup>
		<MakeDir Directories="$(VhRootLaunchersDir)" />
		<CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
		               AppHostDestinationPath="%(_VhRootLauncher.FullPath)"
		               AppBinaryName="current\$(AssemblyName)$(TargetExt)"
		               IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
		               WindowsGraphicalUserInterface="%(_VhRootLauncher.Gui)"
		               Retries="$(CopyRetryCount)"
		               RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)"
		               DisableCetCompat="$(_DisableCetCompat)" />
	</Target>
</Project>
