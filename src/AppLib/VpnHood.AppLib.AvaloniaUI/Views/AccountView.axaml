<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppLib.AvaloniaUI.Resources"
             xmlns:controls="using:VpnHood.AppLib.AvaloniaUI.Controls"
             x:Class="VpnHood.AppLib.AvaloniaUI.Views.AccountView">
  <!-- The web UI's account page: who is signed in; what makes the session premium - the account's
       subscription, or a code - with its details and the ways to change it; the upgrade otherwise;
       and the way to delete the account. -->
  <Border x:Name="Sheet">
    <DockPanel Classes="page">
      <controls:PageHeader x:Name="Header" DockPanel.Dock="Top" Title="{Binding Account, Source={x:Static res:Strings.Current}}" />
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720" Spacing="16">
          <Image x:Name="PremiumImage" Source="{res:AppImage you-are-premium.webp}" MaxWidth="371" Stretch="Uniform" IsVisible="False" />

          <!-- UserDetails -->
          <Border x:Name="UserCard" Classes="config-card" Padding="16,12" IsVisible="False">
            <StackPanel Spacing="4">
              <TextBlock x:Name="UserName" Classes="card-title" IsVisible="False" />
              <TextBlock x:Name="UserEmail" Classes="card-subtitle" />
              <Button x:Name="SignOutButton" Classes="btn1 small" HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnSignOutClick"
                      Content="{Binding SignOut, Source={x:Static res:Strings.Current}}" />
            </StackPanel>
          </Border>

          <!-- the access server refused the kept code: it is kept, and this says why -->
          <Border x:Name="RefusalAlert" Classes="alert-warning" IsVisible="False">
            <TextBlock x:Name="RefusalText" Classes="body-small" TextWrapping="Wrap" />
          </Border>

          <!-- ChangePremiumMethod cards -->
          <Border x:Name="SignOutForCodeCard" Classes="config-card" Padding="16,12" IsVisible="False">
            <StackPanel Spacing="4">
              <TextBlock Classes="card-title" Text="{Binding WouldYouLikeToChange, Source={x:Static res:Strings.Current}}" />
              <TextBlock Classes="card-subtitle" Text="{Binding SignOutToUsePremiumCodeMsg, Source={x:Static res:Strings.Current}}" />
              <Button Classes="btn1 small" HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnSignOutClick"
                      Content="{Binding SignOut, Source={x:Static res:Strings.Current}}" />
            </StackPanel>
          </Border>
          <Border x:Name="ChangeCodeCard" Classes="config-card" Padding="16,12" IsVisible="False">
            <StackPanel Spacing="4">
              <TextBlock Classes="card-title" Text="{Binding ChangePremiumCode, Source={x:Static res:Strings.Current}}" />
              <TextBlock Classes="card-subtitle" Text="{Binding ChangePremiumCodeDesc, Source={x:Static res:Strings.Current}}" />
              <Button x:Name="ChangeCodeButton" Classes="btn1 small" HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnChangeCodeClick"
                      Content="{Binding ChangeCode, Source={x:Static res:Strings.Current}}" />
            </StackPanel>
          </Border>
          <Border x:Name="RemoveCodeCard" Classes="config-card" Padding="16,12" IsVisible="False">
            <StackPanel Spacing="4">
              <TextBlock Classes="card-title" Text="{Binding RemoveCurrentPremiumCode, Source={x:Static res:Strings.Current}}" />
              <TextBlock Classes="card-subtitle" Text="{Binding RemoveLocalPremiumCodeDesc, Source={x:Static res:Strings.Current}}" />
              <Button x:Name="RemoveCodeButton" Classes="btn1 small" HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnRemoveCodeClick"
                      Content="{Binding RemoveCode, Source={x:Static res:Strings.Current}}" />
            </StackPanel>
          </Border>

          <!-- SubscriptionDetails -->
          <Border x:Name="SubscriptionCard" Classes="config-card" Padding="16,12" IsVisible="False">
            <StackPanel Spacing="8">
              <TextBlock Classes="card-title" Text="{Binding SubscriptionDetails, Source={x:Static res:Strings.Current}}" />
              <StackPanel x:Name="SubscriptionRows" />
              <Button x:Name="ManageButton" Classes="btn1 small" HorizontalAlignment="Right" Click="OnManageClick" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding ManageSubscription, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                  <TextBlock Classes="mdi" FontSize="16" Text="{x:Static res:Mdi.ChevronRight}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock x:Name="ManageNote" Classes="card-subtitle" IsVisible="False" />
            </StackPanel>
          </Border>

          <!-- PremiumCodeDetails -->
          <Border x:Name="CodeCard" Classes="config-card" Padding="16,12" IsVisible="False">
            <StackPanel Spacing="8">
              <TextBlock Classes="card-title" Text="{Binding PremiumCodeDetails, Source={x:Static res:Strings.Current}}" />
              <StackPanel x:Name="CodeRows" />
              <TextBlock x:Name="CodeHint" Classes="card-subtitle" IsVisible="False" Text="{Binding UseCodeOnOtherDevices, Source={x:Static res:Strings.Current}}" />
              <StackPanel x:Name="CodeNotice" Spacing="12" HorizontalAlignment="Center" Margin="0,8" IsVisible="False">
                <TextBlock Classes="mdi disabled" FontSize="30" Text="{x:Static res:Mdi.InformationOutline}" HorizontalAlignment="Center" />
                <TextBlock Classes="body-small disabled" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding DisplayInfoAfterConnection, Source={x:Static res:Strings.Current}}" />
              </StackPanel>
              <Button x:Name="MoreDetailsButton" Classes="btn1 small" HorizontalAlignment="Right" Click="OnMoreDetailsClick" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding MoreDetails, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                  <TextBlock Classes="mdi" FontSize="16" Text="{x:Static res:Mdi.ChevronRight}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <!-- the upgrade, for a session that is not premium -->
          <Border x:Name="UpgradeCard" Classes="config-card" Padding="16,12" IsVisible="False">
            <StackPanel Spacing="8">
              <TextBlock Classes="card-title" Text="{Binding Upgrade, Source={x:Static res:Strings.Current}}" />
              <Grid ColumnDefinitions="Auto,*">
                <Image Source="{res:AppImage free-to-premium-account-icon.webp}" Width="92" Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock x:Name="UpgradeText" Grid.Column="1" Classes="body-medium" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
              <Button x:Name="GoPremiumButton" Classes="btn1 small" HorizontalAlignment="Right" Click="OnGoPremiumClick">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding GoPremium, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                  <TextBlock Classes="mdi" FontSize="16" Text="{x:Static res:Mdi.ChevronRight}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <!-- deleting the account: for every signed-in person, premium or not -->
          <Border x:Name="DeleteCard" Classes="config-card" Padding="16,12" IsVisible="False">
            <StackPanel Spacing="4">
              <TextBlock Classes="card-title error" Text="{Binding DeleteMyAccount, Source={x:Static res:Strings.Current}}" />
              <TextBlock Classes="card-subtitle" Text="{Binding DeleteMyAccountDesc, Source={x:Static res:Strings.Current}}" />
              <Button x:Name="DeleteButton" Classes="tonal-error pill small" HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnDeleteClick"
                      Content="{Binding DeleteMyAccount, Source={x:Static res:Strings.Current}}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
