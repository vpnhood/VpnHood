<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon from Android 13, which themes icons (VpnHood.AppLib.App.targets): the generator's
     layers, and for the themed icon the logo in one colour, inset to a themed glyph's size; the
     generator's own icon, which Android 8 to 12 take, would theme the logo layer, a solid disc. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
	<background android:drawable="@mipmap/ic_launcher_background" />
	<foreground android:drawable="@mipmap/ic_launcher_foreground" />
	<monochrome>
		<inset android:drawable="@drawable/ic_launcher_monochrome" android:inset="30%" />
	</monochrome>
</adaptive-icon>
