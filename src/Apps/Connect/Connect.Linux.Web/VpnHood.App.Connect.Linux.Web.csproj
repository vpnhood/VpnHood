<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>false</IsPackable>	<!-- application, not a NuGet package -->
		<Product>VpnHood! CONNECT</Product>
		<Description>VpnHood Linux Connect App</Description>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<UseWindowsForms>False</UseWindowsForms>
		<AssemblyName>VpnHoodConnect</AssemblyName>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<PublishTrimmed>False</PublishTrimmed>
	</PropertyGroup>

	<PropertyGroup>
		<StartupObject></StartupObject>
	</PropertyGroup>

	<!-- Optional private app settings (from the external ".user" folder) embedded as resources.
	     Conditional so a fork without them still builds; AppConfigs reads them at startup. -->
	<ItemGroup>
		<EmbeddedResource Include="$(VhUserDir)\VpnHoodConnect\appsettings.json" LogicalName="AppSettings.json" Condition="Exists('$(VhUserDir)\VpnHoodConnect\appsettings.json')" />
		<EmbeddedResource Include="$(VhUserDir)\VpnHoodConnect\appsettings.$(Configuration).json" LogicalName="AppSettings_Environment.json" Condition="Exists('$(VhUserDir)\VpnHoodConnect\appsettings.$(Configuration).json')" />
	</ItemGroup>

	<!-- Default access key, embedded as its own resource so it can be sourced from a GitHub secret.
	     Keys are per-entitlement, not per-store: only the ad-supported build (Android Google) embeds
	     access_key_ad; every ad-free build — Linux included — embeds access_key_premium.
	     The configuration-specific file wins (Debug embeds access_key_premium.Debug.txt), otherwise
	     the base access_key_premium.txt is used. Both are optional here: a fork without them falls
	     back to the in-code default in AppConfigs, while a real (strict) publish is gated by
	     Assert-DefaultAccessKey in pub/lib/AppPublishConfig.ps1. -->
	<ItemGroup>
		<EmbeddedResource Include="$(VhUserDir)\VpnHoodConnect\access_key_premium.$(Configuration).txt" LogicalName="access_key_default.txt" Condition="Exists('$(VhUserDir)\VpnHoodConnect\access_key_premium.$(Configuration).txt')" />
		<EmbeddedResource Include="$(VhUserDir)\VpnHoodConnect\access_key_premium.txt" LogicalName="access_key_default.txt" Condition="!Exists('$(VhUserDir)\VpnHoodConnect\access_key_premium.$(Configuration).txt') And Exists('$(VhUserDir)\VpnHoodConnect\access_key_premium.txt')" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Connect\VpnHood.App.Connect.csproj" />
		<ProjectReference Include="..\..\..\AppLib\VpnHood.AppLib.App.Linux\VpnHood.AppLib.App.Linux.csproj" />
		<!-- The command line, and the daemon and window it dispatches to: the same on every Linux head. -->
		<ProjectReference Include="..\..\..\AppUi\VpnHood.AppUi.Hosting.Cli.Linux\VpnHood.AppUi.Hosting.Cli.Linux.csproj" />
		<!-- The UI this head runs, in its own window. -->
		<ProjectReference Include="..\..\..\AppUi\VpnHood.AppUi.Hosting.Avalonia.Desktop\VpnHood.AppUi.Hosting.Avalonia.Desktop.csproj" />
		<!-- The UI itself: the pages, the controls, the themes. -->
		<ProjectReference Include="..\..\..\AppUi\VpnHood.AppUi.Presentation.Classic.Avalonia\VpnHood.AppUi.Presentation.Classic.Avalonia.csproj" />
		<ProjectReference Include="..\..\..\AppLib\VpnHood.AppLib.Portal\VpnHood.AppLib.Portal.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="VpnHood.Net.IpLocations.Assets.Ip2LocationLite" Version="8.2.854" />
	</ItemGroup>

	<!-- The assets folder - the images, flags, fonts, documents and words every UI draws from - placed the way
	     this platform reads files: the same targets a package reference of VpnHood.AppUi.Assets.Classic imports. -->
	<Import Project="..\..\..\AppUi\VpnHood.AppUi.Assets.Classic\build\VpnHood.AppUi.Assets.Classic.targets" />
	<!-- The page the web host serves - the Avalonia UI's browser build - placed the same way, from
	     Classic.Avalonia.Browser's publish; the head reads it at "assets/web-root.zip". -->
	<Import Project="..\..\..\AppUi\VpnHood.AppUi.Presentation.Classic.Avalonia.Browser\build\VpnHood.AppUi.Presentation.Classic.Avalonia.Browser.targets" />
</Project>
