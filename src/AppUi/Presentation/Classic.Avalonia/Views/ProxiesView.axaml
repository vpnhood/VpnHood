<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:VpnHood.AppUi.Common"
             xmlns:ui="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Resources"
             xmlns:controls="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Controls"
             x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.ProxiesView">
  <!-- The web UI's proxies page: the mode - none, the device's, a list of the person's own - and
       under it what the mode needs: the device's proxy as it reads it; or the list, its source URL,
       its statistics, and the ways to add to it and to clean it. -->
  <DockPanel Classes="page">
    <controls:PageHeader x:Name="Header" DockPanel.Dock="Top" Title="{Binding Proxies, Source={x:Static res:Strings.Current}}" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="720" Spacing="16">
        <Image x:Name="ProxyImage" ui:AppImage.Source="images/proxy.webp" MaxHeight="280" Stretch="Uniform" />
        <TextBlock Classes="card-subtitle" Margin="12,-8,12,4" Text="{Binding ProxyNote, Source={x:Static res:Strings.Current}}" />

        <!-- the mode -->
        <Border Classes="config-card" Padding="16,12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="body-medium" Text="{Binding ProxyMode, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
            <Button x:Name="ModeButton" Grid.Column="1" Classes="combo-field" Click="OnMenuButtonClick">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="ModeText" Classes="body-small highlight" VerticalAlignment="Center" />
                <TextBlock Classes="mdi highlight" FontSize="18" Text="{x:Static res:Mdi.ChevronDown}" VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="Bottom" FlyoutPresenterClasses="menu">
                  <StackPanel x:Name="ModeMenu" />
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </Border>

        <!-- DeviceProxy: the device's proxy, or the word that it has none -->
        <Border x:Name="DevicePanel" Classes="config-card" Padding="4" IsVisible="False">
          <StackPanel>
            <StackPanel x:Name="DeviceList" />
            <TextBlock x:Name="NoDeviceProxy" Classes="body-medium disabled" Margin="12,12" IsVisible="False"
                       Text="{Binding NoSystemProxy, Source={x:Static res:Strings.Current}}" />
          </StackPanel>
        </Border>

        <!-- ManualProxies -->
        <StackPanel x:Name="ManualPanel" Spacing="16" IsVisible="False">

          <!-- AddByUrl: a list fetched from an address, on a schedule -->
          <Border Classes="config-card" Padding="16,12">
            <StackPanel Spacing="12">
              <Button x:Name="UrlRow" Classes="list-item last" Padding="0,2" Click="OnUrlSwitchClick">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="body-medium" Text="{Binding AddByUrl, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                  <ToggleSwitch x:Name="UrlSwitch" Grid.Column="1" />
                </Grid>
              </Button>
              <StackPanel x:Name="UrlPanel" Spacing="12" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox x:Name="UrlBox" Classes="outlined" LostFocus="OnUrlLostFocus" TextChanged="OnUrlChanged" />
                  <Button x:Name="ReloadButton" Grid.Column="1" Classes="tonal-highlight icon" Margin="8,0,0,0" Click="OnReloadClick">
                    <TextBlock x:Name="ReloadIcon" Classes="mdi" FontSize="20" Text="{x:Static res:Mdi.Refresh}" />
                  </Button>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="AutoUpdateLabel" Classes="label-large" Text="{Binding AutoUpdate, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                  <Button x:Name="IntervalButton" Grid.Column="1" Classes="combo-field" Click="OnMenuButtonClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock x:Name="IntervalText" Classes="body-small highlight" VerticalAlignment="Center" />
                      <TextBlock Classes="mdi highlight" FontSize="18" Text="{x:Static res:Mdi.ChevronDown}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                      <Flyout Placement="Bottom" FlyoutPresenterClasses="menu">
                        <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                          <StackPanel x:Name="IntervalMenu" />
                        </ScrollViewer>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ConnectionStatistics: how the list has been doing -->
          <Border x:Name="StatsCard" Classes="config-card" Padding="16,12" IsVisible="False">
            <StackPanel Spacing="12">
              <TextBlock Classes="body-medium" Text="{Binding Statistics, Source={x:Static res:Strings.Current}}" />
              <Grid ColumnDefinitions="*,Auto,*,Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <Border Width="11" Height="11" CornerRadius="6" Background="{StaticResource EnablePremiumBrush}" VerticalAlignment="Center" />
                  <TextBlock Classes="body-small disabled" FontSize="11" Text="{Binding Succeeded, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" Classes="divider vertical" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <Border Width="11" Height="11" CornerRadius="6" Background="{StaticResource ErrorBrush}" VerticalAlignment="Center" />
                  <TextBlock Classes="body-small disabled" FontSize="11" Text="{Binding Failed, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="3" Classes="divider vertical" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <Border Width="11" Height="11" CornerRadius="6" Background="{StaticResource WhiteBrush}" Opacity="0.4" VerticalAlignment="Center" />
                  <TextBlock Classes="body-small disabled" FontSize="11" Text="{Binding Disabled, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Classes="body-small disabled" Text="{Binding RecentConnections, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="divider" Margin="8,0" VerticalAlignment="Center" Opacity="0.4" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                  <Border Classes="chip status-on comfortable"><TextBlock x:Name="RecentSucceeded" /></Border>
                  <Border Classes="chip error comfortable"><TextBlock x:Name="RecentFailed" /></Border>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock x:Name="ServersLabel" Classes="body-small disabled" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="divider" Margin="8,0" VerticalAlignment="Center" Opacity="0.4" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                  <Border Classes="chip status-on comfortable"><TextBlock x:Name="ServersSucceeded" /></Border>
                  <Border Classes="chip error comfortable"><TextBlock x:Name="ServersFailed" /></Border>
                  <Border Classes="chip white comfortable" Opacity="0.6"><TextBlock x:Name="ServersDisabled" /></Border>
                </StackPanel>
              </Grid>
              <Border Classes="divider" />
              <TextBlock Classes="body-small disabled" TextWrapping="Wrap" Text="{Binding ProxyLearningMsg, Source={x:Static res:Strings.Current}}" />
            </StackPanel>
          </Border>

          <!-- SavedProxies: the list, and what is done to it -->
          <Border Classes="config-card" Padding="0,12">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" Margin="16,0">
                <TextBlock Classes="body-medium" Text="{Binding Proxies, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                <Button x:Name="MenuButton" Grid.Column="1" Classes="icon small" IsVisible="False" Click="OnMenuButtonClick">
                  <TextBlock Classes="mdi" FontSize="20" Text="{x:Static res:Mdi.DotsVertical}" />
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="menu">
                      <StackPanel x:Name="ListMenu" />
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <Grid ColumnDefinitions="*,*" Margin="16,0">
                <Button x:Name="AddButton" Classes="tonal-highlight pill block" Margin="0,0,4,0" Click="OnAddClick">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Classes="mdi" FontSize="18" Text="{x:Static res:Mdi.Plus}" VerticalAlignment="Center" />
                    <TextBlock Classes="body-small" Text="{Binding Add, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="AddListButton" Grid.Column="1" Classes="tonal-highlight pill block" Margin="4,0,0,0" Click="OnAddListClick">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Classes="mdi" FontSize="18" Text="{x:Static res:Mdi.PlaylistPlus}" VerticalAlignment="Center" />
                    <TextBlock Classes="body-small" Text="{Binding AddList, Source={x:Static res:Strings.Current}}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
              <Button x:Name="FilterButton" Classes="outlined pill" Margin="16,8,16,0" HorizontalAlignment="Stretch" IsVisible="False" Click="OnMenuButtonClick">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Classes="mdi highlight" FontSize="18" Text="{x:Static res:Mdi.FilterVariant}" VerticalAlignment="Center" />
                  <TextBlock x:Name="FilterText" Grid.Column="1" Classes="body-small highlight" Margin="8,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="mdi highlight" FontSize="18" Text="{x:Static res:Mdi.ChevronDown}" VerticalAlignment="Center" />
                </Grid>
                <Button.Flyout>
                  <Flyout Placement="Bottom" FlyoutPresenterClasses="menu">
                    <StackPanel x:Name="FilterMenu" />
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Border Classes="divider" Margin="0,4" />
              <StackPanel x:Name="LoadingPanel" Spacing="10" HorizontalAlignment="Center" Margin="0,16" IsVisible="False">
                <TextBlock Classes="spinner" FontSize="26" Text="{x:Static res:Mdi.Loading}" HorizontalAlignment="Center" />
              </StackPanel>
              <StackPanel x:Name="ProxyList" Margin="4,0" />
              <TextBlock x:Name="EmptyText" Classes="body-medium disabled" TextAlignment="Center" Margin="16,12" IsVisible="False" />
              <StackPanel x:Name="Pagination" Spacing="8" IsVisible="False">
                <Border Classes="divider" />
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                  <Button x:Name="FirstPageButton" Classes="icon small" Click="OnFirstPageClick"><TextBlock Classes="mdi" FontSize="18" Text="{Binding ChevronBack, Source={x:Static res:Strings.Current}}" /></Button>
                  <Button x:Name="PrevPageButton" Classes="icon small" Click="OnPrevPageClick"><TextBlock Classes="mdi" FontSize="18" Text="{Binding ChevronBack, Source={x:Static res:Strings.Current}}" /></Button>
                  <TextBlock x:Name="PageText" Classes="body-small highlight" VerticalAlignment="Center" Margin="8,0" />
                  <Button x:Name="NextPageButton" Classes="icon small" Click="OnNextPageClick"><TextBlock Classes="mdi" FontSize="18" Text="{Binding ChevronForward, Source={x:Static res:Strings.Current}}" /></Button>
                  <Button x:Name="LastPageButton" Classes="icon small" Click="OnLastPageClick"><TextBlock Classes="mdi" FontSize="18" Text="{Binding ChevronForward, Source={x:Static res:Strings.Current}}" /></Button>
                </StackPanel>
                <TextBlock x:Name="PaginationText" Classes="body-small disabled" TextAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
