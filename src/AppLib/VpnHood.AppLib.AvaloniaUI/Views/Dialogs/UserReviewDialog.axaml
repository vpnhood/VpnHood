<dialogs:DialogBase xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="using:VpnHood.AppLib.Assets"
                    xmlns:dialogs="using:VpnHood.AppLib.AvaloniaUI.Views.Dialogs"
                    x:Class="VpnHood.AppLib.AvaloniaUI.Views.Dialogs.UserReviewDialog">
  <!-- The web UI's UserReviewDialog: three faces to pick from; the sad ones open a box for the
       words, the happy one thanks and hands over to the store's own prompt. -->
  <Border Classes="dialog" BorderBrush="{StaticResource RateDialogBorderBrush}" BorderThickness="1">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="Auto,*">
        <Button x:Name="CloseButton" Classes="tonal-icon" Click="OnCloseClick">
          <TextBlock Classes="mdi" FontSize="20" Text="{x:Static res:Mdi.Close}" />
        </Button>
      </Grid>

      <!-- step 1: the faces -->
      <StackPanel x:Name="RateStep" Spacing="16">
        <TextBlock Classes="h3" TextAlignment="Center" Text="{Binding Feedback, Source={x:Static res:Strings.Current}}" />
        <TextBlock Classes="body-large dialog-text" TextAlignment="Center" Text="{Binding FeedbackDesc, Source={x:Static res:Strings.Current}}" />
        <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Center">
          <Button x:Name="Rate1" Classes="icon" Width="60" Height="60" CornerRadius="30" Click="OnRate1Click">
            <TextBlock Classes="mdi" FontSize="48" Text="{x:Static res:Mdi.EmoticonSadOutline}" />
          </Button>
          <Button x:Name="Rate2" Classes="icon" Width="60" Height="60" CornerRadius="30" Click="OnRate2Click">
            <TextBlock FontSize="44" FontWeight="Bold" Text="😐" />
          </Button>
          <Button x:Name="Rate3" Classes="icon" Width="60" Height="60" CornerRadius="30" Click="OnRate3Click">
            <TextBlock FontSize="44" Text="😊" />
          </Button>
        </StackPanel>
      </StackPanel>

      <!-- step 2: the words, for a sad face -->
      <StackPanel x:Name="TextStep" Spacing="12" IsVisible="False">
        <TextBlock Classes="mdi" FontSize="80" HorizontalAlignment="Center" Text="{x:Static res:Mdi.EmoticonSadOutline}" />
        <TextBlock Classes="label-large" Text="{Binding UserReviewSorryMsg, Source={x:Static res:Strings.Current}}" TextWrapping="Wrap" />
        <TextBox x:Name="ReviewBox" Classes="outlined multiline" MaxLength="500" MinHeight="90" />
      </StackPanel>

      <!-- step 3: the thanks -->
      <StackPanel x:Name="ThanksStep" Spacing="8" IsVisible="False" HorizontalAlignment="Center">
        <TextBlock Classes="mdi" FontSize="80" HorizontalAlignment="Center" Foreground="{StaticResource RateDialogThanksBrush}" Text="{x:Static res:Mdi.CheckCircleOutline}" />
        <TextBlock Classes="body-medium" TextAlignment="Center" Foreground="{StaticResource RateDialogThanksBrush}" Text="{Binding UserReviewGladMsg, Source={x:Static res:Strings.Current}}" />
        <TextBlock Classes="body-medium" TextAlignment="Center" Text="{Binding ThankYou, Source={x:Static res:Strings.Current}}" />
      </StackPanel>

      <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button x:Name="LaterButton" Classes="pill dialog-btn" Click="OnCloseClick" />
        <Button x:Name="SubmitButton" Classes="pill btn2" IsEnabled="False" Click="OnSubmitClick"
                Content="{Binding Submit, Source={x:Static res:Strings.Current}}" />
        <Button x:Name="SendButton" Classes="pill btn2" IsVisible="False" IsEnabled="False" Click="OnSendClick"
                Content="{Binding Send, Source={x:Static res:Strings.Current}}" />
      </StackPanel>
    </StackPanel>
  </Border>
</dialogs:DialogBase>
