<dialogs:DialogBase xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="using:VpnHood.AppUi.Services"
                    xmlns:dialogs="using:VpnHood.AppUi.Presentation.Classic.Avalonia.Views.Dialogs"
                    x:Class="VpnHood.AppUi.Presentation.Classic.Avalonia.Views.Dialogs.PurchaseCompleteDialog">
  <!-- The web UI's PurchaseCompleteDialog: the congratulation, in the active colour, and Close to
       the home view. -->
  <Border Classes="dialog active" MaxWidth="420">
    <StackPanel Spacing="12">
      <StackPanel Spacing="4" HorizontalAlignment="Center">
        <TextBlock Classes="mdi" FontSize="44" Text="{x:Static res:Mdi.PartyPopper}" HorizontalAlignment="Center" />
        <TextBlock Classes="dialog-title" FontSize="22" TextAlignment="Center" Text="{Binding Congratulations, Source={x:Static res:Strings.Current}}" />
      </StackPanel>
      <TextBlock Classes="dialog-text" Text="{Binding PurchaseAndProcessIsCompleteMessage, Source={x:Static res:Strings.Current}}" />
      <Button x:Name="CloseButton" Classes="dialog-btn plain" HorizontalAlignment="Right" Click="OnCloseClick"
              Content="{Binding Close, Source={x:Static res:Strings.Current}}" />
    </StackPanel>
  </Border>
</dialogs:DialogBase>
