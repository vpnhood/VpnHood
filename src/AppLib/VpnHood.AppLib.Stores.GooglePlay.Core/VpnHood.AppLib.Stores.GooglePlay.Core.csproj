<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>VpnHood Android Client App Common Library for Google Core</Description>
		<TargetFramework>net11.0-android37.0</TargetFramework>
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
		<RootNamespace>VpnHood.AppLib.Stores.GooglePlay</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<BaseIntermediateOutputPath />
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Xamarin.Google.Android.Play.App.Update" Version="2.1.0.20" />
	  <PackageReference Include="Xamarin.Google.Android.Play.Review" Version="2.0.2.10" />
	  <!-- Play Services takes AndroidX Lifecycle to 2.11, and the Lifecycle.Process 2.10 that
	       Avalonia.Android's AppCompat brings allows only 2.10 beside it (NU1608). -->
	  <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\VpnHood.AppLib.Abstractions\VpnHood.AppLib.Abstractions.csproj" />
	  <ProjectReference Include="..\..\Core\VpnHood.Core.Client.Devices.Android\VpnHood.Core.Client.Devices.Android.csproj" />
	</ItemGroup>

</Project>
