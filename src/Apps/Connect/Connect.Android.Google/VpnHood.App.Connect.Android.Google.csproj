<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>false</IsPackable>	<!-- application, not a NuGet package -->
		<Description>VpnHood Android Client Connect App with Ads and memebership</Description>
		<TargetFramework>net10.0-android36.1</TargetFramework>
		<OutputType>Exe</OutputType>
		<ApplicationId>com.vpnhood.connect.android</ApplicationId>
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<DebugSymbols>True</DebugSymbols>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<!--android-arm is required for some android TVs-->
		<UseCurrentRuntimeIdentifier>false</UseCurrentRuntimeIdentifier>
		<RuntimeIdentifier>android-arm64</RuntimeIdentifier>
		<RuntimeIdentifiers>android-arm64;android-x64;android-arm</RuntimeIdentifiers>
		<PublishTrimmed>True</PublishTrimmed>
		<RunAOTCompilation>True</RunAOTCompilation>
		<!-- Play DEX-optimization requirement (Feb 2027): R8 shrinks the Java side.
		     Shrink-only: the SDK's generated rules already pass -dontobfuscate,
		     so names survive and JNI/reflection lookups stay valid. -->
		<AndroidLinkTool>r8</AndroidLinkTool>
	</PropertyGroup>

	<PropertyGroup>
		<BaseIntermediateOutputPath />
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <AndroidKeyStore>False</AndroidKeyStore>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <AndroidKeyStore>False</AndroidKeyStore>
	</PropertyGroup>

	<!-- Optional private app settings (from the external ".user" folder) embedded as resources.
	     Conditional so a fork without them still builds; AppConfigs reads them at startup. -->
	<ItemGroup>
		<EmbeddedResource Include="$(VhUserDir)\VpnHoodConnect\appsettings.json"
			LogicalName="AppSettings.json"
			Condition="Exists('$(VhUserDir)\VpnHoodConnect\appsettings.json')" />
		<EmbeddedResource Include="$(VhUserDir)\VpnHoodConnect\appsettings.$(Configuration).json"
			LogicalName="AppSettings_Environment.json"
			Condition="Exists('$(VhUserDir)\VpnHoodConnect\appsettings.$(Configuration).json')" />
	</ItemGroup>

	<!-- Default access key, embedded as its own resource so it can be sourced from a GitHub secret.
	     Keys are per-entitlement, not per-store: this Google build is the only ad-supported one, so it
	     embeds access_key_ad; every other distribution embeds access_key_premium.
	     The configuration-specific file wins (Debug embeds access_key_ad.Debug.txt), otherwise
	     the base access_key_ad.txt is used. Both are optional: a fork without them falls back to the
	     in-code default in AppConfigs. -->
	<ItemGroup>
		<EmbeddedResource Include="$(VhUserDir)\VpnHoodConnect\access_key_ad.$(Configuration).txt"
			LogicalName="access_key_default.txt"
			Condition="Exists('$(VhUserDir)\VpnHoodConnect\access_key_ad.$(Configuration).txt')" />
		<EmbeddedResource Include="$(VhUserDir)\VpnHoodConnect\access_key_ad.txt"
			LogicalName="access_key_default.txt"
			Condition="!Exists('$(VhUserDir)\VpnHoodConnect\access_key_ad.$(Configuration).txt') And Exists('$(VhUserDir)\VpnHoodConnect\access_key_ad.txt')" />
	</ItemGroup>

	<ItemGroup>
		<AndroidResource Update="Resources\xml\locales_config.xml">
			<SubType>Designer</SubType>
			<Generator>MSBuild:UpdateGeneratedFiles</Generator>
		</AndroidResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Xamarin.Firebase.Analytics" Version="123.2.0.1" />
		<PackageReference Include="Xamarin.Firebase.Crashlytics" Version="120.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\AppLib\Ads\AdMob.Android\VpnHood.AppLib.Ads.AdMob.Android.csproj" />
		<ProjectReference Include="..\..\..\AppLib\Stores\GooglePlay.Core\VpnHood.AppLib.Stores.GooglePlay.Core.csproj" />
		<ProjectReference Include="..\..\..\AppLib\Stores\GooglePlay\VpnHood.AppLib.Stores.GooglePlay.csproj" />
		<ProjectReference Include="..\..\..\AppLib\App\App.Android\VpnHood.AppLib.App.Android.csproj" />
		<!-- The UI this head runs, which MainActivity is the activity of. -->
		<ProjectReference Include="..\..\..\AppUi\Hosting\Avalonia\Avalonia.Android\VpnHood.AppUi.Hosting.Avalonia.Android.csproj" />
		<!-- The UI itself: the pages, the controls, the themes. -->
		<ProjectReference Include="..\..\..\AppUi\Presentation\Classic.Avalonia\VpnHood.AppUi.Presentation.Classic.Avalonia.csproj" />
		<ProjectReference Include="..\..\..\AppLib\Portal\VpnHood.AppLib.Portal.csproj" />
		<ProjectReference Include="..\Connect\VpnHood.App.Connect.csproj" />
	</ItemGroup>

	<ItemGroup>
		<GoogleServicesJson Include="Properties\google-services.json" />
	</ItemGroup>

	<!-- The assets folder - the images, flags, fonts, documents and words every UI draws from - placed the way
	     this platform reads files: the same targets a package reference of VpnHood.AppUi.Assets.Classic imports. -->
	<Import Project="..\..\..\AppUi\Assets\Classic\build\VpnHood.AppUi.Assets.Classic.targets" />
	<!-- The page the web host serves - the Avalonia UI's browser build - placed the same way, from
	     Classic.Avalonia.Browser's publish; the head reads it at "assets/web-root.zip". -->
	<Import Project="..\..\..\AppUi\Presentation\Classic.Avalonia.Browser\build\VpnHood.AppUi.Presentation.Classic.Avalonia.Browser.targets" />

	<!-- The internal ad's film, which only THIS head can ever show: the internal ad is the fallback
	     provider registered in App.cs, and no other head registers one. 1.8 MB, so it is not carried
	     by the shared assets package that nine other heads also build.

	     It comes from the CONNECT product's own repo, where the rest of the promotion material lives
	     (promotions/) - the same way Apps/Client reaches spa.zip through $(VhDir). A film changes on
	     the product's schedule, not the code's, and this repo keeps code.

	     Its own asset root, deliberately NOT under assets\: that is the UI's store, a zip extracted
	     to storage, and a film inside it would be a second 1.8 MB on disk for no reason.
	     AssetVideoActivity reads it where it lies, through the descriptor AssetManager gives for a
	     stored entry. The leading assets\ in the link is the package's asset root and is dropped by
	     the Android SDK, so the asset path is "ads/internal-ad.mp4".

	     Optional on purpose: a build without that repo beside this one - a CI run that checks out only
	     the code, a fork, a clone - simply carries no film, and the head shows no video. It is a
	     promotion, not a feature, and the only thing that reads it is a fallback ad that already has
	     to cope with having nothing to show. Without the condition this is error XA2001 and no
	     package at all. -->
	<ItemGroup Condition="Exists('$(VhDir)\Vpnhood.App.Connect\promotions\internal-ad.mp4')">
		<AndroidAsset Include="$(VhDir)\Vpnhood.App.Connect\promotions\internal-ad.mp4"
		              Link="assets\ads\internal-ad.mp4" Visible="false" />
	</ItemGroup>
</Project>