<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Description>Runs the VpnHood Avalonia UI in a desktop window on Windows and Linux</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VpnHood.AppUi.Hosting.Avalonia\VpnHood.AppUi.Hosting.Avalonia.csproj" />
		<ProjectReference Include="..\..\AppLib\VpnHood.AppLib.App\VpnHood.AppLib.App.csproj" />
		<!-- IDesktopUi, which a desktop head names this UI as. -->
		<ProjectReference Include="..\VpnHood.AppUi.Hosting.Abstractions\VpnHood.AppUi.Hosting.Abstractions.csproj" />
		<!-- The web server extracts the bundle whose assets folder the UI draws from. -->
	</ItemGroup>
</Project>
